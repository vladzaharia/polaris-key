# Probe results (CSV/JSON per run) and local wrangler state (the local R2 and Cache API data).
out/
.wrangler/
worker/.wrangler/
# Local-only upload token for `wrangler dev`; a deployed probe uses `wrangler secret put`.
worker/.dev.vars
# Godot's cache if the probe script is ever opened as a project.
godot/.godot/
