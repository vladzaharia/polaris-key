// Path B probe Worker (S-02). No account id and no secrets live here: `wrangler login` or
// CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID in the environment pick the account, and the
// upload token is a secret (`wrangler secret put PROBE_PUT_TOKEN`), or `.dev.vars` locally.
{
  "name": "pk-r2-probe",
  "main": "src/index.js",
  "compatibility_date": "2026-06-30",
  "workers_dev": true,
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "polaris-key-blobs-dev" },
  ],
  "vars": { "CACHE_FILL_ON_RANGE": "1", "WORKERS_CACHE": "0" },
}
