#. Too many attempts
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.rate_limited.title"
msgstr "Demasiados intentos"

#. Too many attempts. Wait a moment and try again.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.rate_limited.message"
msgstr "Demasiados intentos. Espera un momento y vuelve a intentarlo."

#. Too large
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.body_too_large.title"
msgstr "Demasiado grande"

#. That is too large to send.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.body_too_large.message"
msgstr "Es demasiado grande para enviarlo."

#. Request refused
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.method_not_allowed.title"
msgstr "Solicitud rechazada"

#. The request wasn't valid. Update the app, then try again.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.method_not_allowed.message"
msgstr "La solicitud no era válida. Actualiza la app y vuelve a intentarlo."

#. Service not set up
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.misconfigured.title"
msgstr "Servicio no configurado"

#. This service isn't set up correctly. Contact the developer.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.misconfigured.message"
msgstr "Este servicio no está configurado correctamente. Contacta con el desarrollador."

#. Registration closed
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.registration_closed.title"
msgstr "Registro cerrado"

#. New devices can't register right now. Activate with a license key or sign in.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.registration_closed.message"
msgstr "Ahora mismo no se pueden registrar dispositivos nuevos. Activa con una clave de licencia o inicia sesión."

#. Value not accepted
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.value_not_representable.title"
msgstr "Valor no aceptado"

#. A value couldn't be saved. Change it and try again.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.value_not_representable.message"
msgstr "No se pudo guardar un valor. Cámbialo y vuelve a intentarlo."

#. Service problem
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.document_not_representable.title"
msgstr "Problema del servicio"

#. The service couldn't prepare your settings. Contact the developer.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.document_not_representable.message"
msgstr "El servicio no pudo preparar tus ajustes. Contacta con el desarrollador."

#. Device limit reached
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.device_limit.title"
msgstr "Límite de dispositivos alcanzado"

#. This license is already on all its devices. Replace a device to use it here.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.device_limit.message"
msgstr "Esta licencia ya está en todos sus dispositivos. Reemplaza un dispositivo para usarla aquí."

#. No key entries left
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.key_entry_limit.title"
msgstr "No quedan usos de la clave"

#. This key has no entries left. Add it to your account and sign in instead.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.key_entry_limit.message"
msgstr "A esta clave no le quedan usos. Añádela a tu cuenta e inicia sesión en su lugar."

#. License disabled
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.license_disabled.title"
msgstr "Licencia desactivada"

#. This license has been disabled. Contact the developer.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.license_disabled.message"
msgstr "Esta licencia se desactivó. Contacta con el desarrollador."

#. License expired
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.license_expired.title"
msgstr "Licencia vencida"

#. This license has expired. Renew it to continue.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.license_expired.message"
msgstr "Esta licencia venció. Renuévala para continuar."

#. Not included
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.not_entitled.title"
msgstr "No incluido"

#. Your license doesn't include this.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.not_entitled.message"
msgstr "Tu licencia no incluye esto."

#. Update required
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.version_blocked.title"
msgstr "Actualización obligatoria"

#. This version can't be used with your license. Update the app to continue.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.version_blocked.message"
msgstr "Esta versión no se puede usar con tu licencia. Actualiza la app para continuar."

#. Channel not included
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.channel_not_allowed.title"
msgstr "Canal no incluido"

#. Your license doesn't include this release channel.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.channel_not_allowed.message"
msgstr "Tu licencia no incluye este canal de versiones."

#. Device changed
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.hardware_mismatch.title"
msgstr "El dispositivo cambió"

#. This device's hardware changed. Activate again to use your license here.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.hardware_mismatch.message"
msgstr "El hardware de este dispositivo cambió. Vuelve a activarlo para usar tu licencia aquí."

#. Device check failed
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.fingerprint_required.title"
msgstr "Error al verificar el dispositivo"

#. This license needs a hardware fingerprint, which couldn't be read on this device.
