msgid "core.codes.attestation_required.message"
msgstr "Esto requiere un dispositivo verificado. Deja que la app verifique este dispositivo y vuelve a intentarlo."

#. Device check failed
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.attestation_rejected.title"
