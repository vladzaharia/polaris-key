msgid "signin.replace.meta"
msgstr "{platform} · last used {when}"

#. Least recent
#. Replace a device, inline in the license choice (SIGN-IN.md §3.7).
msgid "signin.replace.leastRecent"
msgstr "Least recent"

#. Active now
#. Replace a device, inline in the license choice (SIGN-IN.md §3.7).
msgid "signin.replace.activeNow"
msgstr "Active now"

#. This browser
#. Replace a device, inline in the license choice (SIGN-IN.md §3.7).
msgid "signin.replace.thisBrowser"
msgstr "This browser"

#. Replace {device}?
#. Replace a device, inline in the license choice (SIGN-IN.md §3.7). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”.
msgid "signin.replace.title"
msgstr "Replace {device}?"

#. {device} signs out of {product} and {thisDevice} takes its place. We'll email you about it.
