msgstr "Replace and continue"

#. macos: Replace and Continue
msgctxt "macos"
msgid "signin.replace.confirm"
msgstr "Replace and Continue"

#. Replace {device}
#. Replace a device, inline in the license choice (SIGN-IN.md §3.7). The primary once a device is picked, in place of the generic one. Arguments: {device} = a device's friendly name, for example “Maya's MacBook”.
msgid "signin.replace.confirmNamed"
msgstr "Replace {device}"

#. Back
#. Replace a device, inline in the license choice (SIGN-IN.md §3.7).
msgid "signin.replace.back"
msgstr "Back"

#. That device was already removed. Choose again.
