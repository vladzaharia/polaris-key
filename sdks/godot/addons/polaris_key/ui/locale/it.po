msgid "core.codes.attestation_unavailable.message"
msgstr "La verifica del dispositivo non è disponibile per questa app al momento. Riprova tra qualche minuto."

#. Too many attempts
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.rate_limited.title"
msgstr "Troppi tentativi"

#. Too many attempts. Wait a moment and try again.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.rate_limited.message"
msgstr "Troppi tentativi. Attendi un momento e riprova."

#. Too large
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.body_too_large.title"
msgstr "Troppo grande"

#. That is too large to send.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.body_too_large.message"
msgstr "È troppo grande per essere inviato."

#. Request refused
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.method_not_allowed.title"
msgstr "Richiesta rifiutata"

#. The request wasn't valid. Update the app, then try again.
#. Core copy (conformance/parity/copy.en.json, codes).
msgid "core.codes.method_not_allowed.message"
msgstr "La richiesta non era valida. Aggiorna l'app e riprova."

