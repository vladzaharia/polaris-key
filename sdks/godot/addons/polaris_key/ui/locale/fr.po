msgid "signin.linkOffer.primary"
msgstr "Associer {provider}"

#. No thanks
#. Link offer: declines; the device remembers it.
msgid "signin.linkOffer.decline"
msgstr "Non merci"

#. macos: No Thanks
msgctxt "macos"
msgid "signin.linkOffer.decline"
msgstr "Non merci"

#. Sign in again to link {provider}.
#. Link offer: the sign-in is too old to link; the main button becomes Sign in again. Arguments: {provider} = the provider's name (never translated).
msgid "signin.linkOffer.stale"
msgstr "Reconnectez-vous pour lier {provider}."

#. Couldn't link {provider} on this device.
#. Link offer: this device or its proof was refused, so trying again cannot help; the person can decline. Arguments: {provider} = the provider's name (never translated).
msgid "signin.linkOffer.failed"
msgstr "Impossible de lier {provider} sur cet appareil."

#. {provider} linked
#. Link offer: the link succeeded. Arguments: {provider} = the provider's name (never translated).
msgid "signin.linkOffer.done"
msgstr "{provider} associé"

#. {provider} not linked
#. Link offer: the provider account is already linked elsewhere. Arguments: {provider} = the provider's name (never translated).
msgid "signin.linkOffer.conflictTitle"
msgstr "{provider} non associé"

#. This {provider} account belongs to another Polaris Locker account. You're still signed in.
#. Link offer: the provider account belongs to another Polaris Locker account; the sign-in stands. Arguments: {provider} = the provider's name (never translated).
msgid "signin.linkOffer.conflict"
msgstr "Ce compte {provider} appartient à un autre compte Polaris Locker. Vous restez connecté."

#. Join accounts
#. Link offer conflict: opens Help on joining two accounts.
msgid "signin.linkOffer.join"
msgstr "Fusionner les comptes"

#. macos: Join Accounts
msgctxt "macos"
msgid "signin.linkOffer.join"
msgstr "Fusionner les comptes"

#. Approve on your other device
#. Nearby sign-in, on the device that signs in: waits for approval on another device.
msgid "signin.nearby.title"
msgstr "Approuvez sur votre autre appareil"

#. Sign in with your phone
#. Nearby sign-in, before the system asks for access to the local network.
msgid "signin.nearby.promptTitle"
msgstr "Se connecter avec le téléphone"

#. Open {app} on a phone or computer that's signed in and on this network.
#. Nearby sign-in, waiting. Arguments: {app} = the app's name (never translated).
msgid "signin.nearby.body"
msgstr "Ouvrez {app} sur un téléphone ou un ordinateur connecté et sur ce réseau."

#. Tap this code there:
#. Nearby sign-in, waiting: the line above the code the other device must tap.
msgid "signin.nearby.match"
msgstr "Touchez ce code là-bas :"

#. Use a code instead
#. Nearby sign-in, waiting: switches to the device code.
msgid "signin.nearby.code"
msgstr "Utiliser un code à la place"

#. macos: Use a Code Instead
msgctxt "macos"
msgid "signin.nearby.code"
msgstr "Utiliser un code à la place"

#. Signed in as {email}
#. Nearby sign-in, done. Arguments: {email} = the account's email address (never translated).
msgid "signin.nearby.done"
msgstr "Connecté en tant que {email}"

#. Not you?
#. Nearby sign-in, done: opens the sign-out and review step when the account is not the person's.
msgid "signin.nearby.notYou"
msgstr "Ce n’est pas vous ?"

#. macos: Not You?
msgctxt "macos"
msgid "signin.nearby.notYou"
msgstr "Ce n’est pas vous ?"

#. Next, allow {app} to find devices on your network, so your phone can sign you in.
#. Nearby sign-in: shown before the system asks for access to devices on the local network (L-11). Arguments: {app} = the app's name (never translated).
msgid "signin.nearby.prePrompt"
msgstr "Autorisez ensuite {app} à trouver les appareils de votre réseau, pour que votre téléphone puisse vous connecter."

#. Let {device} sign in?
#. Nearby approval, on the signed-in device. Arguments: {device} = the new device's friendly name (never translated).
msgid "signin.nearby.ask"
msgstr "Laisser {device} se connecter ?"

#. Tap the code it shows.
#. Nearby approval: number matching. Three 6-digit codes follow; one matches the code the new device shows. Arguments: {device} = the new device's friendly name (never translated).
msgid "signin.nearby.askBody"
msgstr "Touchez le code qu’il affiche."

#. {device} is signed in
#. Nearby approval: the new device is signed in. Arguments: {device} = the new device's friendly name (never translated).
msgid "signin.nearby.approved"
msgstr "{device} est connecté"

#. {device} isn't on this network
#. Nearby approval: the new device is not on the approver's network. Arguments: {device} = the new device's friendly name (never translated).
msgid "signin.nearby.notNearby"
msgstr "{device} n’est pas sur ce réseau"

#. Connect both to the same Wi-Fi, or sign in with a code on {device}.
#. Nearby approval: the new device is not on the approver's network. Arguments: {device} = the new device's friendly name (never translated).
msgid "signin.nearby.notNearbyBody"
msgstr "Connectez les deux au même Wi-Fi, ou connectez-vous avec un code sur {device}."

#. That code didn't match, so {device} wasn't signed in.
#. Nearby approval: the person tapped a code that did not match; the request is denied. Arguments: {device} = the new device's friendly name (never translated).
msgid "signin.nearby.mismatch"
msgstr "Ce code ne correspondait pas, donc {device} n’a pas été connecté."

#. Approve a nearby device
#. Account menu entry: opens the nearby approval list on the signed-in device.
msgid "signin.nearby.menu"
msgstr "Approuver un appareil à proximité"

#. macos: Approve a Nearby Device
msgctxt "macos"
msgid "signin.nearby.menu"
msgstr "Approuver un appareil à proximité"

#. Choose a license for {device}
#. Nearby approval, on the signed-in device: choose which license the new device gets. Arguments: {device} = the new device's friendly name (never translated).
msgid "signin.nearby.chooseTitle"
msgstr "Choisissez une licence pour {device}"

#. {product} will use it.
#. Nearby approval: choose a license. Arguments: {product} = the product's name from ProductIdentity (never translated).
msgid "signin.nearby.chooseLede"
msgstr "{product} l’utilisera."

#. This license is on all its devices. Remove one to make room for {device}.
#. Nearby approval: the license is on all its devices. Body under the Device limit reached title; the action opens the device list. Arguments: {device} = the new device's friendly name (never translated).
msgid "signin.nearby.deviceLimitBody"
msgstr "Cette licence est sur tous ses appareils. Retirez-en un pour faire de la place à {device}."

#. Wait a moment, then try again on {device}.
#. Nearby approval: too many attempts. Body under the Too many attempts title; the action is Done, because the retry happens on the new device. Arguments: {device} = the new device's friendly name (never translated).
msgid "signin.nearby.rateLimitedBody"
msgstr "Patientez un instant, puis réessayez sur {device}."

#. Start again on {device}.
#. Nearby approval: the code expired. Body under the Code expired title; the person starts again on the new device. Arguments: {device} = the new device's friendly name (never translated).
msgid "signin.nearby.expiredBody"
msgstr "Recommencez sur {device}."

#. Add it in Polaris Locker
#. The key was refused and the person adds it to their account on the web (↗, opens the browser).
msgid "signin.key.addInLocker"
msgstr "L’ajouter dans Polaris Locker"

#. macos: Add It in Polaris Locker
msgctxt "macos"
msgid "signin.key.addInLocker"
msgstr "L’ajouter dans Polaris Locker"

#. Scan to add this key in Polaris Locker on your phone.
#. The key-refusal step on TV and console: caption of the QR that opens the add-key page.
msgid "signin.key.scan"
msgstr "Scannez pour ajouter cette clé dans Polaris Locker sur votre téléphone."

#. {product} is yours
#. Return step (SIGN-IN.md §3.10). Arguments: {product} = the product's name from ProductIdentity (never translated).
msgid "signin.return.yours"
msgstr "{product} est à vous"

#. {tier} · in your library
#. Return step (SIGN-IN.md §3.10): the product row under "<Product> is yours". Arguments: {tier} = the tier's name (never translated).
msgid "signin.return.product"
msgstr "{tier} · dans votre bibliothèque"

#. You're signed in to {app}
#. Return step (SIGN-IN.md §3.10). Arguments: {app} = the requesting app's name (never translated).
msgid "signin.return.signedIn"
msgstr "Vous êtes connecté à {app}"

#. Return to {app}
#. Return step (SIGN-IN.md §3.10). Arguments: {app} = the requesting app's name (never translated).
msgid "signin.return.button"
msgstr "Revenir à {app}"

#. Returning by itself in {s} s
#. Return step (SIGN-IN.md §3.10). Arguments: {s} = a number of seconds.
msgid "signin.return.timer"
msgstr "Retour automatique dans {s} s"

#. Stay here
#. Return step (SIGN-IN.md §3.10).
msgid "signin.return.stay"
msgstr "Rester ici"

#. macos: Stay Here
msgctxt "macos"
msgid "signin.return.stay"
msgstr "Rester ici"

#. Start using {product}
#. Last step of the in-app sign-in form (SIGN-IN.md §3.10). Arguments: {product} = the product's name (never translated).
msgid "signin.done.start"
msgstr "Commencer à utiliser {product}"

#. macos: Start Using {product}
msgctxt "macos"
msgid "signin.done.start"
msgstr "Commencer à utiliser {product}"

#. Sign in to finish on {device}
#. Device code approval on a phone or computer (SIGN-IN.md §3.11). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”.
msgid "signin.device.title"
msgstr "Connectez-vous pour terminer sur {device}"

#. Use your phone or computer here. {device} continues by itself when you're done.
#. Device code approval on a phone or computer (SIGN-IN.md §3.11). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”.
msgid "signin.device.lede"
msgstr "Utilisez votre téléphone ou ordinateur ici. {device} continuera tout seul une fois que vous aurez terminé."

#. Didn't start this yourself? Cancel it. Someone may be trying to use your account.
#. Device code approval on a phone or computer (SIGN-IN.md §3.11).
msgid "signin.device.cancel"
msgstr "Vous n’êtes pas à l’origine de cette demande ? Annulez-la. Quelqu’un tente peut-être d’utiliser votre compte."

#. {app} is signed in on {device}
#. Device code approval on a phone or computer (SIGN-IN.md §3.11). Arguments: {app} = the requesting app's name (never translated); {device} = a device's friendly name, for example “Maya's MacBook”.
msgid "signin.device.done"
msgstr "{app} est connecté sur {device}"

#. Look at {device}: it continues by itself.
#. Device code approval on a phone or computer (SIGN-IN.md §3.11). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”.
msgid "signin.device.doneLede"
msgstr "Regardez {device} : il continue tout seul."

#. Sign the TV out
#. Device code approval on a phone or computer (SIGN-IN.md §3.11).
msgid "signin.device.signOut"
msgstr "Déconnecter le téléviseur"

#. macos: Sign the TV Out
msgctxt "macos"
msgid "signin.device.signOut"
msgstr "Déconnecter le téléviseur"

#. Finish in your browser
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.title"
msgstr "Terminez dans votre navigateur"

#. Check the code there matches this one.
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.check"
msgstr "Vérifiez que le code affiché correspond à celui-ci."

#. Or go to {url}
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17). Arguments: {url} = a web address, shown as is.
msgid "signin.handoff.url"
msgstr "Ou rendez-vous sur {url}"

#. Code expires in {time}
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17). Arguments: {time} = a duration or time already formatted by the platform (“4:12”, “2 min ago”).
msgid "signin.handoff.expires"
msgstr "Le code expire dans {time}"

#. Open browser again
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.again"
msgstr "Rouvrir le navigateur"

#. macos: Open Browser Again
msgctxt "macos"
msgid "signin.handoff.again"
msgstr "Rouvrir le navigateur"

#. Sign-in was canceled. Get a new code
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.cancelled"
msgstr "La connexion a été annulée. Obtenez un nouveau code"

#. Continue in browser
#. Desktop app after sign-in (SIGN-IN.md §3.17).
msgid "signin.desktop.continue"
msgstr "Continuer dans le navigateur"

#. macos: Continue in Browser
msgctxt "macos"
msgid "signin.desktop.continue"
msgstr "Continuer dans le navigateur"

#. Signed in as {name} · {tier} license
#. Desktop app after sign-in (SIGN-IN.md §3.17). Arguments: {name} = the person's display name; {tier} = the tier's name (never translated).
msgid "signin.desktop.toast"
msgstr "Connecté en tant que {name} · licence {tier}"

#. You're signed in
#. Desktop app after sign-in (SIGN-IN.md §3.17).
msgid "signin.desktop.notifyTitle"
msgstr "Vous êtes connecté"

#. {app} is ready.
#. Desktop app after sign-in (SIGN-IN.md §3.17). Arguments: {app} = the requesting app's name (never translated).
msgid "signin.desktop.notifyBody"
msgstr "{app} est prêt."

#. Choose a license · {app} is ready to finish signing in.
#. Desktop system notification when the app needs a license choice to finish (SIGN-IN.md §3.17). Arguments: {app} = the requesting app's name (never translated).
msgid "signin.desktop.notifyChoose"
msgstr "Choisissez une licence · {app} est prêt à terminer la connexion."

#. Sign in…
#. App menu item that opens sign-in (SIGN-IN.md §3.17).
msgid "signin.menu.signIn"
msgstr "Se connecter…"

#. macos: Sign In…
msgctxt "macos"
msgid "signin.menu.signIn"
msgstr "Se connecter…"

#. We opened Polaris Locker in your browser. Sign in there and {app} continues by itself.
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17). Arguments: {app} = the requesting app's name (never translated).
msgid "signin.handoff.browserBody"
msgstr "Nous avons ouvert Polaris Locker dans votre navigateur. Connectez-vous dans le navigateur et {app} continuera tout seul."

#. Waiting for your browser…
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.waiting"
msgstr "En attente de votre navigateur…"

#. Finishing sign-in…
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.finishing"
msgstr "Finalisation de la connexion…"

#. Use a code instead
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.useCode"
msgstr "Utiliser plutôt un code"

#. macos: Use a Code Instead
msgctxt "macos"
msgid "signin.handoff.useCode"
msgstr "Utiliser plutôt un code"

#. Use browser sign-in
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.useBrowser"
msgstr "Se connecter via le navigateur"

#. macos: Use Browser Sign-In
msgctxt "macos"
msgid "signin.handoff.useBrowser"
msgstr "Se connecter via le navigateur"

#. We couldn't open your browser
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.noBrowser"
msgstr "Impossible d’ouvrir votre navigateur"

#. Open this link in a browser on this computer, or use a code instead.
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.noBrowserBody"
msgstr "Ouvrez ce lien dans un navigateur sur cet ordinateur, ou utilisez plutôt un code."

#. Copy link
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.copyLink"
msgstr "Copier le lien"

#. macos: Copy Link
msgctxt "macos"
msgid "signin.handoff.copyLink"
msgstr "Copier le lien"

#. This sign-in took too long.
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.tooLong"
msgstr "Cette connexion a pris trop de temps."

#. Sign in with a code
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.codeTitle"
msgstr "Se connecter avec un code"

#. On any phone or computer, go to {url} and enter this code.
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17). Arguments: {url} = a web address, shown as is.
msgid "signin.handoff.codeBody"
msgstr "Sur n’importe quel téléphone ou ordinateur, rendez-vous sur {url} et saisissez ce code."

#. Open browser
#. App waiting while sign-in runs in the browser (SIGN-IN.md §3.17).
msgid "signin.handoff.openBrowser"
msgstr "Ouvrir le navigateur"

#. macos: Open Browser
msgctxt "macos"
msgid "signin.handoff.openBrowser"
msgstr "Ouvrir le navigateur"

#. You can close this tab and return to {app}.
#. Return step (SIGN-IN.md §3.10). Arguments: {app} = the requesting app's name (never translated).
msgid "signin.return.closeTab"
msgstr "Vous pouvez fermer cet onglet et revenir à {app}."

#. Go back to {app} to choose a license. You can close this tab.
#. Return step when the license is chosen in the app (SIGN-IN.md §3.10). Arguments: {app} = the requesting app's name (never translated).
msgid "signin.return.chooseInApp"
msgstr "Revenez dans {app} pour choisir une licence. Vous pouvez fermer cet onglet."

#. You're signed in
#. Return step, short form (SIGN-IN.md §3.10).
msgid "signin.return.signedInShort"
msgstr "Vous êtes connecté"

#. You're signed in · {tier} license
#. Done step: signed in, with the license's tier. Arguments: {tier} = the tier's name (never translated).
msgid "signin.return.signedInTier"
msgstr "Vous êtes connecté · licence {tier}"

#. Sign-in was canceled in {app}. Start again from {app}.
#. Return step (SIGN-IN.md §3.10). Arguments: {app} = the requesting app's name (never translated).
msgid "signin.return.cancelled"
msgstr "La connexion a été annulée dans {app}. Recommencez depuis {app}."

#. Open your library
#. Return step (SIGN-IN.md §3.10).
msgid "signin.return.library"
msgstr "Ouvrir votre bibliothèque"

#. macos: Open Your Library
msgctxt "macos"
msgid "signin.return.library"
msgstr "Ouvrir votre bibliothèque"

#. A device is free on this license now.
#. Choose a license for this device (SIGN-IN.md §3.6).
msgid "signin.choice.freed"
msgstr "Un appareil est désormais libre sur cette licence."

#. Opens Polaris Locker in your browser
#. Replace a device, inline in the license choice (SIGN-IN.md §3.7).
msgid "signin.replace.opensBrowser"
msgstr "Ouvre Polaris Locker dans votre navigateur"

#. Opening your browser…
#. Terminal sign-in (SIGN-IN.md §4.15). Plain text, no formatting.
msgid "signin.cli.opening"
msgstr "Ouverture de votre navigateur…"

#. If it didn't open, go to {url}
#. Terminal sign-in (SIGN-IN.md §4.15). Plain text, no formatting. Arguments: {url} = a web address, shown as is.
msgid "signin.cli.ifNotOpened"
msgstr "S’il ne s’est pas ouvert, rendez-vous sur {url}"

#. Enter open again · c use a code · Esc cancel
#. Terminal sign-in (SIGN-IN.md §4.15). Plain text, no formatting.
msgid "signin.cli.keys"
msgstr "Entrée rouvrir · c utiliser un code · Échap annuler"

#. No browser on this computer. Use a code instead:
#. Terminal sign-in (SIGN-IN.md §4.15). Plain text, no formatting.
msgid "signin.cli.headless"
msgstr "Aucun navigateur sur cet ordinateur. Utilisez plutôt un code :"

#. Signed in as {name} ({email})
#. Terminal sign-in (SIGN-IN.md §4.15). Plain text, no formatting. Arguments: {name} = the person's display name; {email} = an email address.
msgid "signin.cli.signedIn"
msgstr "Connecté en tant que {name} ({email})"

#. {license} · {term} · {device} is device {position} of {limit}
#. Terminal sign-in (SIGN-IN.md §4.15). Plain text, no formatting. Arguments: {license} = the license's name, usually product and tier; {term} = the license term (one of the signin.term.* strings); {device} = a device's friendly name, for example “Maya's MacBook”; {position} = the device's seat number, as a number; {limit} = the license's device limit, as a number.
msgid "signin.cli.license"
msgstr "{license} · {term} · {device} est l’appareil {position} sur {limit}"

#. You can close the browser tab.
#. Terminal sign-in (SIGN-IN.md §4.15). Plain text, no formatting.
msgid "signin.cli.closeTab"
msgstr "Vous pouvez fermer l’onglet du navigateur."

#. Sign out of {product} on this device? (y/N)
#. Terminal sign-in (SIGN-IN.md §4.15). Plain text, no formatting. Arguments: {product} = the product's name from ProductIdentity (never translated).
msgid "signin.cli.logoutConfirm"
msgstr "Se déconnecter de {product} sur cet appareil ? (y/N)"

#. Run {command} to sign in again.
#. Terminal sign-in (SIGN-IN.md §4.15). Plain text, no formatting. Arguments: {command} = a terminal command, shown as is.
msgid "signin.cli.signInAgain"
msgstr "Exécutez {command} pour vous reconnecter."

#. Sign in with another device
#. Sign in with another device (SIGN-IN.md §3.11).
msgid "signin.approve.title"
msgstr "Se connecter avec un autre appareil"

#. Works for {time}
#. Sign in with another device (SIGN-IN.md §3.11). Arguments: {time} = a duration or time already formatted by the platform (“4:12”, “2 min ago”).
msgid "signin.approve.works"
msgstr "Valable {time}"

#. Waiting for you to approve it on the other device…
#. Sign in with another device (SIGN-IN.md §3.11).
msgid "signin.approve.waiting"
msgstr "En attente de votre approbation sur l’autre appareil…"

#. Approve a new device?
#. Sign in with another device (SIGN-IN.md §3.11).
msgid "signin.approve.ask"
msgstr "Approuver un nouvel appareil ?"

#. Only approve if you started this yourself, on a device in front of you. Nobody from Polaris Locker or a developer will ever ask you for this.
#. Sign in with another device (SIGN-IN.md §3.11).
msgid "signin.approve.warning"
msgstr "N’approuvez que si vous êtes à l’origine de cette demande, sur un appareil qui se trouve devant vous. Personne chez Polaris Locker ni aucun développeur ne vous le demandera jamais."

#. Check that your device shows this code.
#. Device approval page (SIGN-IN.md §3.13): always shown above the buttons. Polaris Locker never translated.
msgid "signin.approve.checkDevice"
msgstr "Vérifiez que votre appareil affiche ce code."

#. Approve and sign it in
#. Sign in with another device (SIGN-IN.md §3.11).
msgid "signin.approve.approve"
msgstr "Approuver et connecter"

#. macos: Approve and Sign It In
msgctxt "macos"
msgid "signin.approve.approve"
msgstr "Approuver et connecter"

#. Deny
#. Sign in with another device (SIGN-IN.md §3.11).
msgid "signin.approve.deny"
msgstr "Refuser"

#. That request was denied. Use another way to sign in.
#. Sign in with another device (SIGN-IN.md §3.11).
msgid "signin.approve.denied"
msgstr "Cette demande a été refusée. Utilisez un autre moyen de vous connecter."

#. That code expired. Get a new code.
#. Sign in with another device (SIGN-IN.md §3.11).
msgid "signin.approve.expired"
msgstr "Ce code a expiré. Obtenez-en un nouveau."

#. Sign in to the console
#. Console operator sign-in (SIGN-IN.md §3.12).
msgid "signin.console.title"
msgstr "Se connecter à la console"

#. Next: {idp} at {host}
#. Console operator sign-in (SIGN-IN.md §3.12). Arguments: {idp} = the identity provider's name; {host} = a host name.
msgid "signin.console.next"
msgstr "Étape suivante : {idp} sur {host}"

#. You're signed out
#. Console operator sign-in (SIGN-IN.md §3.12).
msgid "signin.console.signedOut"
msgstr "Vous êtes déconnecté"

#. Your session ended
#. Console operator sign-in (SIGN-IN.md §3.12).
msgid "signin.console.sessionEnded"
msgstr "Votre session a pris fin"

#. Sign in again to carry on. Your unsaved changes stay in this tab.
#. Console operator sign-in (SIGN-IN.md §3.12).
msgid "signin.console.sessionEndedBody"
msgstr "Reconnectez-vous pour continuer. Vos modifications non enregistrées restent dans cet onglet."

#. {email} isn't in the operators group.
#. Console operator sign-in (SIGN-IN.md §3.12). Arguments: {email} = an email address.
msgid "signin.console.notOperator"
msgstr "{email} ne fait pas partie du groupe des opérateurs."

#. Admin sign-in isn't set up
#. Console operator sign-in (SIGN-IN.md §3.12).
msgid "signin.console.notConfigured"
msgstr "La connexion administrateur n’est pas configurée"

#. That code or link has expired
#. Expired code or link page (SIGN-IN.md §4.12).
msgid "signin.expired.title"
msgstr "Ce code ou ce lien a expiré"

#. Codes and links work once, for 10 minutes.
#. Expired code or link page (SIGN-IN.md §4.12).
msgid "signin.expired.body"
msgstr "Les codes et les liens ne fonctionnent qu’une fois, pendant 10 minutes."

#. A new code goes to {email}.
#. Expired code or link page (SIGN-IN.md §4.12). Arguments: {email} = an email address, masked by the Worker. The button is signin.code.resend; the way back is signin.code.differentEmail.
msgid "signin.expired.sendTo"
msgstr "Le nouveau code sera envoyé à {email}."

#. Sign in again
#. Expired code or link page (SIGN-IN.md §4.12).
msgid "signin.again"
msgstr "Se reconnecter"

#. macos: Sign In Again
msgctxt "macos"
msgid "signin.again"
msgstr "Se reconnecter"

#. {product} doesn't use Polaris Locker sign-in. Open {product} and enter your license key there.
#. The product doesn't use Polaris Locker sign-in (SIGN-IN.md §4.12). Arguments: {product} = the product's name from ProductIdentity (never translated).
msgid "signin.identityOff.notice"
msgstr "{product} n’utilise pas la connexion Polaris Locker. Ouvrez {product} et saisissez-y votre clé de licence."

#. Sign in here to see {product} in your library.
#. The product doesn't use Polaris Locker sign-in (SIGN-IN.md §4.12). Arguments: {product} = the product's name from ProductIdentity (never translated).
msgid "signin.identityOff.lede"
msgstr "Connectez-vous ici pour voir {product} dans votre bibliothèque."

#. Sign out of {product} on this device?
#. Sign-out confirmation (SIGN-IN.md §4.9). Arguments: {product} = the product's name from ProductIdentity (never translated).
msgid "signin.signout.title"
msgstr "Se déconnecter de {product} sur cet appareil ?"

#. {product} stops using your {tier} license on this device and frees room for another device.
#. Sign-out confirmation (SIGN-IN.md §4.9). Arguments: {product} = the product's name from ProductIdentity (never translated); {tier} = the tier's name (never translated).
msgid "signin.signout.released"
msgstr "{product} cesse d’utiliser votre licence {tier} ici et libère de la place pour un autre appareil."

#. Sign out of {product} on this Mac?
#. Sign-out confirmation in the macOS Settings pane (SIGN-IN.md §4.9, D-71): signin.signout.title with the Mac named. Arguments: {product} = the product's name from ProductIdentity (never translated).
msgid "signin.signout.titleMac"
msgstr "Se déconnecter de {product} sur ce Mac ?"

#. This frees your {tier} license for another device.
#. Sign-out confirmation in the macOS Settings pane (SIGN-IN.md §4.9, D-71): signin.signout.released, shorter. Arguments: {tier} = the tier's name (never translated).
msgid "signin.signout.releasedMac"
msgstr "Cela libère votre licence {tier} pour un autre appareil."

#. {n, plural, one {# change hasn't synced yet.} other {# changes haven't synced yet.}}
#. Sign-out confirmation (SIGN-IN.md §4.9). Arguments: {n} = a number.
#. Plural on {n}.
msgid "signin.signout.unsynced"
msgid_plural "signin.signout.unsynced"
msgstr[0] "{n} modification n’a pas encore été synchronisée."
msgstr[1] "{n} de modifications n’ont pas encore été synchronisées."
msgstr[2] "{n} modifications n’ont pas encore été synchronisées."

#. Wait for sync
#. Sign-out confirmation (SIGN-IN.md §4.9).
msgid "signin.signout.waitSync"
msgstr "Attendre la synchronisation"

#. macos: Wait for Sync
msgctxt "macos"
msgid "signin.signout.waitSync"
msgstr "Attendre la synchronisation"

#. You were signed out
#. Session ended (SIGN-IN.md §4.10).
msgid "signin.session.toastTitle"
msgstr "Vous avez été déconnecté"

#. Sign in again to carry on where you were.
#. Session ended (SIGN-IN.md §4.10).
msgid "signin.session.toastBody"
msgstr "Reconnectez-vous pour reprendre là où vous en étiez."

#. Your sign-in ended. Sign in again to keep using {product}.
#. Session ended (SIGN-IN.md §4.10). Arguments: {product} = the product's name from ProductIdentity (never translated).
msgid "signin.session.kitEnded"
msgstr "Votre connexion a pris fin. Reconnectez-vous pour continuer à utiliser {product}."

#. Manage sign-in methods in Polaris Locker
#. Sign-in provider buttons (SIGN-IN.md §3.3).
msgid "signin.provider.manage"
msgstr "Gérer les méthodes de connexion dans Polaris Locker"

#. macos: Manage Sign-In Methods in Polaris Locker
msgctxt "macos"
msgid "signin.provider.manage"
msgstr "Gérer les méthodes de connexion dans Polaris Locker"

#. Change picture
#. Profile import (SIGN-IN.md §3.5).
msgid "signin.profile.changePicture"
msgstr "Changer de photo"

#. macos: Change Picture
msgctxt "macos"
msgid "signin.profile.changePicture"
msgstr "Changer de photo"

#. {product} signed out on {device}
#. Security email (SIGN-IN.md §3.15). Arguments: {product} = the product's name from ProductIdentity (never translated); {device} = a device's friendly name, for example “Maya's MacBook”.
msgid "signin.mail.replaced.subject"
msgstr "{product} déconnecté sur {device}"

#. {device} was replaced by {newDevice} when you signed in to {product} on {date}. It can sign in again later if there is room for another device. If this wasn't you, open Polaris Locker and check your devices.
#. Security email (SIGN-IN.md §3.15). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”; {newDevice} = the new device's friendly name; {product} = the product's name from ProductIdentity (never translated); {date} = a date already formatted by the platform.
msgid "signin.mail.replaced.body"
msgstr "{device} a été remplacé par {newDevice} lorsque vous vous êtes connecté à {product} le {date}. Il pourra se reconnecter plus tard s’il reste de la place pour un autre appareil. Si ce n’était pas vous, ouvrez Polaris Locker et vérifiez vos appareils."

#. A new device signed in to your Polaris Locker account
#. Security email (SIGN-IN.md §3.15).
msgid "signin.mail.newDevice.subject"
msgstr "Un nouvel appareil s’est connecté à votre compte Polaris Locker"

#. {device} signed in on {date} from {place}. If this wasn't you, sign it out in Polaris Locker under Where you're signed in.
#. Security email (SIGN-IN.md §3.15). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”; {date} = a date already formatted by the platform; {place} = an approximate place (city, country).
msgid "signin.mail.newDevice.body"
msgstr "{device} s’est connecté le {date} depuis {place}. Si ce n’était pas vous, déconnectez-le dans Polaris Locker, rubrique « Où vous êtes connecté »."

#. Open Polaris Locker
#. Security email (SIGN-IN.md §3.15).
msgid "signin.mail.open"
msgstr "Ouvrir Polaris Locker"

#. 6-digit code
#. Email code step (SIGN-IN.md §3.4).
msgid "signin.code.label"
msgstr "Code à 6 chiffres"

#. License
#. Terminal help: the heading over the license commands (activate, status…).
msgid "cli.group.license"
msgstr "Licence"

#. Account
#. Terminal help: the heading over the sign-in and sign-out commands.
msgid "cli.group.account"
msgstr "Compte"

#. Devices
#. Terminal help: the heading over the device commands.
msgid "cli.group.devices"
msgstr "Appareils"

#. Settings
#. Terminal help: the heading over the settings (config) commands.
msgid "cli.group.settings"
msgstr "Paramètres"

#. Updates
#. Terminal help: the heading over the update and release-notes commands.
msgid "cli.group.updates"
msgstr "Mises à jour"

#. Content
#. Terminal help: the heading over the downloadable content (packs) commands.
msgid "cli.group.content"
msgstr "Contenu"

#. Support
#. Terminal help: the heading over diagnostics and offline activation commands.
msgid "cli.group.support"
msgstr "Assistance"

#. Usage
#. Terminal help: the label before the command's usage line, like 'Usage  tidewater <command> [options]'.
msgid "cli.help.usage"
msgstr "Utilisation"

#. Options
#. Terminal help: the heading over the flags every command takes.
msgid "cli.help.options"
msgstr "Options"

#. {product} license and updates
#. Terminal help: one line under the command name saying what the command-line tool does.
msgid "cli.help.lede"
msgstr "Licence et mises à jour de {product}"

#. Run {command} for one command's options.
#. Terminal help footer. {command} is a command line such as 'tidewater activate --help'.
msgid "cli.help.more"
msgstr "Exécutez {command} pour voir les options d’une commande."

#. License
#. Terminal help of a host's own command-line tool: the one heading over the license commands it mounted (activate, status, login…), after the tool's own headings.
msgid "cli.help.group"
msgstr "Licence"

#. Activate, sign in, devices and updates
#. Terminal help of a host's own command-line tool: what the one namespace command (license) holds, when the license commands are nested under it.
msgid "cli.help.namespace"
msgstr "Activation, connexion, appareils et mises à jour"

#. {command} needs a license
#. Terminal: the title when a host command that needs a license is refused because the person has none (needs-activation), and the first line of the inline activate flow. {command} is the command they ran, such as 'export'.
msgid "cli.gate.needs"
msgstr "{command} nécessite une licence"

#. Your license doesn't include {command}
#. Terminal: the title when a host command is refused because the person's license does not hold the entitlement it needs. They have a license, so it is never 'needs a license'. {command} is the command they ran, such as 'export'.
msgid "cli.gate.notIncluded"
msgstr "Votre licence n’inclut pas {command}"

#. Add a license key (prompted, or piped on stdin)
#. Terminal help: what the activate command does. The key is typed at a prompt or piped in, never written on the command line.
msgid "cli.verb.activate"
msgstr "Ajouter une clé de licence (saisie, ou via stdin)"

#. Get the free license, when {product} offers one
#. Terminal help: what the enroll command does.
msgid "cli.verb.enroll"
msgstr "Obtenir la licence gratuite, si {product} en propose une"

#. Stop using your license on this device and make room for another
#. Terminal help: what the deactivate command does.
msgid "cli.verb.deactivate"
msgstr "Retirer votre licence de cet appareil et libérer de la place pour un autre"

#. Show your license, devices and offline time
#. Terminal help: what the status command shows.
msgid "cli.verb.status"
msgstr "Afficher la licence, les appareils et le temps hors ligne"

#. Print the request code for offline activation
#. Terminal help: what the offline-request command does.
msgid "cli.verb.offlineRequest"
msgstr "Afficher le code de demande pour l’activation hors ligne"

#. Activate from an offline activation file
#. Terminal help: what the import-bundle command does.
msgid "cli.verb.importBundle"
msgstr "Activer depuis un fichier d’activation hors ligne"

#. Sign in with your account in the browser
#. Terminal help: what the login command does.
msgid "cli.verb.login"
msgstr "Se connecter avec votre compte dans le navigateur"

#. Sign out on this device
#. Terminal help: what the logout command does.
msgid "cli.verb.logout"
msgstr "Se déconnecter sur cet appareil"

#. Register this device without a license key
#. Terminal help: what the register command does.
msgid "cli.verb.register"
msgstr "Enregistrer cet appareil sans clé de licence"

#. List the devices using your license
#. Terminal help: what 'devices list' does.
msgid "cli.verb.devicesList"
msgstr "Lister les appareils qui utilisent votre licence"

#. Rename a device (no name clears it)
#. Terminal help: what 'devices rename' does.
msgid "cli.verb.devicesRename"
msgstr "Renommer un appareil (sans nom, le nom est effacé)"

#. Remove a device and make room for another
#. Terminal help: what 'devices deauthorize' does.
msgid "cli.verb.devicesRemove"
msgstr "Retirer un appareil et libérer de la place pour un autre"

#. Show one setting and where its value comes from
#. Terminal help: what 'config get' does.
msgid "cli.verb.configGet"
msgstr "Afficher un paramètre et l’origine de sa valeur"

#. List the settings you can see
#. Terminal help: what 'config list' does.
msgid "cli.verb.configList"
msgstr "Lister les paramètres que vous pouvez voir"

#. Change a setting on this device
#. Terminal help: what 'config set' does.
msgid "cli.verb.configSet"
msgstr "Modifier un paramètre sur cet appareil"

#. Reset a setting to its default
#. Terminal help: what 'config reset' does.
msgid "cli.verb.configReset"
msgstr "Rétablir la valeur par défaut d’un paramètre"

#. Print a secret delivered to this device
#. Terminal help: what the secret command does.
msgid "cli.verb.secret"
msgstr "Afficher un secret fourni à cet appareil"

#. Get a short-lived token from a recipe
#. Terminal help: what the mint command does.
msgid "cli.verb.mint"
msgstr "Obtenir un jeton de courte durée à partir d’une recette"

#. Check for a newer version
#. Terminal help: what 'update check' does.
msgid "cli.verb.updateCheck"
msgstr "Rechercher une version plus récente"

#. Download and install the newer version
#. Terminal help: what 'update apply' does.
msgid "cli.verb.updateApply"
msgstr "Télécharger et installer la version plus récente"

#. Show what's new in each version
#. Terminal help: what the changelog command does.
msgid "cli.verb.changelog"
msgstr "Afficher les nouveautés de chaque version"

#. Show installed and downloading content
#. Terminal help: what 'packs status' does.
msgid "cli.verb.packsStatus"
msgstr "Afficher le contenu installé et en téléchargement"

#. Download and install content, with progress
#. Terminal help: what 'packs ensure' does.
msgid "cli.verb.packsEnsure"
msgstr "Télécharger et installer du contenu, avec progression"

#. Show what this device can do, for support
#. Terminal help: what the doctor command does.
msgid "cli.verb.doctor"
msgstr "Afficher ce que cet appareil peut faire, pour l’assistance"

#. Run startup, one line per stage
#. Terminal help: what the boot command does.
msgid "cli.verb.boot"
msgstr "Lancer le démarrage, une ligne par étape"

#. Print shell completion for bash, zsh or fish
#. Terminal help: what the completion command does. bash, zsh and fish are shell names; keep them.
msgid "cli.verb.completion"
msgstr "Générer la complétion shell pour bash, zsh ou fish"

#. JSON output for scripts, on every command
#. Terminal help: what the --json flag does.
msgid "cli.option.json"
msgstr "Sortie JSON pour les scripts, sur toutes les commandes"

#. Plain text (also NO_COLOR=1)
#. Terminal help: what the --no-color flag does. NO_COLOR=1 is an environment variable; keep it.
msgid "cli.option.noColor"
msgstr "Texte brut (aussi NO_COLOR=1)"

#. ASCII symbols only
#. Terminal help: what the --ascii flag does.
msgid "cli.option.ascii"
msgstr "Symboles ASCII uniquement"

#. Help for a command
#. Terminal help: what the -h, --help flag does.
msgid "cli.option.help"
msgstr "Aide sur une commande"

#. Don't ask before signing out
#. Terminal help: what the --yes flag does.
msgid "cli.option.yes"
msgstr "Ne pas demander avant la déconnexion"

#. Download required content without asking
#. Terminal help: what the --yes flag does on boot.
msgid "cli.option.yesDownload"
msgstr "Télécharger le contenu requis sans demander"

#. Sign in with a code instead of this computer's browser
#. Terminal help: what the --device-code flag does.
msgid "cli.option.deviceCode"
msgstr "Se connecter avec un code au lieu du navigateur local"

#. Read the license key from a file
#. Terminal help: what the --key-file flag of the activate command does.
msgid "cli.option.keyFile"
msgstr "Lire la clé de licence depuis un fichier"

#. Read the license key from standard input
#. Terminal help: what the --key-stdin flag of the activate command does.
msgid "cli.option.keyStdin"
msgstr "Lire la clé de licence depuis l’entrée standard"

#. Print the value even if a CI log would run a line of it as a command
#. Terminal help: what the --allow-workflow-commands flag of the secret and mint commands does. A CI log is a build server's job log (GitHub Actions, Azure Pipelines); a command is an instruction the build server reads from that log.
msgid "cli.option.allowWorkflowCommands"
msgstr "Afficher la valeur même si un journal de CI exécuterait l’une de ses lignes comme une commande"

#. Enter activate · Esc cancel
#. Terminal key hints under the license key prompt. Each part is a key name, a space, then what it does; keep the key first and the ' · ' separators.
msgid "cli.keys.activate"
msgstr "Entrée activer · Échap annuler"

#. c copy the code · Esc cancel
#. Terminal key hints while waiting for a code sign-in. 'c' is the key to press; keep the key first and the ' · ' separators.
msgid "cli.keys.code"
msgstr "c copier le code · Échap annuler"

#. Enter open in browser · Esc cancel
#. Terminal key hints when every device on the license is in use: Enter opens the page that replaces a device. Keep the key first and the ' · ' separators.
msgid "cli.keys.deviceLimit"
msgstr "Entrée ouvrir dans le navigateur · Échap annuler"

#. Enter try again · Esc cancel
#. Terminal key hints after the browser opened to free a device: Enter tries the activation again. Keep the key first and the ' · ' separators.
msgid "cli.keys.retry"
msgstr "Entrée réessayer · Échap annuler"

#. Esc cancel
#. Terminal key hint while an update downloads. Keep the key first.
msgid "cli.keys.download"
msgstr "Échap annuler"

#. Waiting for you to sign in…
#. Terminal: shown beside the spinner while the person enters the code on another device.
msgid "cli.signin.waitingCode"
msgstr "En attente de votre connexion…"

#. Signed in as {email}
#. Terminal: the sign-in finished and only the email is known.
msgid "cli.signin.signedInEmail"
msgstr "Connecté en tant que {email}"

#. A key typed after the command is saved in your shell history. Next time, run {command} and paste the key when it asks.
#. Terminal warning when a license key was given on the command line. {command} is a command line such as 'tidewater activate'.
msgid "cli.activate.argWarning"
msgstr "Une clé saisie après la commande est enregistrée dans l’historique de votre shell. La prochaine fois, exécutez {command} et collez la clé quand elle vous est demandée."

#. No license key. Run {command} in a terminal, or pipe the key to it.
#. Terminal: activate ran where it cannot ask for the key (no terminal) and nothing was piped in.
msgid "cli.activate.noKey"
msgstr "Aucune clé de licence. Exécutez {command} dans un terminal, ou transmettez-lui la clé par un pipe."

#. Free a device, then run {command} again.
#. Terminal: every device on the license is in use; free one in the browser, then activate again. {command} is a command line.
msgid "cli.deviceLimit.again"
msgstr "Libérez un appareil, puis exécutez à nouveau {command}."

#. License
#. Terminal status: the row label for the license (tier and holder).
msgid "cli.status.license"
msgstr "Licence"

#. Offline
#. Terminal status: the row label for how long the app works without the internet.
msgid "cli.status.offline"
msgstr "Hors ligne"

#. until {date}
#. Terminal status: the license keeps working without the internet until {date} (a short date). It follows the row label 'Offline', so it starts with the preposition.
msgid "cli.status.offlineUntil"
msgstr "jusqu’au {date}"

#. Version
#. Terminal status: the row label for the app's version and release channel.
msgid "cli.status.version"
msgstr "Version"

#. To keep using {product}:
#. Terminal status: the heading over the commands that fix a blocked license.
msgid "cli.status.fixes"
msgstr "Pour continuer à utiliser {product} :"

#. Next step on the {product} page:
#. Terminal status and gate: the line over the product page link, for a refusal no command fixes (version too new, channel not entitled). Arguments: {product} = the product's name from ProductIdentity (never translated).
msgid "cli.status.portal"
msgstr "Prochaine étape sur la page de {product} :"

#. Use the license on your account
#. Terminal status: what the login command does as a fix for a blocked license.
msgid "cli.fix.signIn"
msgstr "Utiliser la licence de votre compte"

#. Signed out of {product} on this device.
#. Terminal: sign-out finished.
msgid "cli.logout.done"
msgstr "Déconnecté de {product} sur cet appareil."

#. {product} no longer uses your license on this device. It no longer counts toward your limit.
#. Terminal: deactivate finished; the device no longer counts toward the license limit.
msgid "cli.deactivate.done"
msgstr "{product} n’utilise plus votre licence sur cet appareil. Sa place est libre."

#. Nothing changed.
#. Terminal: the person answered no to a confirmation.
msgid "cli.nothingChanged"
msgstr "Rien n’a été modifié."

#. This device is registered.
#. Terminal: keyless device registration finished.
msgid "cli.register.done"
msgstr "Cet appareil est enregistré."

#. Renamed to {device}.
#. Terminal: a device was renamed; {device} is the new name.
msgid "cli.devices.renamed"
msgstr "Renommé en {device}."

#. {device} has no name now.
#. Terminal: a device's name was cleared; {device} is the device's id.
msgid "cli.devices.nameCleared"
msgstr "{device} n’a plus de nom."

#. {device} was removed. It no longer counts toward your limit.
#. Terminal: a device was removed from the license.
msgid "cli.devices.removed"
msgstr "{device} a été retiré. Sa place est libre."

#. Update canceled.
#. Terminal: the person stopped an update download. The title; 'Nothing was installed.' is the body line under it.
msgid "cli.update.cancelled"
msgstr "Mise à jour annulée."

#. No content is installed.
#. Terminal: there are no downloadable content packs on this device.
msgid "cli.packs.none"
msgstr "Aucun contenu n’est installé."

#. after a restart
#. Terminal: a content pack is installed and takes effect after the app restarts. Shown after the pack's version.
msgid "cli.packs.afterRestart"
msgstr "après un redémarrage"

#. {name} has no value.
#. Terminal: a setting has no value and no default. {name} is the setting's key.
msgid "cli.config.unset"
msgstr "{name} n’a pas de valeur."

#. No secret named {name} is delivered to this device.
#. Terminal: the secret command found nothing. {name} is the secret's key.
msgid "cli.secret.none"
msgstr "Aucun secret nommé {name} n’est fourni à cet appareil."

#. The value was not printed: this CI log would run a line of it as a command. To print it anyway, run {command}.
#. Terminal: the secret or mint command did not print its value (a secret or a token) because the build server reading the output would treat a line of it as an instruction. {command} is a command line (the same command with --allow-workflow-commands).
msgid "cli.output.workflowCommand"
msgstr "La valeur n’a pas été affichée : ce journal de CI exécuterait l’une de ses lignes comme une commande. Pour l’afficher quand même, exécutez {command}."

#. Then run {command} with the file you get back.
#. Terminal offline activation: what to do with the activation file. {command} is a command line.
msgid "cli.offline.import"
msgstr "Exécutez ensuite {command} avec le fichier que vous recevrez en retour."

#. SDK
#. Terminal diagnostics: the row label for the SDK name and version.
msgid "cli.doctor.sdk"
msgstr "SDK"

#. Product
#. Terminal diagnostics: the row label for the product and its version.
msgid "cli.doctor.product"
msgstr "Produit"

#. Server
#. Terminal diagnostics: the row label for the server address.
msgid "cli.doctor.server"
msgstr "Serveur"

#. Device
#. Terminal diagnostics: the row label for this device's id.
msgid "cli.doctor.device"
msgstr "Appareil"

#. Token store
#. Terminal diagnostics: the row label for where the device's credential is kept (keyring or file).
msgid "cli.doctor.store"
msgstr "Stockage du jeton"

#. Discovery
#. Terminal diagnostics: the row label for whether the product's service description could be read.
msgid "cli.doctor.discovery"
msgstr "Découverte"

#. Reachable
#. Terminal diagnostics: the product's service description was read.
msgid "cli.doctor.reachable"
msgstr "Accessible"

#. Services
#. Terminal diagnostics: the row label for the services the product turned on.
msgid "cli.doctor.services"
msgstr "Services"

#. Installed from
#. Terminal diagnostics: the row label for the store or channel the app was installed from.
msgid "cli.doctor.installedFrom"
msgstr "Installé depuis"

#. Not supported here
#. Terminal diagnostics: the heading over features this device cannot use, each with its reason.
msgid "cli.doctor.unsupported"
msgstr "Non pris en charge ici"

#. c copy the code · o open in browser · Esc cancel
#. Terminal key hints while waiting for a code sign-in on a computer that has a browser: c copies the code, o opens the sign-in page with the code filled in. Keep each key first and the ' · ' separators.
msgid "cli.keys.codeBrowser"
msgstr "c copier le code · o ouvrir dans le navigateur · Échap annuler"

#. This key is for another product ({app}). Use your {product} key.
#. Terminal key prompt: the key belongs to a different product. {app} is that product's slug, {product} the product this command is for.
msgid "cli.activate.otherProduct"
msgstr "Cette clé est celle d’un autre produit ({app}). Utilisez votre clé {product}."

#. {size} of {total}
#. Terminal update progress: how much of the download is done. {size} is a bare number and {total} carries the unit, so 'of' joins '38' and '61 MB'.
msgid "cli.update.figures"
msgstr "{size} sur {total}"

#. {size}/{total}
#. Terminal update progress on a narrow line: the short form of the sizes. {size} is a bare number and {total} carries the unit.
msgid "cli.update.figuresShort"
msgstr "{size}/{total}"

#. {time} left
#. Terminal update progress: the estimated time left. {time} is a short duration such as '20 s'.
msgid "cli.update.timeLeft"
msgstr "il reste {time}"

#. {version} is ready · {size}
#. Terminal: the update finished downloading. {version} is the new version, {size} the download size (like '61 MB'). The chip above already names the product.
msgid "cli.update.ready"
msgstr "{version} est prête · {size}"

#. {version} is ready
#. Terminal: the update is ready and its size is not known. {version} is the new version.
msgid "cli.update.readyNoSize"
msgstr "{version} est prête"

#. Restart to finish updating.
#. Terminal: after an update downloaded, what the person does next.
msgid "cli.update.restart"
msgstr "Redémarrez pour terminer la mise à jour."

#. Nothing was installed.
#. Terminal: an update download failed; nothing was changed on this device.
msgid "cli.update.nothingInstalled"
msgstr "Rien n’a été installé."

#. Replace a device in your browser, then try again here.
#. Terminal: every device on the license is in use. The terminal does not poll, so it says what to do and asks to try again here.
msgid "cli.deviceLimit.body"
msgstr "Remplacez un appareil dans votre navigateur, puis réessayez ici."

#. Devices
#. Terminal status: the row label for how many devices use the license.
msgid "cli.status.devices"
msgstr "Appareils"

#. {used} of {limit}
#. Terminal status: devices in use out of the license's limit, like '2 of 3'.
msgid "cli.status.seatsOf"
msgstr "{used} sur {limit}"

#. {version} is available · {size}
#. Terminal update check: a newer version exists. {version} is the version, {size} the download size (like '61 MB'). The chip above already names the product.
msgid "cli.update.available"
msgstr "{version} est disponible · {size}"

#. {version} is available
#. Terminal update check: a newer version exists and its size is not known. {version} is the version.
msgid "cli.update.availableNoSize"
msgstr "{version} est disponible"

#. You have {version}
#. Terminal update check: the version installed now. {version} is that version.
msgid "cli.update.have"
msgstr "Vous avez {version}"

#. Install
#. Terminal update check: what the 'update apply' command does, beside the command.
msgid "cli.update.install"
msgstr "Installer"

#. Check your connection and run {command} again.
#. Terminal changelog: what to do after the release notes failed to load. {command} is a command line.
msgid "cli.changelog.fix"
msgstr "Vérifiez votre connexion, puis exécutez à nouveau {command}."

#. Ask whoever sent it for a new file.
#. Terminal offline activation: what to do after an activation file was refused.
msgid "cli.import.fix"
msgstr "Demandez un nouveau fichier à la personne qui vous l’a envoyé."

#. {product} doesn't offer account sign-in.
#. Terminal sign-in: the product has no account sign-in. {product} is the product.
msgid "cli.identityOff.notice"
msgstr "{product} ne propose pas la connexion avec un compte."

#. Run {command} with your license key.
#. Terminal sign-in: what to do instead when the product has no sign-in. {command} is a command line such as 'tidewater activate'.
msgid "cli.identityOff.fix"
msgstr "Exécutez {command} avec votre clé de licence."

#. Use this device's license key on your account? (y/N)
#. Terminal sign-in, after the browser sign-in finished on a device that holds a license key: add that license to the account just signed in? Answers: y, n, Enter for No (the default). Keep the (y/N) prompt; it names the keys to press.
msgid "cli.login.attach"
msgstr "Associer la clé de licence de cet appareil à votre compte ? (y/N)"

#. y yes · n no · Esc cancel sign-in
#. Terminal key hints under a yes or no question. Each part is a key name, a space, then what it does; keep the key first and the ' · ' separators.
msgid "cli.keys.confirm"
msgstr "y oui · n non · Échap annuler la connexion"

#. Signed in as {name}
#. Terminal: the sign-in finished and only the name is known. {name} = the account's name.
msgid "cli.signin.signedInName"
msgstr "Connecté en tant que {name}"

#. Verifying…
#. Update progress: the download finished and the update is being checked before it is installed.
msgid "update.verifying"
msgstr "Vérification…"

#. {version} is ready · Restart to finish
#. Terminal: an update was downloaded and checked; it takes effect after a restart. {version} = a version string such as 2.5.0. Keep the ' · ' separator.
msgid "cli.update.readyRestart"
msgstr "{version} est prête · Redémarrez pour terminer"

#. Updates aren't set up
#. Terminal: update apply on a build with no signed update feed set up. The title; the body line under it says what to run instead.
msgid "cli.update.notConfiguredTitle"
msgstr "Les mises à jour ne sont pas configurées"

#. Download it here:
#. Terminal: update apply on an install that cannot update itself. It ends in a colon: the download page follows on its own line, as a link.
msgid "cli.update.download"
msgstr "Téléchargez-la ici :"

#. This license key no longer works
#. Terminal status: a device activated with a license key only, and the license is no longer valid.
msgid "cli.status.keyRevoked.title"
msgstr "Cette clé de licence ne fonctionne plus"

#. It may have expired or been turned off:
#. Terminal status, under the title above. It ends in a colon: the product's account page on Polaris Locker follows on its own line, as a link.
msgid "cli.status.keyRevoked.message"
msgstr "Elle a peut-être expiré ou été désactivée :"

#. Check it for typos. If it's right, it may have expired or been turned off:
#. Terminal activate: the server did not accept the license key, under the title 'Key not accepted'. It answers the same for a wrong key and for one that expired or was turned off, so the text covers both. It ends in a colon: the product's account page on Polaris Locker follows on its own line, as a link.
msgid "cli.activate.unauthorized"
msgstr "Vérifiez qu’elle ne contient pas de faute. Si elle est correcte, elle a peut-être expiré ou été désactivée :"

#. Print the value
#. Terminal help: what the --reveal flag does. A command-line flag; keep it as is.
msgid "cli.option.reveal"
msgstr "Afficher la valeur"

#. {name} is set but not printed
#. Terminal: the secret command without --reveal, as the title of a warning; the command that prints it follows as a command row. {name} = the secret's name.
msgid "cli.secret.hidden"
msgstr "{name} est défini mais non affiché"

#. Nothing was minted
#. Terminal: the mint command without --reveal, as the title of a warning; the command that mints and prints follows as a command row.
msgid "cli.mint.hidden"
msgstr "Rien n’a été généré"

#. Mint and print a token
#. Terminal: the label of the command row under the mint warning 'Nothing was minted': running it mints a token and prints it.
msgid "cli.mint.reveal"
msgstr "Générer et afficher un jeton"

#. The key file is empty
#. Terminal activate --key-file: the warning title when the file holds no key. The file's path follows under it.
msgid "cli.keyFile.empty"
msgstr "Le fichier de clé est vide"

#. The key file can't be read
#. Terminal activate --key-file: the warning title when the file cannot be read. The file's path follows under it.
msgid "cli.keyFile.unreadable"
msgstr "Le fichier de clé est illisible"

#. macOS
#. Terminal: the name of an operating system, shown in the device list (macos is macOS). A product name; keep it as is in every language.
msgid "cli.platform.macos"
msgstr "macOS"

#. iOS
#. Terminal: the name of an operating system, shown in the device list (macos is macOS). A product name; keep it as is in every language.
msgid "cli.platform.ios"
msgstr "iOS"

#. Android
#. Terminal: the name of an operating system, shown in the device list (macos is macOS). A product name; keep it as is in every language.
msgid "cli.platform.android"
msgstr "Android"

#. Windows
#. Terminal: the name of an operating system, shown in the device list (macos is macOS). A product name; keep it as is in every language.
msgid "cli.platform.windows"
msgstr "Windows"

#. Linux
#. Terminal: the name of an operating system, shown in the device list (macos is macOS). A product name; keep it as is in every language.
msgid "cli.platform.linux"
msgstr "Linux"

#. Web
#. Terminal: the name of an operating system, shown in the device list (macos is macOS). A product name; keep it as is in every language.
msgid "cli.platform.web"
msgstr "Web"

#. tvOS
#. Terminal: the name of an operating system, shown in the device list (macos is macOS). A product name; keep it as is in every language.
msgid "cli.platform.tvos"
msgstr "tvOS"

#. visionOS
#. Terminal: the name of an operating system, shown in the device list (macos is macOS). A product name; keep it as is in every language.
msgid "cli.platform.visionos"
msgstr "visionOS"

#. watchOS
#. Terminal: the name of an operating system, shown in the device list (macos is macOS). A product name; keep it as is in every language.
msgid "cli.platform.watchos"
msgstr "watchOS"

#. The license key is now on your account.
#. Terminal sign-in: the person said yes to adding this device's license key to the account just signed in.
msgid "cli.login.attached"
msgstr "La clé de licence est maintenant associée à votre compte."

#. Get the new version from where you got {product}.
#. Terminal: update apply on an install that cannot update itself and has no download page to link. {product} = the product's name from ProductIdentity (never translated).
msgid "cli.update.downloadNoLink"
msgstr "Récupérez la nouvelle version là où vous avez obtenu {product}."

#. No license key arrived on stdin.
#. Terminal: activate read a piped stdin (a file, pipe or socket) and no key arrived in time.
msgid "cli.activate.noKeyPiped"
msgstr "Aucune clé de licence n’est arrivée sur stdin."

#. On a phone or computer where you're signed in, scan the code, or open Account → Approve a new device and type it.
#. Sign in with another device: under the title (SIGN-IN.md §3.11). Account → Approve a new device is the portal's own menu path.
msgid "signin.approve.lede"
msgstr "Sur un téléphone ou un ordinateur où vous êtes connecté, scannez le code, ou ouvrez Compte → Approuver un nouvel appareil et saisissez-le."

#. Use another way to sign in
#. Polaris Locker sign-in card (SIGN-IN.md §3.4, §3.5, §3.11).
msgid "signin.approve.other"
msgstr "Utiliser une autre méthode de connexion"

#. macos: Use Another Way to Sign In
msgctxt "macos"
msgid "signin.approve.other"
msgstr "Utiliser une autre méthode de connexion"

#. One minute left on this code.
#. Announced once when the sign-in code has one minute left (WCAG 2.2.1).
msgid "signin.approve.minuteLeft"
msgstr "Il reste une minute pour ce code."

#. Getting your code
#. Busy label while the sign-in code is requested.
msgid "signin.approve.starting"
msgstr "Obtention de votre code"

#. That account can't sign in. Use another way to sign in.
#. Sign in with another device or a passkey, for an account that can't sign in.
msgid "signin.approve.disabled"
msgstr "Ce compte ne peut pas se connecter. Utilisez une autre méthode."

#. Approve a new device
#. Account → Where you're signed in: opens the approve dialog (SIGN-IN.md §3.11).
msgid "signin.approve.open"
msgstr "Approuver un nouvel appareil"

#. macos: Approve a New Device
msgctxt "macos"
msgid "signin.approve.open"
msgstr "Approuver un nouvel appareil"

#. Enter the code shown on the other device.
#. Approve dialog, when the link carried no code.
msgid "signin.approve.enter"
msgstr "Saisissez le code affiché sur l’autre appareil."

#. Code
#. Approve dialog: the field's label.
msgid "signin.approve.codeLabel"
msgstr "Code"

#. Find it
#. Approve dialog: looks the code up (reads only, never approves).
msgid "signin.approve.look"
msgstr "Rechercher"

#. macos: Find It
msgctxt "macos"
msgid "signin.approve.look"
msgstr "Rechercher"

#. pkey on {host} asks for a read-only personal token for your packages.
#. Approve dialog, for a command-line tool asking to read the account's packages. Arguments: {host} = the machine's name, shown as is.
msgid "signin.approve.askPackages"
msgstr "pkey sur {host} demande un jeton personnel en lecture seule pour vos paquets."

#. Give pkey a personal token?
#. Approve dialog title for the pkey command-line tool asking for a packages token. 'pkey' is a product name; keep it.
msgid "signin.approve.askPackagesTitle"
msgstr "Donner un jeton personnel à pkey ?"

#. Approve
#. Approve dialog, confirm button for the pkey packages token.
msgid "signin.approve.approvePackages"
msgstr "Approuver"

#. Approved. Go back to your terminal.
#. Approve dialog outcome after approving the pkey packages token.
msgid "signin.approve.approvedPackages"
msgstr "Approuvé. Retournez à votre terminal."

#. Code {code} asks to sign in to your account.
#. Approve dialog. Arguments: {code} = the 8-letter code, shown as is.
msgid "signin.approve.askBody"
msgstr "Le code {code} demande à se connecter à votre compte."

#. Where
#. Approve dialog: the request's coarse place, as a row label.
msgid "signin.approve.where"
msgstr "Lieu"

#. When
#. Approve dialog: when it asked, as a row label.
msgid "signin.approve.when"
msgstr "Quand"

#. Device
#. Approve dialog: the asking device, as a row label.
msgid "signin.approve.device"
msgstr "Appareil"

#. Unknown place
#. Approve dialog: no coarse location was available.
msgid "signin.approve.unknownPlace"
msgstr "Lieu inconnu"

#. It's asking from a different place than you're in now, or from a place we can't tell.
#. Approve dialog: why the person must confirm it's them first.
msgid "signin.approve.stepUpWhy"
msgstr "La demande provient d’un autre lieu que le vôtre, ou d’un lieu inconnu."

#. approve it
#. Approve dialog: completes 'Use your passkey to …' in the confirm-it's-you prompt.
msgid "signin.approve.stepUpVerb"
msgstr "l’approuver"

#. Approved. {device} is signed in.
#. Approve dialog outcome. Arguments: {device} = the device label.
msgid "signin.approve.approved"
msgstr "Approuvé. {device} est connecté."

#. Denied. Nothing changed.
#. Approve dialog outcome.
msgid "signin.approve.deniedDone"
msgstr "Refusé. Rien n’a changé."

#. That didn't go through. Try again.
#. Approve dialog: a decision that failed.
msgid "signin.approve.failed"
msgstr "Cela n’a pas abouti. Réessayez."

#. Your passkey wasn't used. Try again, or use another way.
#. Passkey prompt closed or timed out.
msgid "signin.passkey.cancelled"
msgstr "Votre clé d’accès n’a pas été utilisée. Réessayez ou utilisez une autre méthode."

#. This browser can't use your passkey here. Use another way.
#. Passkey not usable in this browser.
msgid "signin.passkey.unsupported"
msgstr "Ce navigateur ne peut pas utiliser votre clé d’accès ici. Utilisez une autre méthode."

#. Your passkey didn't work. Try again, or use another way.
#. Passkey refused.
msgid "signin.passkey.failed"
msgstr "Votre clé d’accès n’a pas fonctionné. Réessayez ou utilisez une autre méthode."

#. Signed in with {provider}
#. Finish step strip when the provider shared no identity to show. Arguments: {provider} = a provider's name.
msgid "signin.gate.stripNoIdentity"
msgstr "Connecté avec {provider}"

#. One more step
#. Finish step title when only the terms are asked.
msgid "signin.gate.termsTitle"
msgstr "Encore une étape"

#. Screen name
#. Finish step: the screen name field.
msgid "signin.gate.name"
msgstr "Nom d’affichage"

#. Use {email}
#. Finish step: the provider's address as a radio. Arguments: {email} = an address.
msgid "signin.gate.useEmail"
msgstr "Utiliser {email}"

#. Your private Apple address
#. Finish step: marks an Apple private-relay address.
msgid "signin.gate.relay"
msgstr "Votre adresse privée Apple"

#. Use my initials
#. Finish step: swaps the provider's picture for initials.
msgid "signin.gate.pictureInitials"
msgstr "Utiliser mes initiales"

#. macos: Use My Initials
msgctxt "macos"
msgid "signin.gate.pictureInitials"
msgstr "Utiliser mes initiales"

#. Use my {provider} picture
#. Finish step: back to the provider's picture. Arguments: {provider} = a provider's name.
msgid "signin.gate.pictureProvider"
msgstr "Utiliser ma photo {provider}"

#. macos: Use My {provider} Picture
msgctxt "macos"
msgid "signin.gate.pictureProvider"
msgstr "Utiliser ma photo {provider}"

#. Add my birth date from {org}
#. Finish step: only when a connection offered a birth date. Arguments: {org} = the organization that offered it.
msgid "signin.gate.birthdate"
msgstr "Ajouter ma date de naissance depuis {org}"

#. Only you can see it. Apps never get it.
#. Finish step: under the birth date choice.
msgid "signin.gate.birthdateHelp"
msgstr "Elle n’est visible que par vous. Les apps ne la reçoivent jamais."

#. I agree to the {term}
#. Finish step: the product's terms checkbox. Arguments: {product} = the product's name.
msgid "signin.gate.productTerms"
msgstr "J’accepte les {term}"

#. I agree to {term}
#. Finish step: the platform's terms line, with the link below it. Polaris Locker is never translated.
msgid "signin.gate.platformTerms"
msgstr "J’accepte {term}"

#. That sign-in has expired. Sign in again.
#. Finish step: the 15-minute sign-in ran out.
msgid "signin.gate.expired"
msgstr "Cette connexion a expiré. Reconnectez-vous."

#. Join your accounts
#. Finish step: the join offer (SIGN-IN.md §3.5).
msgid "signin.gate.joinTitle"
msgstr "Fusionner vos comptes"

#. {email} already belongs to a Polaris Locker account. Join this sign-in to it, or use a different email.
#. Finish step: the join offer. Arguments: {email} = an address. Polaris Locker is never translated.
msgid "signin.gate.joinLede"
msgstr "{email} appartient déjà à un compte Polaris Locker. Associez cette connexion à ce compte, ou utilisez une autre adresse e-mail."

#. To join, sign in to that account in this browser first, then add this sign-in from Account.
#. Finish step: the join offer cannot be taken until the other account is proven.
msgid "signin.gate.joinProve"
msgstr "Pour les fusionner, connectez-vous d’abord à ce compte dans ce navigateur, puis ajoutez cette connexion depuis Compte."

#. We sent a code to {email}.
#. Finish step, code stage. Arguments: {email} = an address.
msgid "signin.gate.codeSent"
msgstr "Nous avons envoyé un code à {email}."

#. On this browser, last time {when}
#. HintStep under the usual method. Arguments: {when} = a relative time such as '2 days ago'.
msgid "signin.hint.when"
msgstr "Dernière connexion sur ce navigateur : {when}"

#. Welcome back
#. HintStep title when the browser kept no name.
msgid "signin.hint.welcomeNoName"
msgstr "Bon retour"

#. a passkey
#. HintStep: completes 'You usually sign in with {method}'.
msgid "signin.hint.method.passkey"
msgstr "une clé d’accès"

#. an email code
#. HintStep: completes 'You usually sign in with {method}'.
msgid "signin.hint.method.email"
msgstr "un code par e-mail"

#. Use a passkey
#. HintStep: passkey button.
msgid "signin.hint.usePasskey"
msgstr "Utiliser une clé d’accès"

#. macos: Use a Passkey
msgctxt "macos"
msgid "signin.hint.usePasskey"
msgstr "Utiliser une clé d’accès"

#. Email me a code
#. HintStep: sends a sign-in code.
msgid "signin.hint.emailCode"
msgstr "M’envoyer un code par e-mail"

#. macos: Email Me a Code
msgctxt "macos"
msgid "signin.hint.emailCode"
msgstr "M’envoyer un code par e-mail"

#. Change
#. HintStep: back to the email field.
msgid "signin.hint.change"
msgstr "Modifier"

#. Sign in to add {product}
#. Sign-in card when a license key is carried through sign-in. Arguments: {product} = the product's name.
msgid "signin.key.carriedTitle"
msgstr "Connectez-vous pour ajouter {product}"

#. Your key is ready. Sign in or create an account, and {product} joins your library.
#. Sign-in card when a license key is carried. Arguments: {product} = the product's name.
msgid "signin.key.carriedLede"
msgstr "Votre clé est prête. Connectez-vous ou créez un compte, et {product} rejoindra votre bibliothèque."

#. Sign in without the key
#. Sign-in card: drops the carried license key.
msgid "signin.key.withoutKey"
msgstr "Se connecter sans la clé"

#. macos: Sign In Without the Key
msgctxt "macos"
msgid "signin.key.withoutKey"
msgstr "Se connecter sans la clé"

#. Paste the key from your receipt email. Sign in next, and it joins your library.
#. Have a license key? step, under the title.
msgid "signin.key.onrampLede"
msgstr "Collez la clé de votre reçu par e-mail. Connectez-vous ensuite pour l’ajouter à votre bibliothèque."

#. That sign-in has expired. Continue to get a new code.
#. Sign-in card, back at the email step after the sign-in ran out.
msgid "signin.code.expiredRestart"
msgstr "Cette connexion a expiré. Continuez pour recevoir un nouveau code."

#. That took too long. Continue to start again.
#. Sign-in card, back at the email step when the single sign-on step ran out before any code was sent.
msgid "signin.sso.expiredRestart"
msgstr "Cela a pris trop de temps. Continuez pour recommencer."

#. No more codes can be sent for this sign-in. The latest code still works.
#. Code step: the per-sign-in resend cap.
msgid "signin.code.noMore"
msgstr "Aucun autre code ne peut être envoyé pour cette connexion. Le dernier code fonctionne toujours."

#. Sign in with {org}
#. Sign-in card, a domain routed to its connection. Arguments: {org} = the organization's name.
msgid "signin.sso.title"
msgstr "Se connecter avec {org}"

#. Required for {host} addresses.
#. Sign-in card, an enforced connection. Arguments: {host} = the email domain.
msgid "signin.sso.required"
msgstr "Obligatoire pour les adresses {host}."

#. Email me a code in {time}
#. Sign-in card, the resend countdown on a routed step. Arguments: {time} = the wait, such as 0:42.
msgid "signin.sso.codeIn"
msgstr "M’envoyer un code par e-mail dans {time}"

#. macos: Email Me a Code in {time}
msgctxt "macos"
msgid "signin.sso.codeIn"
msgstr "M’envoyer un code par e-mail dans {time}"

#. Email me a code instead
#. Sign-in card, a routed step that is not enforced.
msgid "signin.sso.code"
msgstr "M’envoyer plutôt un code par e-mail"

#. macos: Email Me a Code Instead
msgctxt "macos"
msgid "signin.sso.code"
msgstr "M’envoyer plutôt un code par e-mail"

#. This account can't sign in
#. Sign-in card: a right code for an account that can't sign in (SIGN-IN.md §3.4).
msgid "signin.refused.title"
msgstr "Ce compte ne peut pas se connecter"

#. {email} belongs to an account that can't sign in. Try a different email or another way to sign in.
#. Sign-in card, account disabled. Arguments: {email} = an address.
msgid "signin.refused.lede"
msgstr "{email} appartient à un compte qui ne peut pas se connecter. Essayez une autre adresse e-mail ou une autre méthode."

#. Sign-in is turned off
#. Sign-in card: no way to sign in is enabled.
msgid "signin.off.title"
msgstr "La connexion est désactivée"

#. The security check did not pass. Try again.
#. Sign-in card: the bot check refused.
msgid "signin.turnstile.failed"
msgstr "La vérification de sécurité a échoué. Réessayez."

#. Too many tries. Wait a minute, then try again.
#. Code step: the verify's 429.
msgid "signin.code.rateLimited"
msgstr "Trop de tentatives. Attendez une minute, puis réessayez."

#. {product} terms
#. The product's terms link in the finish step; fills {term} in the terms sentence. Arguments: {product} = the product's name.
msgid "signin.gate.termsLinkProduct"
msgstr "conditions de {product}"

#. Polaris Locker's Terms and Privacy Policy
#. The platform's terms link in the finish step. Polaris Locker is never translated.
msgid "signin.gate.termsLinkPlatform"
msgstr "les Conditions et la Politique de confidentialité de Polaris Locker"

#. That code expired. Ask for a new one on the other device.
#. Approve dialog: the code is spent or expired (410).
msgid "signin.approve.expiredCode"
msgstr "Ce code a expiré. Demandez-en un nouveau sur l’autre appareil."

#. No sign-in is waiting for that code. Check it on the other device.
#. Approve dialog: no pending request has this code (404 or 422).
msgid "signin.approve.notFound"
msgstr "Aucune connexion n’attend ce code. Vérifiez-le sur l’autre appareil."

#. you@example.com
#. Placeholder of the email field on the sign-in card. Not translated.
msgid "signin.email.placeholder"
msgstr "vous@example.com"

#. single sign-on
#. Names the platform's single sign-on in 'Continue with {provider}' when it has no display name.
msgid "signin.sso.name"
msgstr "l’authentification unique"

#. its developer
#. Stands for {developer} when a product has no developer name, in 'Contact {developer}'.
msgid "signin.off.developer"
msgstr "son développeur"

#. Change email
#. Accessible name of the control that goes back to the email step.
msgid "signin.code.changeEmail"
msgstr "Modifier l’e-mail"

#. Wait {time}
#. Why a resend is disabled. Arguments: {time} = the wait, such as 0:42.
msgid "signin.sso.wait"
msgstr "Patientez {time}"

#. Key for {product}
#. Have a license key? step, under a valid key. Arguments: {product} = the product's name.
msgid "signin.key.keyFor"
msgstr "Clé pour {product}"

#. Starts with pkey_. Case-sensitive.
#. Have a license key? step: help under the field.
msgid "signin.key.help"
msgstr "Commence par pkey_. Sensible à la casse."

#. Paste your license key to continue.
#. Have a license key? step: Continue pressed with an empty field.
msgid "signin.key.empty"
msgstr "Collez votre clé de licence pour continuer."

#. Or connect another account
#. Group label of the provider buttons when adding a sign-in method.
msgid "signin.provider.connectGroup"
msgstr "Ou connecter un autre compte"

#. Too many codes. Try again in a few minutes.
#. Rate limit with no wait given.
msgid "signin.rateLimitedFew"
msgstr "Trop de codes. Réessayez dans quelques minutes."

#. Another Polaris Locker account uses this email. Sign in the way you did before.
#. Sign-in card, code step: the address belongs to another account that does not use it as a sign-in method. Polaris Locker is never translated.
msgid "signin.code.emailInUse"
msgstr "Un autre compte Polaris Locker utilise cette adresse e-mail. Connectez-vous comme la dernière fois."

#. Choose a license to continue.
#. PX-14a: the app card (SIGN-IN.md §3.6 to §3.9).
msgid "signin.choice.pickOne"
msgstr "Choisissez une licence pour continuer."

#. Choose a device to replace.
#. PX-14a: the app card (SIGN-IN.md §3.6 to §3.9).
msgid "signin.choice.pickDevice"
msgstr "Choisissez un appareil à remplacer."

#. Replace and sign in
#. PX-14a: the app card (SIGN-IN.md §3.6 to §3.9).
msgid "signin.choice.replaceAndSignIn"
msgstr "Remplacer et se connecter"

#. macos: Replace and Sign In
msgctxt "macos"
msgid "signin.choice.replaceAndSignIn"
msgstr "Remplacer et se connecter"

#. The device you choose signs out of {app}. It can sign in again later if there's room. We'll email you about it.
#. PX-14a: the app card (SIGN-IN.md §3.6 to §3.9). Arguments: {app} = the requesting app's name (never translated).
msgid "signin.choice.replaceSafety"
msgstr "L’appareil choisi sera déconnecté de {app}. Il pourra se reconnecter plus tard s’il y a de la place. Nous vous préviendrons par e-mail."

#. Device replaced
#. PX-14a: the app card (SIGN-IN.md §3.6 to §3.9).
msgid "signin.choice.replacedTitle"
msgstr "Appareil remplacé"

#. {device} signed out of {app}. {thisDevice} is signed in.
