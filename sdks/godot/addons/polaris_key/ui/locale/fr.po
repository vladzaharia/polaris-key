#. Lifetime
#. A license's term, shown in license rows (SIGN-IN.md §3.6).
msgid "signin.term.lifetime"
msgstr "À vie"

#. Until {date}
#. A license's term, shown in license rows (SIGN-IN.md §3.6). Arguments: {date} = a date already formatted by the platform.
msgid "signin.term.until"
msgstr "Jusqu’au {date}"

