#. A license's term, shown in license rows (SIGN-IN.md §3.6). Arguments: {date} = a date already formatted by the platform.
msgid "signin.term.yearlyUntil"
msgstr "Annuelle, jusqu’au {date}"

#. Sign-in
#. Choose a license for this device (SIGN-IN.md §3.6). A license's origin in plain words on the meta line, "{origin} · {term}" (owner, 2026-10-05: no license-type label).
msgid "signin.choice.origin.signIn"
msgstr "Connexion"

#. Key ending {last6}
#. Choose a license for this device (SIGN-IN.md §3.6). A license's origin in plain words on the meta line, "{origin} · {term}" (owner, 2026-10-05: no license-type label). Arguments: {last6} = the license key's last six characters, shown as is.
msgid "signin.choice.origin.key"
msgstr "Clé se terminant par {last6}"

#. Added with a key
#. Choose a license for this device (SIGN-IN.md §3.6). A license's origin in plain words on the meta line, "{origin} · {term}" (owner, 2026-10-05: no license-type label).
msgid "signin.choice.origin.keyAdded"
msgstr "Ajoutée avec une clé"

#. {store} key ending {last6}
#. Choose a license for this device (SIGN-IN.md §3.6). A license's origin in plain words on the meta line, "{origin} · {term}" (owner, 2026-10-05: no license-type label). Arguments: {store} = a store's name (Steam, App Store); {last6} = the license key's last six characters, shown as is.
msgid "signin.choice.origin.storeKey"
msgstr "Clé {store} se terminant par {last6}"

#. {store} key
#. Choose a license for this device (SIGN-IN.md §3.6). A license's origin in plain words on the meta line, "{origin} · {term}" (owner, 2026-10-05: no license-type label). Arguments: {store} = a store's name (Steam, App Store).
msgid "signin.choice.origin.storeKeyAdded"
msgstr "Clé {store}"

#. From {store}
#. Choose a license for this device (SIGN-IN.md §3.6). A license's origin in plain words on the meta line, "{origin} · {term}" (owner, 2026-10-05: no license-type label). A store license with no key. Arguments: {store} = a store's name (Steam, App Store).
msgid "signin.choice.origin.store"
msgstr "Via {store}"

#. From {developer}
#. Choose a license for this device (SIGN-IN.md §3.6). A license's origin in plain words on the meta line, "{origin} · {term}" (owner, 2026-10-05: no license-type label). Arguments: {developer} = the developer's name (never translated).
msgid "signin.choice.origin.developer"
msgstr "Fournie par {developer}"

#. Free
#. Choose a license for this device (SIGN-IN.md §3.6). A license's origin in plain words on the meta line, "{origin} · {term}" (owner, 2026-10-05: no license-type label).
msgid "signin.choice.origin.free"
msgstr "Gratuite"

#. Gift
#. Choose a license for this device (SIGN-IN.md §3.6). A license's origin in plain words on the meta line, "{origin} · {term}" (owner, 2026-10-05: no license-type label).
msgid "signin.choice.origin.gift"
msgstr "Cadeau"

#. Included with {org}
#. Choose a license for this device (SIGN-IN.md §3.6). A license's origin in plain words on the meta line, "{origin} · {term}" (owner, 2026-10-05: no license-type label). Arguments: {org} = the organization that provides the license.
msgid "signin.choice.origin.org"
msgstr "Incluse avec {org}"

#. {tier} · Sign-in
#. The license picker's short option: the tier, then the origin (owner, 2026-10-05). Arguments: {tier} = the tier's name (never translated).
msgid "signin.choice.picker.signIn"
msgstr "{tier} · Connexion"

#. {tier} · Key …{last6}
#. The license picker's short option: the tier, then the origin (owner, 2026-10-05). Arguments: {tier} = the tier's name (never translated); {last6} = the license key's last six characters, shown as is.
msgid "signin.choice.picker.key"
msgstr "{tier} · Clé …{last6}"

#. {tier} · {store} key …{last6}
#. The license picker's short option: the tier, then the origin (owner, 2026-10-05). Arguments: {tier} = the tier's name (never translated); {store} = a store's name (Steam, App Store); {last6} = the license key's last six characters, shown as is.
msgid "signin.choice.picker.storeKey"
msgstr "{tier} · Clé {store} …{last6}"

#. {tier} · {store}
#. The license picker's short option: the tier, then the origin (owner, 2026-10-05). Arguments: {tier} = the tier's name (never translated); {store} = a store's name (Steam, App Store).
msgid "signin.choice.picker.store"
msgstr "{tier} · {store}"

#. On this device
#. Choose a license for this device (SIGN-IN.md §3.6).
msgid "signin.choice.tag.current"
msgstr "Sur cet appareil"

#. New
#. Choose a license for this device (SIGN-IN.md §3.6).
msgid "signin.choice.tag.new"
