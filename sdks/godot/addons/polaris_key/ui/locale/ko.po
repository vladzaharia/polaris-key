msgid "signin.header.onDevice"
msgstr "{device}에서"

#. this browser
#. PX-14a: the app card (SIGN-IN.md §3.6 to §3.9).
msgid "signin.thisBrowser"
msgstr "이 브라우저"

#. Don't allow
#. PX-14a: the app card (SIGN-IN.md §3.6 to §3.9).
msgid "signin.consent.deny"
msgstr "허용 안 함"

#. macos: Don't Allow
msgctxt "macos"
msgid "signin.consent.deny"
msgstr "허용 안 함"

#. Cloud Sync
#. PX-14a: the app card (SIGN-IN.md §3.6 to §3.9).
msgid "signin.consent.cloudSync"
msgstr "클라우드 동기화"

#. New: {tier} license, created when you continue
#. PX-14a: the app card (SIGN-IN.md §3.6 to §3.9). Arguments: {tier} = the tier's name (never translated).
msgid "signin.consent.newLicense"
msgstr "새 {tier} 라이선스: 계속하면 생성돼요"

#. Keep {product} in an account
#. PX-14a: the app card (SIGN-IN.md §3.6 to §3.9). Arguments: {product} = the product's name from ProductIdentity (never translated).
msgid "signin.key.upgradeTitle"
msgstr "{product}을(를) 계정에 보관"

