msgstr "기기 교체"

#. macos: Replace a Device
msgctxt "macos"
msgid "signin.deviceLimit.replace"
msgstr "기기 교체"

#. Replace a device
#. Replace a device, inline in the license choice (SIGN-IN.md §3.7).
msgid "signin.replace.open"
msgstr "기기 교체"

#. macos: Replace a Device
msgctxt "macos"
msgid "signin.replace.open"
msgstr "기기 교체"

