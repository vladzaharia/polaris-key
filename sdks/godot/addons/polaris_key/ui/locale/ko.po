#. Confirmed by {provider}
#. Finish step: beside the Email label when a provider vouches for the address. Arguments: {provider}.
msgid "signin.gate.confirmedBy"
msgstr "{provider}에서 확인됨"

#. Confirmed by code
#. Finish step: beside the Email label when a sign-in code proved the address.
msgid "signin.gate.confirmedByCode"
msgstr "코드로 확인됨"

#. Use a name from
#. Finish step: label above the screen-name suggestion chips.
msgid "signin.gate.nameFrom"
msgstr "다음에서 이름 사용"

#. Shown in Polaris Locker and in emails.
#. Finish step: under the screen name. Polaris Locker is never translated.
msgid "signin.gate.nameHint"
msgstr "Polaris Locker와 이메일에 표시돼요."

#. Picture
#. Finish step: the picture group label.
msgid "signin.gate.picture"
msgstr "사진"

#. Initials
#. Finish step: the initials picture tile.
msgid "signin.gate.pictureInitialsTile"
msgstr "이니셜"

#. From your name
#. Finish step: under the initials tile.
msgid "signin.gate.pictureFromName"
msgstr "이름에서 만들기"

#. Upload
#. Finish step: the upload picture tile.
msgid "signin.gate.pictureUpload"
msgstr "업로드"

#. PNG or JPEG
#. Finish step: under the upload tile; the accepted file types.
msgid "signin.gate.pictureUploadHint"
msgstr "PNG 또는 JPEG"

#. In use
#. Finish step: under the picture tile in use.
msgid "signin.gate.pictureInUse"
msgstr "사용 중"

