msgstr "5 MB 이하의 PNG 또는 JPEG를 선택하세요."

#. Add a passkey
#. Finish: the step after the account exists, offering one passkey.
msgid "signin.gate.passkeyTitle"
msgstr "패스키 추가"

#. Next time is one tap.
#. Finish: under the passkey step title.
msgid "signin.gate.passkeyLede"
msgstr "다음부터는 한 번만 탭하면 돼요."

#. Add a passkey
#. Finish: the one-tap button that opens the browser passkey prompt.
msgid "signin.gate.passkeyAdd"
msgstr "패스키 추가"

#. macos: Add a Passkey
msgctxt "macos"
msgid "signin.gate.passkeyAdd"
msgstr "패스키 추가"

#. Passkey added.
#. Finish: passkey outcome, success.
msgid "signin.gate.passkeyAdded"
msgstr "패스키를 추가했어요."

#. No passkey was added. You can add one in Account.
#. Finish: passkey outcome, none added.
msgid "signin.gate.passkeyFailed"
msgstr "패스키가 추가되지 않았어요. 계정에서 추가할 수 있어요."

#. Skip
#. Finish: leaves the passkey step.
msgid "signin.gate.passkeySkip"
msgstr "건너뛰기"

#. Your upload
#. Finish: the tile of a picture the person picked from their device.
msgid "signin.gate.pictureYours"
msgstr "내 업로드"

#. Your picture wasn't saved. Add one in Account.
#. Finish: shown on arrival when the picked picture could not be saved.
msgid "signin.gate.uploadFailed"
msgstr "사진이 저장되지 않았어요. 계정에서 추가하세요."

#. We sent a new code to {email}.
#. Finish: the code stage after a resend. Arguments: {email}.
msgid "signin.gate.resent"
msgstr "새 코드를 {email}(으)로 보냈어요."

#. {email} already belongs to a Polaris Locker account. Use a different email, or sign in to that account first.
#. Finish: the join offer when the other account is not yet proven. Arguments: {email}.
msgid "signin.gate.joinOtherLede"
msgstr "{email}은(는) 이미 Polaris Locker 계정에 속해 있어요. 다른 이메일을 사용하거나 먼저 그 계정에 로그인하세요."

#. Enter a screen name.
#. Finish: the screen name field left empty.
msgid "signin.gate.nameRequired"
msgstr "표시 이름을 입력하세요."

#. Agree to {app}'s terms to keep going.
#. Finish: lede of the terms-only step. Arguments: {app}.
msgid "signin.gate.termsLede"
msgstr "계속하려면 {app} 약관에 동의하세요."

#. Enter all 6 digits.
#. Code entry: submitted with fewer than six digits.
msgid "signin.code.incomplete"
msgstr "6자리를 모두 입력하세요."

#. Add another way to sign in
#. Portal, next visit after a first platform sign-in: the Add another way to sign in nudge (SIGN-IN.md D-40).
msgid "signin.nudge.title"
msgstr "다른 로그인 방법 추가"

#. So you can always get back in.
#. Nudge body.
msgid "signin.nudge.body"
msgstr "언제든 다시 로그인할 수 있도록요."

#. Add a way
#. Nudge primary: opens Account → Sign-in methods.
msgid "signin.nudge.add"
msgstr "추가"

#. macos: Add a Way
msgctxt "macos"
msgid "signin.nudge.add"
msgstr "추가"

#. Not now
#. Nudge dismiss.
msgid "signin.nudge.later"
msgstr "나중에"

#. macos: Not Now
msgctxt "macos"
msgid "signin.nudge.later"
msgstr "나중에"

#. Link an existing account
#. Account → Link an existing account dialog (PORTAL.md §4.11).
msgid "signin.join.title"
msgstr "기존 계정 연결"

#. Sign in to your other account to join the two. Nothing moves until you confirm.
#. Link dialog, before the second sign-in.
msgid "signin.join.lede"
msgstr "다른 계정에 로그인해 두 계정을 합치세요. 확인하기 전에는 아무것도 옮겨지지 않아요."

#. Sign in to the other account
#. Link dialog primary: starts the second sign-in.
msgid "signin.join.start"
msgstr "다른 계정에 로그인"

#. macos: Sign In to the Other Account
msgctxt "macos"
msgid "signin.join.start"
msgstr "다른 계정에 로그인"

#. This account
#. Link dialog: the account the person started from.
msgid "signin.join.thisAccount"
msgstr "이 계정"

#. Other account
#. Link dialog: the account signed in second.
msgid "signin.join.otherAccount"
msgstr "다른 계정"

#. {count, plural, one {# product} other {# products}}
#. Link dialog: products on one account.
#. Plural on {count}.
msgid "signin.join.products"
msgid_plural "signin.join.products"
msgstr[0] "제품 {count}개"

#. One library: {count, plural, one {# product} other {# products}}. {email} stays the main email.
#. Link dialog: what joining leaves.
#. Plural on {count}.
msgid "signin.join.result"
msgid_plural "signin.join.result"
msgstr[0] "라이브러리 하나: 제품 {count}개. 기본 이메일은 {email}(으)로 유지돼요."

#. Joined. You can undo this for 72 hours.
#. Link dialog: joined.
msgid "signin.join.done"
msgstr "합쳤어요. 72시간 동안 되돌릴 수 있어요."

#. Undo join
#. Link dialog: undo a join.
msgid "signin.join.undo"
msgstr "합치기 되돌리기"

#. macos: Undo Join
msgctxt "macos"
msgid "signin.join.undo"
msgstr "합치기 되돌리기"

#. Join undone.
#. Link dialog: join undone.
msgid "signin.join.undone"
msgstr "합치기를 되돌렸어요."

#. Joined {email}. Undo until {date}.
#. Link dialog: a join that can still be undone.
msgid "signin.join.undoable"
msgstr "{email} 합침. {date}까지 되돌릴 수 있어요."

