    {
      "channel": "my-channel",
      "arch": "a b&c=d/é~*-._",
      "expect": "https://key.plrs.im/diceroll/update/my-channel/appcast.xml?arch=a+b%26c%3Dd%2F%C3%A9%7E*-._"
    }
