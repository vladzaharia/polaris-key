    {
      "note": "An appcast leaked onto a disabled fragment: the flag decides.",
      "update": {
        "enabled": false,
        "endpoints": {
          "appcast": "https://key.plrs.im/diceroll/update/appcast.xml"
        }
      },
      "expect": null
