extends RefCounted
# PKeyNfc against tests/fixtures/nfc_cases.json (generated by `pnpm gen godot-nfc`: every code point
# with a decomposition or a combining class, the Hangul edges and 2,000 seeded mixtures, expected
# outputs from the TypeScript reference that is cross-checked against Node's NFC), plus the bounded
# cost of PKeyDeviceLabel.clean_hello on long labels. Timings are INFO only.

const FIXTURE := "res://tests/fixtures/nfc_cases.json"
const FLOOR := 4000


static func _cps(hex: String) -> String:
	var s := ""
	for h in hex.split(" ", false):
		s += String.chr(h.hex_to_int())
	return s


func run(t: PKeyTestContext, _args: PackedStringArray) -> bool:
	var j := JSON.new()
	var err := j.parse(FileAccess.get_file_as_string(FIXTURE))
	if not t.check("fixture parses", err == OK and j.data is Dictionary and j.data.get("rows") is Array, FIXTURE):
		return true
	var rows: Array = j.data["rows"]
	t.check("fixture is for Unicode 16.0", PKeyNfcData.UNICODE_VERSION.begins_with("16.0") and j.data.get("unicodeVersion") == PKeyNfcData.UNICODE_VERSION)
	t.check("fixture floor", rows.size() >= FLOOR, "%d rows, floor %d" % [rows.size(), FLOOR])
	var bad := 0
	var first_bad := ""
	var t0 := Time.get_ticks_usec()
	var chars := 0
	for r in rows:
		var input := _cps(r[0])
		var want := _cps(r[1])
		chars += input.length()
		var got := PKeyNfc.nfc(input)
		if got != want:
			bad += 1
			if first_bad == "":
				first_bad = "%s -> %s, want %s" % [r[0], got.to_utf32_buffer().hex_encode(), r[1]]
	var dt := (Time.get_ticks_usec() - t0) / 1000.0
	t.check("nfc over every fixture row", bad == 0, "%d of %d differ; first: %s" % [bad, rows.size(), first_bad])
	t.info("nfc: %d rows, %d input code points in %.1f ms (%.0f code points/s)" % [rows.size(), chars, dt, chars / maxf(dt / 1000.0, 0.000001)])
	# Idempotence (NFC is a fixed point of itself) over every expected output.
	var unstable := 0
	for r in rows:
		var want := _cps(r[1])
		if PKeyNfc.nfc(want) != want:
			unstable += 1
	t.check("nfc is idempotent over every expected output", unstable == 0, "%d unstable" % unstable)
	_hello(t)
	return true


func _hello(t: PKeyTestContext) -> void:
	t.check("clean_hello: composes and collapses", PKeyDeviceLabel.clean_hello("  Zoë   Mac ") == "Zoë Mac")
	t.check("clean_hello: strips then composes", PKeyDeviceLabel.clean_hello("e​́") == "é")
	t.check("clean_hello: empty", PKeyDeviceLabel.clean_hello("​ ⠀") == "")
	# The cut counts code points after NFC: 70 decomposed letters compose to 70, then 64 stay.
	var decomposed := "ä".repeat(70)
	t.check("clean_hello: cut after NFC", PKeyDeviceLabel.clean_hello(decomposed) == "ä".repeat(64))
	for n in [4096, 1048576]:
		var variants := {
			"plain": "a".repeat(n),
			"marks": "e" + "̣́̀".repeat(n / 3),
			"deleted": "​".repeat(n),
			"decomposed": "é".repeat(n / 2),
			"hangul": "한".repeat(n / 3),
		}
		for k in variants:
			var t0 := Time.get_ticks_usec()
			var out := PKeyDeviceLabel.clean_hello(variants[k])
			var dt := (Time.get_ticks_usec() - t0) / 1000.0
			t.check("clean_hello %s %d bounded" % [k, n], out.length() <= PKeyConstants.DEVICE_LABEL_MAX_CODEPOINTS)
			t.info("clean_hello %s, %d code points in: %.1f ms" % [k, n, dt])
