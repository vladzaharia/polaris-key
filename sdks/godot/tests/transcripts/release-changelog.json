{
  "transcriptVersion": 1,
  "id": "release-changelog",
  "description": "The Release client (D-05): the changelog, the install URL and the download URL, for a client holding no device token. changelog() is a plain GET returning the Worker's entries verbatim (a null summary stays null); installUrl() and downloadUrl() BUILD their URLs without a request. When the operator then moves the product's release metadata to the entitled access mode (D-13), the unauthenticated changelog read is refused 401, and the SDK raises the refusal body's own code.",
  "features": ["release.changelog", "release.download"],
  "requires": [],
  "product": "djdl",
  "baseUrl": "https://key.plrs.im",
  "now": 1700000000,
  "trust": {
    "pkey-test-prod-2026": "kDJF6Deuexo91hFZ9TAPr2SmjUEuTXdia67UogTEpkI"
  },
  "initial": {
    "deviceId": "TRANSCRIPTDEVICE0000000000000001",
    "version": "1.0.0",
    "services": ["license", "config", "release"]
  },
  "steps": [
    {
      "action": "changelog",
      "args": {},
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "GET",
              "path": "/djdl/release/changelog",
              "headers": {},
              "requiredHeaders": [],
              "body": null
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "public, max-age=300",
                "content-type": "application/json"
              },
              "body": {
                "entries": [
                  {
                    "version": "1.2.0",
                    "tag": "v1.2.0",
                    "date": "2023-11-10T00:00:00Z",
                    "summary": "Faster sync.",
                    "url": "https://github.com/acme/djdl/releases/tag/v1.2.0"
                  },
                  {
                    "version": "1.1.0",
                    "tag": "v1.1.0",
                    "date": "2023-11-01T00:00:00Z",
                    "summary": null,
                    "url": "https://github.com/acme/djdl/releases/tag/v1.1.0"
                  }
                ]
              }
            }
          }
        ]
      },
      "expect": {
        "result": "ok",
        "entries": [
          {
            "version": "1.2.0",
            "tag": "v1.2.0",
            "date": "2023-11-10T00:00:00Z",
            "summary": "Faster sync.",
            "url": "https://github.com/acme/djdl/releases/tag/v1.2.0"
          },
          {
            "version": "1.1.0",
            "tag": "v1.1.0",
            "date": "2023-11-01T00:00:00Z",
            "summary": null,
            "url": "https://github.com/acme/djdl/releases/tag/v1.1.0"
          }
        ]
      }
    },
    {
      "action": "installUrl",
      "note": "Built, not fetched: no request.",
      "args": {},
      "exchanges": { "ordered": false, "items": [] },
      "expect": { "url": "https://key.plrs.im/djdl/release/install.sh" }
    },
    {
      "action": "downloadUrl",
      "note": "Built, not fetched: no request. The Worker serves the sidecar's digest there.",
      "args": {
        "version": "1.2.0",
        "binary": "djdl",
        "arch": "arm64",
        "checksum": true
      },
      "exchanges": { "ordered": false, "items": [] },
      "expect": {
        "url": "https://key.plrs.im/djdl/release/dl/1.2.0/djdl-arm64?checksum=sha256"
      }
    },
    {
      "action": "changelog",
      "note": "Release metadata is now entitled: no token is a 401, surfaced by its code.",
      "args": {},
      "now": 1700000060,
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "GET",
              "path": "/djdl/release/changelog",
              "headers": {},
              "requiredHeaders": [],
              "body": null
            },
            "response": {
              "status": 401,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "error": { "code": "unauthorized" } }
            }
          }
        ]
      },
      "expect": { "result": "error", "code": "unauthorized" }
    }
  ]
}
