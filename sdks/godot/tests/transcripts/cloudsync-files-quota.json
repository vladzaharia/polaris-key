{
  "transcriptVersion": 1,
  "id": "cloudsync-files-quota",
  "description": "Quota (§13.1, GF1): a licence granting 10,000 bytes of Cloud Sync storage refuses a begin whose size does not fit with 403 quota_exceeded and the scope; a file that fits is accepted, and a second one that no longer fits is refused again (the first one's bytes count once it is committed).",
  "features": ["sync.files"],
  "requires": ["core.store"],
  "product": "djdl",
  "baseUrl": "https://key.plrs.im",
  "now": 1700000000,
  "trust": {
    "pkey-test-prod-2026": "kDJF6Deuexo91hFZ9TAPr2SmjUEuTXdia67UogTEpkI"
  },
  "initial": {
    "deviceId": "TRANSCRIPTDEVICE0000000000000001",
    "token": "pkeyt_8h1CclOmP_lI5c56ar8fRyo4GprQ3RB-eQoMSpapxBE",
    "version": "1.0.0"
  },
  "steps": [
    {
      "action": "cloudSyncFile",
      "note": "20,000 bytes against a 10,000 byte allowance.",
      "args": {
        "op": "begin",
        "collection": "docs",
        "id": "q1",
        "size": 20000
      },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/sync/files/docs/q1/begin",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": {
                  "size": 20000,
                  "sha256": "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd",
                  "format": "whole",
                  "enc": "none"
                },
                "match": "exact"
              }
            },
            "response": {
              "status": 403,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "error": { "code": "quota_exceeded" }, "scope": "user" }
            }
          }
        ]
      },
      "expect": { "result": "refused", "status": 403, "code": "quota_exceeded" }
    },
    {
      "action": "cloudSyncFile",
      "note": "Open a session.",
      "args": { "op": "begin", "collection": "docs", "id": "q1", "size": 6000 },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/sync/files/docs/q1/begin",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": {
                  "size": 6000,
                  "sha256": "36999de9c7aebde858fa19a0741afe2b808b98e79294a9b01c67df1242e40a5b",
                  "format": "whole",
                  "enc": "none"
                },
                "match": "exact"
              }
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": {
                "uploadId": "up_jVOKzfHL2qnRvpKRi0NqYw",
                "mode": "single",
                "expiresAt": 1700086400000
              }
            },
            "capture": { "uploadId": "$.uploadId" }
          }
        ]
      },
      "expect": { "result": "ok", "status": 200, "mode": "single" }
    },
    {
      "action": "cloudSyncFile",
      "note": "Send the bytes.",
      "args": { "op": "put", "collection": "docs", "id": "q1", "size": 6000 },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "PUT",
              "path": "/djdl/sync/files/docs/q1/upload/up_jVOKzfHL2qnRvpKRi0NqYw",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}",
                "content-digest": "sha-256=:Npmd6ceuvehY+hmgdBr+K4CLmOeSlKmwHGffEkLkCls=:",
                "content-type": "application/octet-stream"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": null,
              "bodyBase64": ""
            },
            "response": {
              "status": 204,
              "headers": { "cache-control": "no-store" },
              "body": ""
            }
          }
        ]
      },
      "expect": { "result": "ok", "status": 204 }
    },
    {
      "action": "cloudSyncFile",
      "note": "Commit it.",
      "args": { "op": "finalize", "collection": "docs", "id": "q1" },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/sync/files/docs/q1/finalize",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": { "uploadId": "up_jVOKzfHL2qnRvpKRi0NqYw" },
                "match": "exact"
              }
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": {
                "version": 1,
                "size": 6000,
                "sha256": "36999de9c7aebde858fa19a0741afe2b808b98e79294a9b01c67df1242e40a5b",
                "format": "whole"
              }
            }
          }
        ]
      },
      "expect": {
        "result": "ok",
        "status": 200,
        "version": 1,
        "size": 6000,
        "sha256": "36999de9c7aebde858fa19a0741afe2b808b98e79294a9b01c67df1242e40a5b"
      }
    },
    {
      "action": "cloudSyncFile",
      "note": "6,000 more does not fit beside the committed 6,000.",
      "args": { "op": "begin", "collection": "docs", "id": "q2", "size": 6000 },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/sync/files/docs/q2/begin",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": {
                  "size": 6000,
                  "sha256": "efefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefef",
                  "format": "whole",
                  "enc": "none"
                },
                "match": "exact"
              }
            },
            "response": {
              "status": 403,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "error": { "code": "quota_exceeded" }, "scope": "user" }
            }
          }
        ]
      },
      "expect": { "result": "refused", "status": 403, "code": "quota_exceeded" }
    }
  ]
}
