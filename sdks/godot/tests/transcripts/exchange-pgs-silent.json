                  "status": "authorized",
                  "current": true,
                  "firstSeen": 1700000000,
                  "lastSeen": 1700000000,
                  "userAgent": null,
                  "platform": "linux",
                  "arch": "x86_64",
                  "appVersion": "1.0.0",
                  "sdkName": "pkey-transcript-recorder",
                  "sdkVersion": "1"
                },
                "license": null,
                "subject": "ps_B4rjiSeI2CbydOrRPTp87w",
                "issued_token_type": "urn:polaris-key:token-type:device"
              }
            }
          }
        ]
      },
      "expect": {
