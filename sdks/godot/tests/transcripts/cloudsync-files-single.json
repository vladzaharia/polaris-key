{
  "transcriptVersion": 1,
  "id": "cloudsync-files-single",
  "description": "A small file (§13.8.1): begin answers mode single, one PUT carries the bytes with their Content-Digest, the resume answer then lists part 1, finalize commits version 1 and the download returns the same bytes. Create-only (baseVersion \"*\"), the saves template.",
  "features": ["sync.files", "sync.saves"],
  "requires": ["core.store"],
  "product": "djdl",
  "baseUrl": "https://key.plrs.im",
  "now": 1700000000,
  "trust": {
    "pkey-test-prod-2026": "kDJF6Deuexo91hFZ9TAPr2SmjUEuTXdia67UogTEpkI"
  },
  "initial": {
    "deviceId": "TRANSCRIPTDEVICE0000000000000001",
    "token": "pkeyt_GbEr6EWAAc3LW-RiTKfp3ALlu2OOgeASY5qzQ1PVJYc",
    "version": "1.0.0"
  },
  "steps": [
    {
      "action": "cloudSyncFile",
      "note": "Create-only: no such file.",
      "args": {
        "op": "begin",
        "collection": "saves",
        "id": "slot1",
        "size": 5000
      },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/sync/files/saves/slot1/begin",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": {
                  "size": 5000,
                  "sha256": "1e92fd98f113aba0a78e0830ca06e2775912370feab112dfc57bf3258b810595",
                  "format": "whole",
                  "enc": "none",
                  "baseVersion": "*"
                },
                "match": "exact"
              }
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": {
                "uploadId": "up_lQgPfG6g1gRuaWosDXl5LQ",
                "mode": "single",
                "expiresAt": 1700086400000
              }
            },
            "capture": { "uploadId": "$.uploadId" }
          }
        ]
      },
      "expect": { "result": "ok", "status": 200, "mode": "single" }
    },
    {
      "action": "cloudSyncFile",
      "note": "One PUT of the whole file.",
      "args": {
        "op": "put",
        "collection": "saves",
        "id": "slot1",
        "size": 5000
      },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "PUT",
              "path": "/djdl/sync/files/saves/slot1/upload/up_lQgPfG6g1gRuaWosDXl5LQ",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}",
                "content-digest": "sha-256=:HpL9mPETq6Cnjggwygbid1kSNw/qsRLfxXvzJYuBBZU=:",
                "content-type": "application/octet-stream"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": null,
              "bodyBase64": ""
            },
            "response": {
              "status": 204,
              "headers": { "cache-control": "no-store" },
              "body": ""
            }
          }
        ]
      },
      "expect": { "result": "ok", "status": 204 }
    },
    {
      "action": "cloudSyncFile",
      "note": "Resume answer: part 1 received.",
      "args": { "op": "status", "collection": "saves", "id": "slot1" },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "GET",
              "path": "/djdl/sync/files/saves/slot1/upload/up_lQgPfG6g1gRuaWosDXl5LQ",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch"
              ],
              "body": null
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": {
                "mode": "single",
                "size": 5000,
                "received": [1],
                "expiresAt": 1700086400000
              }
            }
          }
        ]
      },
      "expect": {
        "result": "ok",
        "status": 200,
        "mode": "single",
        "size": 5000,
        "received": [1]
      }
    },
    {
      "action": "cloudSyncFile",
      "note": "Commit.",
      "args": { "op": "finalize", "collection": "saves", "id": "slot1" },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/sync/files/saves/slot1/finalize",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": { "uploadId": "up_lQgPfG6g1gRuaWosDXl5LQ" },
                "match": "exact"
              }
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": {
                "version": 1,
                "size": 5000,
                "sha256": "1e92fd98f113aba0a78e0830ca06e2775912370feab112dfc57bf3258b810595",
                "format": "whole"
              }
            }
          }
        ]
      },
      "expect": {
        "result": "ok",
        "status": 200,
        "version": 1,
        "size": 5000,
        "sha256": "1e92fd98f113aba0a78e0830ca06e2775912370feab112dfc57bf3258b810595"
      }
    },
    {
      "action": "cloudSyncFile",
      "note": "The stored bytes, byte for byte.",
      "args": { "op": "download", "collection": "saves", "id": "slot1" },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "GET",
              "path": "/djdl/sync/files/saves/slot1",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch"
              ],
              "body": null
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/octet-stream",
                "etag": "\"1e92fd98f113aba0a78e0830ca06e2775912370feab112dfc57bf3258b810595\""
              },
              "body": "",
              "bodyBase64": ""
            }
          }
        ]
      },
      "expect": {
        "result": "ok",
        "status": 200,
        "size": 5000,
        "sha256": "1e92fd98f113aba0a78e0830ca06e2775912370feab112dfc57bf3258b810595"
      }
    }
  ]
}
