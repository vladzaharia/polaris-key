{
  "transcriptVersion": 1,
  "id": "cloudsync-files-mismatch",
  "description": "Upload verification (§13.8.1, GF7): a Content-Digest other than the one begin declared answers 400 upload_mismatch before a byte is stored; bytes that do not hash to the declared value answer 400 upload_mismatch and store nothing; the session stays open, so the right bytes then go through and finalize commits.",
  "features": ["sync.files"],
  "requires": ["core.store"],
  "product": "djdl",
  "baseUrl": "https://key.plrs.im",
  "now": 1700000000,
  "trust": {
    "pkey-test-prod-2026": "kDJF6Deuexo91hFZ9TAPr2SmjUEuTXdia67UogTEpkI"
  },
  "initial": {
    "deviceId": "TRANSCRIPTDEVICE0000000000000001",
    "token": "pkeyt_MzLlgT2zCZZs1YwthNzJn36KwgvZAJkwrmUrSA-U_Xo",
    "version": "1.0.0"
  },
  "steps": [
    {
      "action": "cloudSyncFile",
      "note": "Declare the hash of the real bytes.",
      "args": { "op": "begin", "collection": "docs", "id": "d1", "size": 4000 },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/sync/files/docs/d1/begin",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": {
                  "size": 4000,
                  "sha256": "2e781e3762b7c315ce53c7e3645f59b2e4c037db30c6bec3a195e0751bd62722",
                  "format": "whole",
                  "enc": "none"
                },
                "match": "exact"
              }
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": {
                "uploadId": "up_8BwXQ94QcQ-SDhpTQFqmIg",
                "mode": "single",
                "expiresAt": 1700086400000
              }
            },
            "capture": { "uploadId": "$.uploadId" }
          }
        ]
      },
      "expect": { "result": "ok", "status": 200, "mode": "single" }
    },
    {
      "action": "cloudSyncFile",
      "note": "A digest header of other bytes.",
      "args": { "op": "put", "collection": "docs", "id": "d1", "size": 4000 },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "PUT",
              "path": "/djdl/sync/files/docs/d1/upload/up_8BwXQ94QcQ-SDhpTQFqmIg",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}",
                "content-digest": "sha-256=:N53QlizOi8faYxaWVqncnxKdf8pbT9n76YHrWhQK24g=:",
                "content-type": "application/octet-stream"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": null,
              "bodyBase64": ""
            },
            "response": {
              "status": 400,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "error": { "code": "upload_mismatch" } }
            }
          }
        ]
      },
      "expect": {
        "result": "refused",
        "status": 400,
        "code": "upload_mismatch"
      }
    },
    {
      "action": "cloudSyncFile",
      "note": "Other bytes under their own digest: they do not hash to the declared value.",
      "args": { "op": "put", "collection": "docs", "id": "d1", "size": 4000 },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "PUT",
              "path": "/djdl/sync/files/docs/d1/upload/up_8BwXQ94QcQ-SDhpTQFqmIg",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}",
                "content-digest": "sha-256=:N53QlizOi8faYxaWVqncnxKdf8pbT9n76YHrWhQK24g=:",
                "content-type": "application/octet-stream"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": null,
              "bodyBase64": ""
            },
            "response": {
              "status": 400,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "error": { "code": "upload_mismatch" } }
            }
          }
        ]
      },
      "expect": {
        "result": "refused",
        "status": 400,
        "code": "upload_mismatch"
      }
    },
    {
      "action": "cloudSyncFile",
      "note": "Nothing was recorded.",
      "args": { "op": "status", "collection": "docs", "id": "d1" },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "GET",
              "path": "/djdl/sync/files/docs/d1/upload/up_8BwXQ94QcQ-SDhpTQFqmIg",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch"
              ],
              "body": null
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": {
                "mode": "single",
                "size": 4000,
                "received": [],
                "expiresAt": 1700086400000
              }
            }
          }
        ]
      },
      "expect": {
        "result": "ok",
        "status": 200,
        "mode": "single",
        "size": 4000,
        "received": []
      }
    },
    {
      "action": "cloudSyncFile",
      "note": "The right bytes.",
      "args": { "op": "put", "collection": "docs", "id": "d1", "size": 4000 },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "PUT",
              "path": "/djdl/sync/files/docs/d1/upload/up_8BwXQ94QcQ-SDhpTQFqmIg",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}",
                "content-digest": "sha-256=:LngeN2K3wxXOU8fjZF9ZsuTAN9swxr7DoZXgdRvWJyI=:",
                "content-type": "application/octet-stream"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": null,
              "bodyBase64": ""
            },
            "response": {
              "status": 204,
              "headers": { "cache-control": "no-store" },
              "body": ""
            }
          }
        ]
      },
      "expect": { "result": "ok", "status": 204 }
    },
    {
      "action": "cloudSyncFile",
      "note": "Commit.",
      "args": { "op": "finalize", "collection": "docs", "id": "d1" },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/sync/files/docs/d1/finalize",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": { "uploadId": "up_8BwXQ94QcQ-SDhpTQFqmIg" },
                "match": "exact"
              }
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": {
                "version": 1,
                "size": 4000,
                "sha256": "2e781e3762b7c315ce53c7e3645f59b2e4c037db30c6bec3a195e0751bd62722",
                "format": "whole"
              }
            }
          }
        ]
      },
      "expect": {
        "result": "ok",
        "status": 200,
        "version": 1,
        "size": 4000,
        "sha256": "2e781e3762b7c315ce53c7e3645f59b2e4c037db30c6bec3a195e0751bd62722"
      }
    }
  ]
}
