{
  "transcriptVersion": 1,
  "id": "cloudsync-files-expired",
  "description": "Session expiry (§13.8.1, GF5): an upload session lives 24 hours. A PUT, a resume and a finalize 25 hours after begin each answer 410 upload_expired (on three sessions: the first call to see an expired session ends it), and nothing is committed.",
  "features": ["sync.files"],
  "requires": ["core.store"],
  "product": "djdl",
  "baseUrl": "https://key.plrs.im",
  "now": 1700000000,
  "trust": {
    "pkey-test-prod-2026": "kDJF6Deuexo91hFZ9TAPr2SmjUEuTXdia67UogTEpkI"
  },
  "initial": {
    "deviceId": "TRANSCRIPTDEVICE0000000000000001",
    "token": "pkeyt_I_wsRTTaFB8OkOXpCu-DUA_-YjJEfw50nKRNjliXPio",
    "version": "1.0.0"
  },
  "steps": [
    {
      "action": "cloudSyncFile",
      "note": "Session 1.",
      "args": { "op": "begin", "collection": "docs", "id": "x1", "size": 2000 },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/sync/files/docs/x1/begin",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": {
                  "size": 2000,
                  "sha256": "e0f38f73dfc5ecb45e2eeafad1d949d1af3ca858ae9dfba89da8d85afa6d1c15",
                  "format": "whole",
                  "enc": "none"
                },
                "match": "exact"
              }
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": {
                "uploadId": "up_cLK3BzwYOjDTuLe3zQUgTA",
                "mode": "single",
                "expiresAt": 1700086400000
              }
            },
            "capture": { "uploadId": "$.uploadId" }
          }
        ]
      },
      "expect": { "result": "ok", "status": 200, "mode": "single" }
    },
    {
      "action": "cloudSyncFile",
      "note": "A PUT 25 hours later.",
      "args": { "op": "put", "collection": "docs", "id": "x1", "size": 2000 },
      "now": 1700090000,
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "PUT",
              "path": "/djdl/sync/files/docs/x1/upload/up_cLK3BzwYOjDTuLe3zQUgTA",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}",
                "content-digest": "sha-256=:4POPc9/F7LReLur60dlJ0a88qFiunfuonajYWvptHBU=:",
                "content-type": "application/octet-stream"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": null,
              "bodyBase64": ""
            },
            "response": {
              "status": 410,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "error": { "code": "upload_expired" } }
            }
          }
        ]
      },
      "expect": { "result": "refused", "status": 410, "code": "upload_expired" }
    },
