  },
  "initial": {
    "deviceId": "TRANSCRIPTDEVICE0000000000000001",
    "version": "1.0.0",
    "services": ["config", "identity"]
  },
  "steps": [
    {
      "action": "exchange",
      "args": { "kind": "google", "keyLabel": "transcript-device-key-1" },
      "exchanges": {
