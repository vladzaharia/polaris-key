{
  "transcriptVersion": 1,
  "id": "redirect-native-loopback",
  "description": "A desktop app signs a person in on a loopback redirect (I-15, WIRE-CONTRACT-V5 §12.12). The app pushes its request at request (a form: the authorize parameters, a loopback redirect_uri on an OS-assigned port, the device label) and gets a request_uri good for 600 s. The browser opens authorize with it and is sent to the card; the person presses Continue, which answers a redirect to the loopback carrying code, state and the card's handle (request=), so the app can open the return page. The app redeems the code at token, from the device that pushed it, with its PKCE verifier and the same redirect URI. The same code again is invalid_grant.",
  "features": ["identity.redirect.native"],
  "requires": [],
  "product": "djdl",
  "baseUrl": "https://key.plrs.im",
  "now": 1700000000,
  "trust": {
    "pkey-test-prod-2026": "kDJF6Deuexo91hFZ9TAPr2SmjUEuTXdia67UogTEpkI"
  },
  "initial": {
    "deviceId": "TRANSCRIPTDEVICE0000000000000001",
    "version": "1.0.0"
  },
