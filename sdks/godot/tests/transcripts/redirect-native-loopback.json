                  "state": "tidewater-state-0123456789",
                  "code_challenge": "-583Jx3Gn4AKAj7xr5NSDQ3V6snyKHhZUDKua28Tp10",
                  "code_challenge_method": "S256",
                  "device_name": "Ada's Mac"
