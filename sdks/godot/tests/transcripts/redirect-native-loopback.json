        "state": "tidewater-state-0123456789",
        "redirectUri": "http://127.0.0.1:49152/pkey/callback"
      },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/identity/request",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
