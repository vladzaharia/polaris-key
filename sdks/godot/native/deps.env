# The native plugins' pinned inputs (P5-07). fetch_deps.sh reads this file; every download is
# checked against its SHA-256 before use, and godot-cpp is checked out at an exact commit. Bump a
# version here together with its hash (and the CI cache keys follow, they hash this file).

# godot-cpp 10.0.0-stable built against the 4.4 API, the SDK's floor: the plugins load in 4.4+.
GODOT_CPP_REPO=https://github.com/godotengine/godot-cpp
GODOT_CPP_TAG=10.0.0-stable
GODOT_CPP_COMMIT=507ed9d840c01a3c5b2a39af8bb4000bfac30bf5
GODOT_CPP_API=4.4

# Sparkle 2.10.0 (floor 2.9.6, P0-10): Sparkle.framework, sign_update, BinaryDelta.
SPARKLE_VERSION=2.10.0
SPARKLE_URL=https://github.com/sparkle-project/Sparkle/releases/download/2.10.0/Sparkle-2.10.0.tar.xz
SPARKLE_SHA256=c2bf58aa8387266ac179357b1415d6f2635f044da8be41042af32425dae6da0c

# Velopack 1.2.161: velopack_libc (C API, loaded at run time) and, for the shim, the Rust crate
# (pinned in windows/velopack/shim/Cargo.lock). vpk is installed with `dotnet tool install`.
VELOPACK_VERSION=1.2.161
VELOPACK_LIBC_URL=https://github.com/velopack/velopack/releases/download/1.2.161/velopack_libc_1.2.161.zip
VELOPACK_LIBC_SHA256=31de8f2cf05a47bd5328a9f98b0c41aec1582156f6075f1058b26941f7f17c20

# WinSparkle 0.9.4: WinSparkle.dll (x64), winsparkle-tool.
WINSPARKLE_VERSION=0.9.4
WINSPARKLE_URL=https://github.com/vslavik/winsparkle/releases/download/v0.9.4/WinSparkle-0.9.4.zip
WINSPARKLE_SHA256=6037df37fc263bd1650a1c4949681a9d40ffe991d01f35892a406cb5d103c976

# SCons >= 4.11 knows Visual Studio 2026 (4.9 falls back to MinGW and fails on /bigobj).
SCONS_VERSION=4.11.1
