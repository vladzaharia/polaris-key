{
  "$schema": "../../conformance/parity/manifest.schema.json",
  "sdk": "godot",
  "runtimes": ["linux", "macos", "windows", "android", "ios", "web"],
  "testRoots": ["sdks/godot/tests"],
  "features": {
    "core.verify": {
      "status": "implemented"
    },
    "core.cache": {
      "status": "implemented"
    },
    "core.bundle": {
      "status": "implemented"
    },
    "core.discover": {
      "status": "implemented"
    },
    "core.sync": {
      "status": "implemented"
    },
    "core.local": {
      "status": "implemented"
    },
    "core.headers": { "status": "implemented" },
    "core.errors": { "status": "implemented" },
    "core.caps": {
      "status": "planned",
      "wp": "P1b-10"
    },
    "core.store": {
      "status": "planned",
      "wp": "P5-05",
      "note": "P1-02 ships the 0600 file store with surfaced failures and store_status() (file or indexeddb, degraded not-persistent); the Keychain binding is P5-05's and the Keystore binding P5-06's; no work package owns a desktop keyring."
    },
    "license.gate": {
      "status": "implemented"
    },
    "license.activate": {
      "status": "implemented"
    },
    "license.enroll": {
      "status": "implemented",
      "except": [
        {
          "runtime": "web",
          "reason": "runtime"
        }
      ]
    },
    "license.deactivate": {
      "status": "implemented"
    },
    "license.entitlements": {
      "status": "implemented"
    },
    "license.channels": {
      "status": "implemented"
    },
    "license.reregister": {
      "status": "implemented"
    },
    "config.resolve": {
      "status": "implemented",
      "note": "OS.get_environment drops a leading U+FEFF from a value, so on a Godot host the two U+FEFF rows of config-matrix.json hold for the resolver, not for the process environment. A number's value is Godot's own reading, which is not correctly rounded, and a string value's \\u0000 reads as U+FFFD (both WIRE-CONTRACT-V3 §10); verdicts are unaffected."
    },
    "config.list": { "status": "implemented" },
    "config.secret": { "status": "implemented" },
    "config.schema": { "status": "implemented" },
    "config.mint": { "status": "implemented" },
    "config.mirror": { "status": "implemented" },
    "devices.fingerprint": {
      "status": "implemented",
      "note": "PKeyFingerprint: per-platform readers as pure parsers over captured output, the capture on a WorkerThreadPool task once a session; the desktop device id hashes MachineGuid (Windows), IOPlatformUUID (macOS) and the rule-2 machine-id (Linux).",
      "except": [
        {
          "runtime": "web",
          "reason": "runtime"
        }
      ]
    },
    "devices.facts": {
      "status": "implemented"
    },
    "devices.register": {
      "status": "implemented"
    },
    "devices.manage": {
      "status": "implemented"
    },
    "devices.report": {
      "status": "implemented",
      "note": "The report also carries the Godot keys engine and outlet (the Worker bounds them); outlet comes only from P1-11's build stamp."
    },
    "identity.oidc": {
      "status": "planned",
      "unowned": true,
      "note": "Native Godot has no completion path for the OIDC redirect; see P1-07, which ships device-code sign-in instead."
    },
    "identity.devicecode": {
      "status": "implemented",
      "note": "PolarisKey.identity (P1-07): begin_sign_in with background polling on the server's cadence, cancel, the opt-in confirm-identity step and licence attach, and a pure-GDScript QR encoder with PKeyQrRect for verification_uri_complete. On web it runs too (OS.shell_open becomes window.open; Worker CORS needed)."
    },
    "release.changelog": { "status": "implemented" },
    "release.download": { "status": "implemented" },
    "release.record": { "status": "implemented" },
    "update.check": { "status": "implemented" },
    "update.feed": { "status": "implemented" },
    "update.decide": { "status": "implemented" },
    "update.driver": {
      "status": "planned",
      "wp": "P3-10"
    },
    "update.bootguard": {
      "status": "planned",
      "wp": "P3-10"
    },
    "outlet.detect": {
      "status": "planned",
      "wp": "P3-11"
    },
    "packs.record": { "status": "planned", "wp": "P4-08" },
    "packs.plan": {
      "status": "planned",
      "wp": "P4-08"
    },
    "packs.index": {
      "status": "planned",
      "wp": "P4-08"
    },
    "packs.apply.full": {
      "status": "planned",
      "wp": "P4-08"
    },
    "packs.apply.file": {
      "status": "planned",
      "wp": "P4-08"
    },
    "packs.apply.chunk": {
      "status": "planned",
      "wp": "P4-11"
    },
    "packs.apply.delta": {
      "status": "planned",
      "wp": "P4-08"
    },
    "packs.state": {
      "status": "planned",
      "wp": "P4-08"
    },
    "packs.handlers": {
      "status": "planned",
      "wp": "P4-08"
    },
    "packs.provides": {
      "status": "planned",
      "wp": "P4-20"
    },
    "packs.transport.apple": {
      "status": "planned",
      "wp": "P5-08",
      "note": "iOS goes through P5-05's plugin; no work package owns a macOS binding (program README §9).",
      "except": [
        {
          "runtime": "linux",
          "reason": "runtime"
        },
        {
          "runtime": "windows",
          "reason": "runtime"
        },
        {
          "runtime": "android",
          "reason": "runtime"
        },
        {
          "runtime": "web",
          "reason": "runtime"
        }
      ]
    },
    "packs.transport.play": {
      "status": "planned",
      "wp": "P5-08",
      "except": [
        {
          "runtime": "linux",
          "reason": "runtime"
        },
        {
          "runtime": "macos",
          "reason": "runtime"
        },
        {
          "runtime": "windows",
          "reason": "runtime"
        },
        {
          "runtime": "ios",
          "reason": "runtime"
        },
        {
          "runtime": "web",
          "reason": "runtime"
        }
      ]
    },
    "packs.transport.steam": {
      "status": "planned",
      "wp": "P5-08",
      "except": [
        {
          "runtime": "android",
          "reason": "runtime"
        },
        {
          "runtime": "ios",
          "reason": "runtime"
        },
        {
          "runtime": "web",
          "reason": "runtime"
        }
      ]
    },
    "packs.transport.msix": {
      "status": "planned",
      "unowned": true,
      "note": "No work package owns an MSIX transport for Godot (program README §9).",
      "except": [
        {
          "runtime": "linux",
          "reason": "runtime"
        },
        {
          "runtime": "macos",
          "reason": "runtime"
        },
        {
          "runtime": "android",
          "reason": "runtime"
        },
        {
          "runtime": "ios",
          "reason": "runtime"
        },
        {
          "runtime": "web",
          "reason": "runtime"
        }
      ]
    },
    "packs.transport.flatpak": {
      "status": "planned",
      "unowned": true,
      "note": "No work package owns a Flatpak transport for Godot (program README §9).",
      "except": [
        {
          "runtime": "macos",
          "reason": "runtime"
        },
        {
          "runtime": "windows",
          "reason": "runtime"
        },
        {
          "runtime": "android",
          "reason": "runtime"
        },
        {
          "runtime": "ios",
          "reason": "runtime"
        },
        {
          "runtime": "web",
          "reason": "runtime"
        }
      ]
    },
    "ui.stages": {
      "status": "planned",
      "wp": "P1-10"
    },
    "ui.kit": {
      "status": "planned",
      "wp": "P1-10"
    },
    "commerce.receipt": {
      "status": "planned",
      "wp": "P6-01"
    }
  }
}
