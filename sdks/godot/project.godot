; Engine configuration file.
; The Polaris Key Godot SDK project: the addon under addons/polaris_key/ plus the headless
; test runner (tests/runner.gd). See README.md.

config_version=5

[application]

config/name="Polaris Key SDK"
config/version="0.1.0"
run/main_scene="res://tests/main.tscn"
run/main_loop_type="PKeyTestRunner"
run/flush_stdout_on_print=true

[autoload]

PolarisKey="*res://addons/polaris_key/polaris_key.gd"

[editor]

; Keep exported .tres as text: tests/fixtures/legacy_options.tres carries pre-0.9 property names that a
; binary conversion (which saves only the script's current properties) would drop.
export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/polaris_key/plugin.cfg")
