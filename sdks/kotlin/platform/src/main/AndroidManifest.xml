<?xml version="1.0" encoding="utf-8"?>
<!-- polaris-key-platform: the user-initiated job service for background transfers (U-41.4). The AAR declares no
     permission (the app decides; the Godot export plugin adds them): a transfer the person starts needs
     RUN_USER_INITIATED_JOBS (Android 14+) to run at once, with a notification (POST_NOTIFICATIONS shows it); without
     it the transfer runs as a WorkManager job. The notification text carries no save name. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Our jobs live in their own JobScheduler namespace (pkey.sync), so their ids never meet WorkManager's. -->
    <application>
        <service
            android:name="im.plrs.key.platform.transfer.SyncTransferJob"
            android:exported="false"
            tools:ignore="SpecifyJobSchedulerIdRange"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
