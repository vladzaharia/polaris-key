        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam doesn't share an email. Add one so you can get back in without Steam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam gibt keine E-Mail-Adresse weiter. Fügen Sie eine hinzu, damit Sie auch ohne Steam wieder Zugang erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam ne partage pas d’adresse e-mail. Ajoutez-en une pour pouvoir revenir sans Steam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam no comparte ningún correo. Añade uno para poder volver a entrar sin Steam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Steam não compartilha e-mail. Adicione um para poder entrar de novo sem o Steam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam non condivide un indirizzo email. Aggiungine uno per poter rientrare senza Steam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steamはメールアドレスを共有しません。Steamがなくてもサインインできるよう、メールアドレスを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam은 이메일을 공유하지 않아요. Steam 없이도 다시 로그인할 수 있도록 이메일을 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam不提供电子邮件。请添加一个，以便不通过Steam也能重新登录。"
          }
        }
      }
    },
