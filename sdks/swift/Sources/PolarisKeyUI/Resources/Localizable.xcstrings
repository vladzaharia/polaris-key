    "signin.signout.released": {
      "comment": "Sign-out confirmation (SIGN-IN.md §4.9). Arguments: {product} = the product's name from ProductIdentity (never translated); {tier} = the tier's name (never translated). Arguments: 1=product, 2=tier.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stops using your %2$@ license on this device and frees room for another device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ verwendet Ihre %2$@-Lizenz auf diesem Gerät nicht mehr und schafft Platz für ein weiteres Gerät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cesse d’utiliser votre licence %2$@ ici et libère de la place pour un autre appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dejará de usar aquí tu licencia %2$@ y liberará espacio para otro dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ deixa de usar sua licença %2$@ aqui e libera espaço para outro dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ smette di usare qui la tua licenza %2$@ e libera spazio per un altro dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はこのデバイスで%2$@ライセンスの使用を停止し、別のデバイス用に空きを作ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 이 기기에서 %2$@ 라이선스 사용을 중지해 다른 기기를 추가할 수 있게 돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@将停止在此设备上使用你的%2$@许可证，以便其他设备使用。"
          }
        }
      }
    },
