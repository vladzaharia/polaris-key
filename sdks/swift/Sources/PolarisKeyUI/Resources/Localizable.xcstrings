    },
    "signin.device.lede": {
      "comment": "Device code approval on a phone or computer (SIGN-IN.md §3.11). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”. Arguments: 1=device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your phone or computer here. %1$@ continues by itself when you're done."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie hier Ihr Telefon oder Ihren Computer. %1$@ fährt automatisch fort, wenn Sie fertig sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
