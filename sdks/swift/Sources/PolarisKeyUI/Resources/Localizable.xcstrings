        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il valore anche se un log di CI eseguirebbe una sua riga come comando"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CIログが値の行をコマンドとして実行する場合でも値を出力"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
