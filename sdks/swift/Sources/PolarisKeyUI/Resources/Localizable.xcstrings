    "signin.key.help": {
      "comment": "Have a license key? step: help under the field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts with pkey_. Case-sensitive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt mit pkey_. Groß- und Kleinschreibung beachten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence par pkey_. Sensible à la casse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza por pkey_. Distingue mayúsculas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa com pkey_. Diferencia maiúsculas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con pkey_. Distingue maiuscole e minuscole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pkey_ で始まります。大文字と小文字は区別されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "pkey_로 시작해요. 대소문자를 구분해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
