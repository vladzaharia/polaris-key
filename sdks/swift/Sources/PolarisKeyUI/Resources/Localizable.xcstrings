        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はすでに Polaris Locker のアカウントに属しています。このサインインをそのアカウントに統合するか、別のメールアドレスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
