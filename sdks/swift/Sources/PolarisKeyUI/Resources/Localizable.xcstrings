    "core.codes.link_conflict.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That sign-in method belongs to another Polaris Locker account. Sign in to that account, or join the two accounts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anmeldemethode gehört zu einem anderen Polaris Locker-Konto. Melden Sie sich bei diesem Konto an oder führen Sie die beiden Konten zusammen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette méthode de connexion appartient à un autre compte Polaris Locker. Connectez-vous à ce compte, ou fusionnez les deux comptes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese método de inicio de sesión pertenece a otra cuenta de Polaris Locker. Inicia sesión en esa cuenta o une las dos cuentas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse método de acesso pertence a outra conta do Polaris Locker. Entre nessa conta ou una as duas contas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo metodo di accesso appartiene a un altro account Polaris Locker. Accedi a quell'account o unisci i due account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサインイン方法は別のPolaris Lockerアカウントに連携されています。そのアカウントにサインインするか、2つのアカウントを統合してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 로그인 방법은 다른 Polaris Locker 계정에 속해 있어요. 그 계정으로 로그인하거나 두 계정을 합치세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该登录方式属于另一个Polaris Locker账户。请登录那个账户，或将两个账户合并。"
          }
        }
      }
    },
