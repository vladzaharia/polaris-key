    "core.codes.content-stamp-invalid.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build's content information isn't valid. Reinstall the app or contact the developer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Inhaltsinformationen dieses Builds sind ungültig. Installieren Sie die App neu oder wenden Sie sich an den Entwickler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
