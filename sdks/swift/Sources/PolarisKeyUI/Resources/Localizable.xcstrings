    "core.codes.store-failed.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app couldn't read or save its license on this device. Check that the app can write its data folder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App konnte ihre Lizenz auf diesem Gerät nicht lesen oder speichern. Prüfen Sie, ob die App in ihren Datenordner schreiben kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’a pas pu lire ou enregistrer sa licence sur cet appareil. Vérifiez qu’elle peut écrire dans son dossier de données."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no pudo leer ni guardar su licencia en este dispositivo. Comprueba que la app puede escribir en su carpeta de datos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não conseguiu ler nem salvar a licença neste dispositivo. Verifique se o app pode gravar na pasta de dados dele."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app non è riuscita a leggere o salvare la licenza su questo dispositivo. Verifica che l'app possa scrivere nella sua cartella dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリはこのデバイスでライセンスを読み取るか保存することができませんでした。アプリがデータフォルダに書き込めることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 이 기기에서 라이선스를 읽거나 저장하지 못했어요. 앱이 데이터 폴더에 쓸 수 있는지 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用无法在此设备上读取或保存其许可证。请确认应用可以写入其数据文件夹。"
          }
        }
      }
    },
