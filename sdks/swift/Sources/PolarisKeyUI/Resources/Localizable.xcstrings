    "signin.identityOff.notice": {
      "comment": "The product doesn't use Polaris Locker sign-in (SIGN-IN.md §4.12). Arguments: {product} = the product's name from ProductIdentity (never translated). Arguments: 1=product.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ doesn't use Polaris Locker sign-in. Open %1$@ and enter your license key there."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ verwendet keine Anmeldung über Polaris Locker. Öffnen Sie %1$@ und geben Sie dort Ihren Lizenzschlüssel ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n’utilise pas la connexion Polaris Locker. Ouvrez %1$@ et saisissez-y votre clé de licence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no usa el inicio de sesión de Polaris Locker. Abre %1$@ y escribe allí tu clave de licencia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não usa o acesso do Polaris Locker. Abra %1$@ e digite sua chave de licença lá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non usa l'accesso Polaris Locker. Apri %1$@ e inserisci lì la tua chiave di licenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はPolaris Lockerのサインインを使用しません。%1$@を開いて、そこでライセンスキーを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서는 Polaris Locker 로그인을 사용하지 않아요. %1$@을(를) 열어 라이선스 키를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@不使用Polaris Locker登录。请打开%1$@并在其中输入你的许可证密钥。"
          }
        }
      }
    },
