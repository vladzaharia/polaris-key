    "core.codes.fingerprint_required.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This license needs a hardware fingerprint, which couldn't be read on this device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Lizenz benötigt einen Hardware-Fingerabdruck, der auf diesem Gerät nicht gelesen werden konnte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This license needs a hardware fingerprint, which couldn't be read on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licencia necesita una huella de hardware, que no se pudo leer en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licença exige uma impressão digital de hardware, que não pôde ser lida neste dispositivo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa licenza richiede un'impronta hardware, che non è stato possibile leggere su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライセンスにはハードウェアフィンガープリントが必要ですが、このデバイスでは読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이선스에는 하드웨어 지문이 필요하지만 이 기기에서 읽을 수 없었어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此许可证需要硬件指纹，但无法在此设备上读取。"
          }
        }
      }
    },
