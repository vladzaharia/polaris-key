          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa qui il telefono o il computer. %1$@ continua da solo quando hai finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでスマートフォンまたはコンピュータを使用してください。完了すると%1$@が自動的に続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 휴대폰이나 컴퓨터를 사용하세요. 완료하면 %1$@에서 자동으로 계속 진행돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里使用你的手机或电脑。完成后%1$@会自动继续。"
          }
        }
      }
