    "signin.handoff.browserBody": {
      "comment": "App waiting while sign-in runs in the browser (SIGN-IN.md §3.17). Arguments: {app} = the requesting app's name (never translated). Arguments: 1=app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We opened Polaris Locker in your browser. Sign in there and %1$@ continues by itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben Polaris Locker in Ihrem Browser geöffnet. Melden Sie sich dort an, dann fährt %1$@ automatisch fort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons ouvert Polaris Locker dans votre navigateur. Connectez-vous dans le navigateur et %1$@ continuera tout seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrimos Polaris Locker en tu navegador. Inicia sesión allí y %1$@ continuará solo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrimos o Polaris Locker no seu navegador. Entre por lá e %1$@ continua sozinho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo aperto Polaris Locker nel browser. Accedi lì e %1$@ continuerà da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでPolaris Lockerを開きました。そこでサインインすると、%1$@が自動的に続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 Polaris Locker를 열었어요. 거기서 로그인하면 %1$@에서 자동으로 계속 진행돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们已在你的浏览器中打开Polaris Locker。在那里登录后，%1$@会自动继续。"
          }
        }
      }
    },
