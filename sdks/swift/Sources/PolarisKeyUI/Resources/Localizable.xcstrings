    "boot.declined.body": {
      "comment": "Boot screen, shown while the product starts. Arguments: {product} = the product's name from ProductIdentity (never translated). Arguments: 1=product.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ needs this content to start. Download it when you're ready."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ benötigt diese Inhalte zum Starten. Laden Sie sie herunter, wenn Sie bereit sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a besoin de ce contenu pour démarrer. Téléchargez-le quand vous le souhaitez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ necesita este contenido para iniciarse. Descárgalo cuando quieras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ precisa deste conteúdo para iniciar. Baixe-o quando quiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha bisogno di questi contenuti per avviarsi. Scaricali quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の起動にはこのコンテンツが必要です。準備ができたらダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 시작하려면 이 콘텐츠가 필요해요. 준비되면 다운로드하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@需要此内容才能启动。准备好后再下载。"
          }
        }
      }
    },
