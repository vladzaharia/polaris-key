    "signin.join.undoConfirm": {
      "comment": "Link dialog opened from the 72-hour row: confirm the undo. {email}, {date}. Arguments: 1=email, 2=date.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo the join with %1$@? You can until %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammenführung mit %1$@ rückgängig machen? Möglich bis %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler la fusion avec %1$@ ? Possible jusqu’au %2$@."
          }
