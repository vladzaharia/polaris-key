    "deviceLimit.lede": {
      "comment": "DeviceLimit, the Replace a device flow (SIGN-IN.md §3.7): the license is on all its devices. Arguments: {formFactor} = the device's form factor; each case is a whole phrase. Varies by device (formFactor).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "iphone": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To use it on this iPhone, replace one. You can add it back later."
                }
              },
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To use it on this iPad, replace one. You can add it back later."
                }
              },
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To use it on this Mac, replace one. You can add it back later."
                }
              },
              "appletv": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To use it on this TV, replace one. You can add it back later."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To use it on this device, replace one. You can add it back later."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "device": {
              "iphone": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Um sie auf diesem iPhone zu verwenden, ersetzen Sie eines. Sie können es später wieder hinzufügen."
                }
              },
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Um sie auf diesem iPad zu verwenden, ersetzen Sie eines. Sie können es später wieder hinzufügen."
                }
              },
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Um sie auf diesem Mac zu verwenden, ersetzen Sie eines. Sie können es später wieder hinzufügen."
                }
              },
              "appletv": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Um sie auf diesem Fernseher zu verwenden, ersetzen Sie eines. Sie können es später wieder hinzufügen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Um sie auf diesem Gerät zu verwenden, ersetzen Sie eines. Sie können es später wieder hinzufügen."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "iphone": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Pour l’utiliser sur cet iPhone, remplacez-en un. Vous pourrez le rajouter plus tard."
                }
