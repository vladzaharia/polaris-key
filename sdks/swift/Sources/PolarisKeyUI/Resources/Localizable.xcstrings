            "value": "Ese dispositivo ya se quitó. Vuelve a elegir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse dispositivo já foi removido. Escolha novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel dispositivo è già stato rimosso. Scegli di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのデバイスはすでに削除されています。もう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 제거된 기기예요. 다시 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备已被移除。请重新选择。"
          }
        }
      }
    },
