    "deviceLimit.browser": {
      "comment": "DeviceLimit, the Replace a device flow (SIGN-IN.md §3.7): the license is on all its devices. Browser mode: the device list is only in the browser. Arguments: {product} = the product's name from ProductIdentity (never translated). Arguments: 1=product.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace a device in your browser. %1$@ continues when you're done."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzen Sie ein Gerät in Ihrem Browser. %1$@ wird fortgesetzt, wenn Sie fertig sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacez un appareil dans votre navigateur. %1$@ reprendra une fois que vous aurez terminé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplaza un dispositivo en tu navegador. %1$@ continuará cuando termines."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitua um dispositivo no navegador. %1$@ continua quando você terminar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisci un dispositivo nel browser. %1$@ continua quando hai finito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでデバイスを置き換えてください。完了すると%1$@が続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 기기를 교체하세요. 완료하면 %1$@에서 계속 진행돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在浏览器中替换设备。完成后%1$@会继续。"
          }
        }
      }
    },
    "deviceLimit.confirmTitle": {
      "comment": "DeviceLimit, the Replace a device flow (SIGN-IN.md §3.7): the license is on all its devices. Confirm block under the selected device. On macOS the kit wraps {device} in curly quotes. Arguments: {device} = a device's friendly name, for example “Maya's MacBook”. Arguments: 1=device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace %1$@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ersetzen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer %1$@ ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Reemplazar %1$@?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substituir %1$@?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituire %1$@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を置き換えますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 교체할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换%1$@？"
          }
        }
      }
    },
    "deviceLimit.consequence": {
      "comment": "DeviceLimit, the Replace a device flow (SIGN-IN.md §3.7): the license is on all its devices. Confirm block body. Arguments: {device} = a device's friendly name, for example “Maya's MacBook”; {product} = the product's name from ProductIdentity (never translated); {thisDevice} = the platform phrase for the current device (part.thisDevice, for example “this iPhone”). Arguments: 1=device, 2=product, 3=thisDevice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signs out of %2$@ and %3$@ takes its seat. %1$@ can sign in again later if a seat is free. We'll email you about it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird von %2$@ abgemeldet und %3$@ übernimmt den Platz. %1$@ kann sich später wieder anmelden, wenn ein Platz frei ist. Wir informieren Sie per E-Mail darüber."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sera déconnecté de %2$@ et %3$@ prendra sa place. %1$@ pourra se reconnecter plus tard si une place se libère. Nous vous enverrons un e-mail à ce sujet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará la sesión de %2$@ en %1$@ y %3$@ ocupará su plaza. %1$@ podrá volver a iniciar sesión más tarde si hay una plaza libre. Te lo notificaremos por correo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sai de %2$@ e %3$@ ocupa a vaga. %1$@ poderá entrar novamente depois, se houver uma vaga livre. Enviaremos um e-mail sobre isso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ esce da %2$@ e %3$@ ne prende il posto. %1$@ potrà accedere di nuovo in seguito se si libera un posto. Ti invieremo un'email al riguardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@からサインアウトし、%3$@がその枠を使用します。枠が空けば、%1$@は後で再びサインインできます。この件についてはメールでお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) %2$@에서 로그아웃되고 %3$@이(가) 그 자리를 사용해요. 자리가 비면 %1$@에서 나중에 다시 로그인할 수 있어요. 이 내용은 이메일로 알려 드려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@将退出登录%2$@，%3$@将占用它的席位。如有空余席位，%1$@之后可以重新登录。我们会通过电子邮件通知你。"
          }
        }
      }
    },
    "deviceLimit.failed": {
      "comment": "DeviceLimit, the Replace a device flow (SIGN-IN.md §3.7): the license is on all its devices. Arguments: {device} = a device's friendly name, for example “Maya's MacBook”. Arguments: 1=device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ couldn't be replaced. Try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ konnte nicht ersetzt werden. Versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de remplacer %1$@. Réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reemplazar %1$@. Vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível substituir %1$@. Tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile sostituire %1$@. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を置き換えられませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 교체하지 못했어요. 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法替换%1$@。请重试。"
          }
        }
      }
    },
    "deviceLimit.heading": {
      "comment": "DeviceLimit, the Replace a device flow (SIGN-IN.md §3.7): the license is on all its devices. Arguments: {used} = how many devices use the license, as a number; {limit} = the license's device limit, as a number. Arguments: 1=used, 2=limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your license is on %1$@ of %#@limit@"
          },
          "substitutions": {
            "limit": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg device"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg devices"
