        }
      }
    },
    "signin.choice.raced": {
      "comment": "Choose a license for this device (SIGN-IN.md §3.6).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device was just replaced. Choose again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wurde gerade ersetzt. Wählen Sie erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil vient d’être remplacé. Faites un autre choix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese dispositivo acaba de reemplazarse. Vuelve a elegir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse dispositivo acabou de ser substituído. Escolha novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel dispositivo è appena stato sostituito. Scegli di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのデバイスはたった今置き換えられました。もう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 기기는 방금 교체됐어요. 다시 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备刚刚已被替换。请重新选择。"
          }
        }
      }
    },
    "signin.choice.replaceAndSignIn": {
      "comment": "PX-14a: the app card (SIGN-IN.md §3.6 to §3.9).",
      "extractionState": "manual",
      "localizations": {
