    "boot.consent.body": {
      "comment": "Boot screen, shown while the product starts. Arguments: {product} = the product's name from ProductIdentity (never translated); {size} = a byte size already formatted by the platform (“38 MB”). Arguments: 1=product, 2=size.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ needs %2$@ of new content."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ benötigt %2$@ an neuen Inhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a besoin de %2$@ de nouveau contenu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ necesita %2$@ de contenido nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ precisa de %2$@ de conteúdo novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha bisogno di %2$@ di nuovi contenuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@には%2$@の新しいコンテンツが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 %2$@ 크기의 새 콘텐츠가 필요해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@需要%2$@的新内容。"
          }
        }
      }
    },
    "boot.consent.bodyMetered": {
      "comment": "Boot screen, shown while the product starts. A metered connection is one that charges by data used. Arguments: {product} = the product's name from ProductIdentity (never translated); {size} = a byte size already formatted by the platform (“38 MB”). Arguments: 1=product, 2=size.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ needs %2$@ of new content, and you're on a metered connection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ benötigt %2$@ an neuen Inhalten, und Sie nutzen eine getaktete Verbindung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a besoin de %2$@ de nouveau contenu, et votre connexion est facturée à l’usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ necesita %2$@ de contenido nuevo y estás en una conexión de uso medido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ precisa de %2$@ de conteúdo novo, e você está em uma conexão limitada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha bisogno di %2$@ di nuovi contenuti e stai usando una connessione a consumo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@には%2$@の新しいコンテンツが必要です。現在、従量制の接続を使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 %2$@ 크기의 새 콘텐츠가 필요해요. 현재 데이터 종량제 네트워크에 연결되어 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@需要%2$@的新内容，而你正在使用按流量计费的网络。"
          }
        }
      }
    },
