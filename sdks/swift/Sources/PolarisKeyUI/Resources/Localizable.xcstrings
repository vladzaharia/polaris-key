        }
      }
    },
    "cli.activate.otherProduct": {
      "comment": "Terminal key prompt: the key belongs to a different product. {app} is that product's slug, {product} the product this command is for. Arguments: 1=app, 2=product.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key is for another product (%1$@). Use your %2$@ key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel gehört zu einem anderen Produkt (%1$@). Verwenden Sie Ihren Schlüssel für %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé est celle d’un autre produit (%1$@). Utilisez votre clé %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave es de otro producto (%1$@). Usa tu clave de %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave é de outro produto (%1$@). Use a sua chave de %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chiave è di un altro prodotto (%1$@). Usa la tua chiave di %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーは別の製品（%1$@）用です。%2$@のキーを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 다른 제품(%1$@)용이에요. %2$@ 키를 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密钥属于另一款产品（%1$@）。请使用%2$@的密钥。"
          }
        }
      }
    },
    "cli.activate.unauthorized": {
      "comment": "Terminal activate: the server did not accept the license key, under the title 'Key not accepted'. It answers the same for a wrong key and for one that expired or was turned off, so the text covers both. It ends in a colon: the product's account page on Polaris Locker follows on its own line, as a link.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check it for typos. If it's right, it may have expired or been turned off:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie ihn auf Tippfehler. Stimmt er, ist er vielleicht abgelaufen oder deaktiviert:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez qu’elle ne contient pas de faute. Si elle est correcte, elle a peut-être expiré ou été désactivée :"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que no tenga errores. Si es correcta, puede que haya caducado o se haya desactivado:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira se não há erros de digitação. Se estiver certa, ela pode ter expirado ou sido desativada:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla di non aver sbagliato a digitarla. Se è giusta, potrebbe essere scaduta o disattivata:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力を確認してください。正しい場合は、期限切れか無効にされた可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오타가 없는지 확인하세요. 맞다면 만료되었거나 꺼졌을 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查是否有输入错误。如果无误，它可能已过期或被停用："
          }
        }
      }
    },
    "cli.changelog.fix": {
      "comment": "Terminal changelog: what to do after the release notes failed to load. {command} is a command line. Arguments: 1=command.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and run %1$@ again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie Ihre Verbindung und führen Sie %1$@ erneut aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion, puis exécutez à nouveau %1$@."
