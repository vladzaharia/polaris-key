        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · %3$@ diventa il dispositivo %4$@ di %5$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · %3$@は%5$@台中%4$@台目のデバイスになります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · %3$@: %5$@대 중 %4$@번째 기기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · %3$@将成为第%4$@台设备（共%5$@台）"
          }
        }
      }
    },
    "signin.consent.pairwise": {
      "comment": "Consent step before returning to the app (SIGN-IN.md §3.8).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It gets its own id for you, and won't see your other products or how you sign in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App erhält eine eigene ID für Sie und sieht weder Ihre anderen Produkte noch, wie Sie sich anmelden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application reçoit un identifiant qui lui est propre et ne verra ni vos autres produits ni votre mode de connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe su propio identificador para ti y no verá tus otros productos ni cómo inicias sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele recebe um id próprio para você e não verá seus outros produtos nem como você entra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riceve un identificativo dedicato per te e non vedrà gli altri tuoi prodotti né come accedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリにはあなた専用のIDが渡され、あなたのほかの製品やサインイン方法が知られることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에는 회원님 전용 ID가 제공되며, 다른 제품이나 로그인 방법은 공개되지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会获得一个专属于你的独立ID，且无法看到你的其他产品或你的登录方式。"
          }
        }
      }
    },
