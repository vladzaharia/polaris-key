    "signin.confirmLink.title": {
      "comment": "Page opened from the email's sign-in link on another device (SIGN-IN.md §3.4). Arguments: {time} = a duration or time already formatted by the platform (“4:12”, “2 min ago”); {place} = an approximate place (city, country). Arguments: 1=time, 2=place.",
      "extractionState": "manual",
      "localizations": {
        "en": {
