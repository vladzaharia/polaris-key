    "cli.activate.argWarning": {
      "comment": "Terminal warning when a license key was given on the command line. {command} is a command line such as 'tidewater activate'. Arguments: 1=command.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A key typed after the command is saved in your shell history. Next time, run %1$@ and paste the key when it asks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein nach dem Befehl eingegebener Schlüssel wird im Verlauf Ihrer Shell gespeichert. Führen Sie beim nächsten Mal %1$@ aus und fügen Sie den Schlüssel bei der Abfrage ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une clé saisie après la commande est enregistrée dans l’historique de votre shell. La prochaine fois, exécutez %1$@ et collez la clé quand elle vous est demandée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una clave escrita después del comando se guarda en el historial de tu shell. La próxima vez, ejecuta %1$@ y pega la clave cuando te la pida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma chave digitada depois do comando fica salva no histórico do shell. Da próxima vez, execute %1$@ e cole a chave quando ela for pedida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chiave digitata dopo il comando viene salvata nella cronologia della shell. La prossima volta esegui %1$@ e incolla la chiave quando viene richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドの後に入力したキーはシェルの履歴に保存されます。次回は%1$@を実行し、求められたらキーをペーストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 뒤에 입력한 키는 셸 기록에 저장돼요. 다음에는 키 없이 실행하고 요청할 때 키를 붙여넣으세요: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在命令后输入的密钥会保存在shell历史记录中。下次请运行%1$@，并在提示时粘贴密钥。"
          }
        }
      }
    },
    "cli.activate.noKey": {
      "comment": "Terminal: activate ran where it cannot ask for the key (no terminal) and nothing was piped in. Arguments: 1=command.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No license key. Run %1$@ in a terminal, or pipe the key to it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Lizenzschlüssel. Führen Sie %1$@ in einem Terminal aus oder übergeben Sie den Schlüssel per Pipe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé de licence. Exécutez %1$@ dans un terminal, ou transmettez-lui la clé par un pipe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay clave de licencia. Ejecuta %1$@ en una terminal o pásale la clave por una tubería."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma chave de licença. Execute %1$@ em um terminal ou envie a chave para ele por pipe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chiave di licenza. Esegui %1$@ in un terminale o passagli la chiave tramite pipe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライセンスキーがありません。ターミナルで%1$@を実行するか、キーをパイプで渡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스 키가 없어요. 터미널에서 실행하거나 키를 파이프로 전달하세요: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有许可证密钥。请在终端中运行%1$@，或通过管道将密钥传给它。"
          }
        }
      }
    },
    "cli.activate.noKeyPiped": {
      "comment": "Terminal: activate read a piped stdin (a file, pipe or socket) and no key arrived in time.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No license key arrived on stdin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf stdin ist kein Lizenzschlüssel angekommen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé de licence n’est arrivée sur stdin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No llegó ninguna clave de licencia por stdin."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma chave de licença chegou pelo stdin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna chiave di licenza è arrivata da stdin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "stdin からライセンスキーが届きませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "stdin으로 라이선스 키가 들어오지 않았어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
