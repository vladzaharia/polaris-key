    "signin.mail.newDevice.body": {
      "comment": "Security email (SIGN-IN.md §3.15). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”; {date} = a date already formatted by the platform; {place} = an approximate place (city, country). Arguments: 1=device, 2=date, 3=place.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signed in on %2$@ from %3$@. If this wasn't you, sign it out in Polaris Key under Where you're signed in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat sich am %2$@ von %3$@ aus angemeldet. Falls Sie das nicht waren, melden Sie es in Polaris Key unter „Wo Sie angemeldet sind“ ab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ s’est connecté le %2$@ depuis %3$@. Si ce n’était pas vous, déconnectez-le dans Polaris Key, section Où vous êtes connecté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ inició sesión el %2$@ desde %3$@. Si no fuiste tú, cierra su sesión en Polaris Key, en Dónde has iniciado sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ entrou em %2$@ de %3$@. Se não foi você, desconecte-o no Polaris Key em Onde você está conectado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha effettuato l'accesso il %2$@ da %3$@. Se non sei stato tu, disconnettilo in Polaris Key nella sezione Dove hai effettuato l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@に%3$@から%1$@がサインインしました。心当たりがない場合は、Polaris Keyの「サインイン中のデバイス」からサインアウトしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@에 %3$@에서 %1$@에 로그인했어요. 본인이 아니라면 Polaris Key의 “로그인된 위치”에서 해당 기기를 로그아웃하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@于%2$@从%3$@登录。如果这不是你本人操作，请在Polaris Key的“你的登录位置”中将其退出登录。"
          }
        }
      }
    },
