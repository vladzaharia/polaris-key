    "signin.approve.lede": {
      "comment": "Sign in with another device: under the title (SIGN-IN.md §3.11). Account → Approve a new device is the portal's own menu path.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a phone or computer where you're signed in, scan the code, or open Account → Approve a new device and type it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannen Sie auf einem Telefon oder Computer, auf dem Sie angemeldet sind, den Code oder öffnen Sie Konto → Neues Gerät genehmigen und geben Sie ihn ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un téléphone ou un ordinateur où vous êtes connecté, scannez le code, ou ouvrez Compte → Approuver un nouvel appareil et saisissez-le."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un teléfono o una computadora donde hayas iniciado sesión, escanea el código, o abre Cuenta → Aprobar un dispositivo nuevo y escríbelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um celular ou computador onde você está conectado, escaneie o código, ou abra Conta → Aprovar um novo dispositivo e digite-o."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su un telefono o un computer dove hai già effettuato l'accesso, inquadra il codice, oppure apri Account → Approva un nuovo dispositivo e digitalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン済みのスマートフォンまたはコンピュータで、コードをスキャンするか、アカウント → 新しいデバイスを承認 を開いて入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인한 휴대폰이나 컴퓨터에서 코드를 스캔하거나, 계정 → 새 기기 승인을 열어 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已登录的手机或电脑上扫描该代码，或打开“账户 → 批准新设备”并输入。"
          }
        }
      }
    },
