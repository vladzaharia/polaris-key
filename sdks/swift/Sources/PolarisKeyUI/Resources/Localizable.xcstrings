        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer anderen E-Mail-Adresse gekauft? Melden Sie sich stattdessen mit diesem Konto an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous l’avez acheté avec une autre adresse e-mail ? Connectez-vous plutôt avec ce compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Lo compraste con otro correo? Inicia sesión con esa cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprou com outro e-mail? Entre com essa conta."
          }
        },
        "it": {
