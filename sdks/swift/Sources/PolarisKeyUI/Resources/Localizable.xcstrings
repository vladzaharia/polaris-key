    "signin.gate.joinOtherLede": {
      "comment": "Finish: the join offer when the other account is not yet proven. Arguments: {email}. Arguments: 1=email.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ already belongs to a Polaris Locker account. Use a different email, or sign in to that account first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gehört bereits zu einem Polaris Locker-Konto. Verwenden Sie eine andere E-Mail-Adresse oder melden Sie sich zuerst bei diesem Konto an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ appartient déjà à un compte Polaris Locker. Utilisez une autre adresse e-mail, ou connectez-vous d’abord à ce compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ya pertenece a una cuenta de Polaris Locker. Usa otro correo o inicia sesión primero en esa cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ já pertence a uma conta do Polaris Locker. Use outro e-mail ou entre primeiro nessa conta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ appartiene già a un account Polaris Locker. Usa un'altra email o accedi prima a quell'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はすでにPolaris Lockerのアカウントで使われています。別のメールアドレスを使うか、先にそのアカウントにサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 이미 Polaris Locker 계정에 속해 있어요. 다른 이메일을 사용하거나 먼저 그 계정에 로그인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已属于一个 Polaris Locker 账户。请使用其他邮箱，或先登录该账户。"
          }
        }
      }
    },
    "signin.gate.joinProve": {
      "comment": "Finish step: the join offer cannot be taken until the other account is proven.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To join, sign in to that account in this browser first, then add this sign-in from Account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich dafür zuerst in diesem Browser bei diesem Konto an und fügen Sie diese Anmeldung dann unter Konto hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les fusionner, connectez-vous d’abord à ce compte dans ce navigateur, puis ajoutez cette connexion depuis Compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para unirlas, inicia sesión primero en esa cuenta en este navegador y luego añade este inicio de sesión desde Cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para unir, entre primeiro nessa conta neste navegador e depois adicione este acesso em Conta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per unirli, accedi prima a quell'account in questo browser, poi aggiungi questo accesso da Account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統合するには、まずこのブラウザでそのアカウントにサインインし、アカウントからこのサインインを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통합하려면 먼저 이 브라우저에서 해당 계정에 로그인한 다음 계정에서 이 로그인을 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要合并，请先在此浏览器中登录该账户，然后在“账户”中添加此登录。"
          }
        }
      }
    },
    "signin.gate.joinTitle": {
      "comment": "Finish step: the join offer (SIGN-IN.md §3.5).",
      "extractionState": "manual",
      "localizations": {
