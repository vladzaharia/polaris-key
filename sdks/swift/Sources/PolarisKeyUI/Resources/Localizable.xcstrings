    "signin.choice.allFull": {
      "comment": "Choose a license for this device (SIGN-IN.md §3.6).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your licenses are on all their devices. Replace a device to use one here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ihre Lizenzen haben ihr Gerätelimit erreicht. Ersetzen Sie ein Gerät, um hier eine davon zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos licences sont utilisées sur tous leurs appareils. Remplacez un appareil pour en utiliser une ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus licencias ya han alcanzado su límite de dispositivos. Reemplaza un dispositivo para usar una aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas licenças estão em todos os dispositivos permitidos. Substitua um dispositivo para usar uma aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue licenze sono in uso su tutti i dispositivi consentiti. Sostituisci un dispositivo per usarne una qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お持ちのライセンスはすべて、デバイス数が上限に達しています。ここで使うにはデバイスを置き換えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스가 모든 기기에서 사용 중이에요. 여기에서 사용하려면 기기를 교체하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的许可证已用满所有设备。替换一台设备即可在此使用。"
          }
        }
      }
    },
    "signin.choice.allFullCreate": {
      "comment": "Choose a license for this device (SIGN-IN.md §3.6).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your licenses are on all their devices. Replace a device, or create a new free license."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ihre Lizenzen haben ihr Gerätelimit erreicht. Ersetzen Sie ein Gerät oder erstellen Sie eine neue kostenlose Lizenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos licences sont utilisées sur tous leurs appareils. Remplacez un appareil ou créez une nouvelle licence gratuite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus licencias ya han alcanzado su límite de dispositivos. Reemplaza un dispositivo o crea una licencia gratuita nueva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas licenças estão em todos os dispositivos permitidos. Substitua um dispositivo ou crie uma nova licença grátis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue licenze sono in uso su tutti i dispositivi consentiti. Sostituisci un dispositivo o crea una nuova licenza gratuita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お持ちのライセンスはすべて、デバイス数が上限に達しています。デバイスを置き換えるか、新しい無料ライセンスを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스가 모든 기기에서 사용 중이에요. 기기를 교체하거나 새 무료 라이선스를 만드세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的许可证已用满所有设备。请替换一台设备，或创建新的免费许可证。"
          }
        }
      }
    },
    "signin.choice.codeExpired": {
      "comment": "Choose a license for this device (SIGN-IN.md §3.6). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”. Arguments: 1=device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code on %1$@ expired. Get a new code there and scan it again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code auf %1$@ ist abgelaufen. Fordern Sie dort einen neuen Code an und scannen Sie ihn erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code sur %1$@ a expiré. Obtenez-en un nouveau sur cet appareil et scannez-le à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de %1$@ ha caducado. Obtén un código nuevo allí y vuelve a escanearlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código em %1$@ expirou. Obtenha um novo código lá e escaneie-o novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice su %1$@ è scaduto. Ottieni lì un nuovo codice e scansionalo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のコードの有効期限が切れました。そちらで新しいコードを取得して、もう一度スキャンしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 코드가 만료됐어요. 그 기기에서 새 코드를 받아 다시 스캔하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@上的代码已过期。请在那台设备上获取新代码并重新扫描。"
          }
        }
      }
    },
