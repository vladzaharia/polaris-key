    "cli.option.yes": {
      "comment": "Terminal help: what the --yes flag does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't ask before signing out"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Abmelden nicht nachfragen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas demander avant la déconnexion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No preguntar antes de cerrar sesión"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não perguntar antes de sair"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non chiedere conferma prima di uscire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウト前に確認しない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃 전에 확인하지 않음"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录前不再询问"
          }
        }
      }
    },
    "cli.option.yesDownload": {
      "comment": "Terminal help: what the --yes flag does on boot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download required content without asking"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderliche Inhalte ohne Nachfrage laden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger le contenu requis sans demander"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargar el contenido necesario sin preguntar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixar o conteúdo necessário sem perguntar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica i contenuti richiesti senza chiedere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なコンテンツを確認せずにダウンロード"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 콘텐츠를 묻지 않고 다운로드"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需询问即下载所需内容"
          }
        }
      }
    },
    "cli.output.workflowCommand": {
      "comment": "Terminal: the secret or mint command did not print its value (a secret or a token) because the build server reading the output would treat a line of it as an instruction. {command} is a command line (the same command with --allow-workflow-commands). Arguments: 1=command.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The value was not printed: this CI log would run a line of it as a command. To print it anyway, run %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wert wurde nicht ausgegeben: Dieses CI-Log würde eine Zeile davon als Befehl ausführen. Um ihn trotzdem auszugeben, führen Sie %1$@ aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur n’a pas été affichée : ce journal de CI exécuterait l’une de ses lignes comme une commande. Pour l’afficher quand même, exécutez %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha mostrado el valor: este registro de CI ejecutaría una de sus líneas como comando. Para mostrarlo de todos modos, ejecuta %1$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor não foi mostrado: este log de CI executaria uma linha dele como comando. Para mostrá-lo mesmo assim, execute %1$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore non è stato mostrato: questo log di CI eseguirebbe una sua riga come comando. Per mostrarlo comunque, esegui %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値を出力していません。このCIログでは、値の行がコマンドとして実行されます。それでも出力するには%1$@を実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값을 출력하지 않았어요. 이 CI 로그는 값의 한 줄을 명령으로 실행해요. 그래도 출력하려면 실행하세요: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未输出该值：此CI日志会将其中一行作为命令执行。如仍要输出，请运行%1$@。"
          }
        }
      }
    },
