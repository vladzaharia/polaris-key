          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung bestätigt. Kehren Sie zu dem Gerät zurück, auf dem Sie begonnen haben. Es meldet sich automatisch an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion confirmée. Revenez sur l’appareil où vous avez commencé. Il se connectera tout seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio de sesión confirmado. Vuelve al dispositivo donde empezaste. Iniciará sesión solo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso confirmado. Volte ao dispositivo onde você começou. Ele entra sozinho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso confermato. Torna al dispositivo da cui hai iniziato: accederà da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインを確認しました。開始したデバイスに戻ってください。自動的にサインインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인이 확인됐어요. 시작한 기기로 돌아가세요. 자동으로 로그인돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已确认。请回到你开始登录的设备，它会自动完成登录。"
          }
        }
      }
    },
    "signin.confirmLink.note": {
      "comment": "Page opened from the email's sign-in link on another device (SIGN-IN.md §3.4).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device that asked signs in, not this one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet wird das anfragende Gerät, nicht dieses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est l’appareil à l’origine de la demande qui se connecte, pas celui-ci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión el dispositivo que lo solicitó, no este."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem entra é o dispositivo que pediu, não este."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accederà il dispositivo che ha fatto la richiesta, non questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインするのはリクエスト元のデバイスで、このデバイスではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 아니라 요청한 기기가 로그인돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录的是发起请求的设备，而不是这台设备。"
          }
        }
      }
    },
    "signin.confirmLink.title": {
      "comment": "Page opened from the email's sign-in link on another device (SIGN-IN.md §3.4). Arguments: {time} = a duration or time already formatted by the platform (“4:12”, “2 min ago”); {place} = an approximate place (city, country). Arguments: 1=time, 2=place.",
