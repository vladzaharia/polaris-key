        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese método de inicio de sesión pertenece a otra cuenta de Polaris Key. Inicia sesión en esa cuenta o une las dos cuentas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse método de acesso pertence a outra conta do Polaris Key. Entre nessa conta ou una as duas contas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo metodo di accesso appartiene a un altro account Polaris Key. Accedi a quell'account o unisci i due account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサインイン方法は別のPolaris Keyアカウントに連携されています。そのアカウントにサインインするか、2つのアカウントを統合してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 로그인 방법은 다른 Polaris Key 계정에 속해 있어요. 그 계정으로 로그인하거나 두 계정을 합치세요."
