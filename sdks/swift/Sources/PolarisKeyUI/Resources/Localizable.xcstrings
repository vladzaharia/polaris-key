    "core.codes.release_tag_is_pack_release.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A release was skipped because its tag matches a content pack release. Rename the tag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Release wurde übersprungen, weil sein Tag mit einem Content-Pack-Release übereinstimmt. Benennen Sie den Tag um."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version a été ignorée, car son tag correspond à une version de pack de contenu. Renommez le tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitió una versión porque su etiqueta coincide con una versión de un paquete de contenido. Cambia el nombre de la etiqueta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lançamento foi ignorado porque a tag dele corresponde a um lançamento de pacote de conteúdo. Renomeie a tag."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una release è stata saltata perché il suo tag corrisponde a una release di un pacchetto di contenuti. Rinomina il tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグがコンテンツパックのリリースと一致するため、リリースをスキップしました。タグの名前を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
