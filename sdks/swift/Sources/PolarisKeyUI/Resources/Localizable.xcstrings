    "signin.device.doneLede": {
      "comment": "Device code approval on a phone or computer (SIGN-IN.md §3.11). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”. Arguments: 1=device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at %1$@: it continues by itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie auf %1$@ nach: Es fährt automatisch fort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez %1$@ : il continue tout seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira %1$@: continúa solo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhe para %1$@: ele continua sozinho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda %1$@: continua da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を確認してください。自動的に続行します。"
          }
