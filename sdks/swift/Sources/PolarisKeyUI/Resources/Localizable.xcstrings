    "core.codes.pack-state-unreadable.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed content couldn't be read, so nothing new was installed. Restart the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installierte Inhalte konnten nicht gelesen werden, daher wurde nichts Neues installiert. Starten Sie die App neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu installé n’a pas pu être lu, rien de nouveau n’a donc été installé. Redémarrez l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el contenido instalado, así que no se instaló nada nuevo. Reinicia la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o conteúdo instalado, então nada novo foi instalado. Reinicie o app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere i contenuti installati, quindi non è stato installato nulla di nuovo. Riavvia l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのコンテンツを読み取れなかったため、新しいコンテンツはインストールされませんでした。アプリを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 콘텐츠를 읽지 못해 새 콘텐츠를 설치하지 않았어요. 앱을 재시작하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已安装的内容，因此未安装任何新内容。请重启应用。"
          }
        }
      }
    },
