    "core.codes.email_mismatch.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This license belongs to an email address your account hasn't verified. Add and verify that email, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Lizenz gehört zu einer E-Mail-Adresse, die Ihr Konto nicht bestätigt hat. Fügen Sie diese E-Mail-Adresse hinzu, bestätigen Sie sie und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This license belongs to an email address your account hasn't verified. Add and verify that email, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licencia pertenece a una dirección de correo que tu cuenta no ha verificado. Añade y verifica ese correo, y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licença pertence a um endereço de e-mail que sua conta não verificou. Adicione e verifique esse e-mail e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa licenza appartiene a un indirizzo email che il tuo account non ha verificato. Aggiungi e verifica quell'email, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライセンスは、お使いのアカウントで確認されていないメールアドレスに紐付いています。そのメールアドレスを追加して確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이선스는 회원님 계정에서 인증하지 않은 이메일 주소에 속해 있어요. 해당 이메일을 추가하고 인증한 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此许可证属于你的账户尚未验证的电子邮件地址。请添加并验证该电子邮件，然后重试。"
          }
        }
      }
    },
