          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nuovo dispositivo ha effettuato l'accesso al tuo account Polaris Locker"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Lockerアカウントに新しいデバイスがサインインしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Locker 계정에 새 기기가 로그인했어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有新设备登录了你的Polaris Locker账户"
          }
        }
      }
    },
    "signin.mail.open": {
      "comment": "Security email (SIGN-IN.md §3.15).",
