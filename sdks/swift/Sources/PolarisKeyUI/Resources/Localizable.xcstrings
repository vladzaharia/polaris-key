    "signin.replace.consequence": {
      "comment": "Replace a device, inline in the license choice (SIGN-IN.md §3.7). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”; {product} = the product's name from ProductIdentity (never translated); {thisDevice} = the platform phrase for the current device (part.thisDevice, for example “this iPhone”). Arguments: 1=device, 2=product, 3=thisDevice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signs out of %2$@ and %3$@ takes its seat. %1$@ can sign in again later if a seat is free. We'll email you about it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird von %2$@ abgemeldet und %3$@ übernimmt den Platz. %1$@ kann sich später wieder anmelden, wenn ein Platz frei ist. Wir informieren Sie per E-Mail darüber."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sera déconnecté de %2$@ et %3$@ prendra sa place. %1$@ pourra se reconnecter plus tard si une place se libère. Nous vous enverrons un e-mail à ce sujet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará la sesión de %2$@ en %1$@ y %3$@ ocupará su plaza. %1$@ podrá volver a iniciar sesión más tarde si hay una plaza libre. Te lo notificaremos por correo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sai de %2$@ e %3$@ ocupa a vaga. %1$@ poderá entrar novamente depois, se houver uma vaga livre. Enviaremos um e-mail sobre isso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ esce da %2$@ e %3$@ ne prende il posto. %1$@ potrà accedere di nuovo in seguito se si libera un posto. Ti invieremo un'email al riguardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@からサインアウトし、%3$@がその枠を使用します。枠が空けば、%1$@は後で再びサインインできます。この件についてはメールでお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) %2$@에서 로그아웃되고 %3$@이(가) 그 자리를 사용해요. 자리가 비면 %1$@에서 나중에 다시 로그인할 수 있어요. 이 내용은 이메일로 알려 드려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@将退出登录%2$@，%3$@将占用它的席位。如有空余席位，%1$@之后可以重新登录。我们会通过电子邮件通知你。"
          }
        }
      }
    },
    "signin.replace.gone": {
      "comment": "Replace a device, inline in the license choice (SIGN-IN.md §3.7).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device was already removed. Choose again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wurde bereits entfernt. Wählen Sie erneut."
          }
        },
        "fr": {
