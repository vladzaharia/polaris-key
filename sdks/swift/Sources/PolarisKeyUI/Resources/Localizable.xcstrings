            "value": "もう一方のアカウント"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계정"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个账户"
          }
        }
      }
    },
    "signin.join.otherLede": {
      "comment": "Link dialog, second sign-in card: what happens next.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use any way to sign in to it. You'll come back here to join them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzen Sie dafür eine beliebige Methode. Danach kommen Sie hierher zurück, um beide zusammenzuführen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez n’importe quelle méthode. Vous reviendrez ici pour les fusionner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa cualquier forma de entrar. Volverás aquí para unirlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use qualquer forma de entrar. Você volta aqui para uni-las."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un modo qualsiasi per accedere. Tornerai qui per unirli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの方法でも構いません。その後ここに戻って2つをまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 방법으로 로그인해도 괜찮아요. 그런 다음 여기로 돌아와 두 계정을 합쳐요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任选一种方式登录，之后会回到这里合并。"
          }
        }
      }
    },
    "signin.join.otherTitle": {
      "comment": "Link dialog, second sign-in card: what this sign-in is for.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to your other account"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
