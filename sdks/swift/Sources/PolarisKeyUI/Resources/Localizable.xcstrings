    "devices.removeConfirm": {
      "comment": "Devices: the list of devices using the license. Inline confirm. Arguments: {device} = a device's friendly name, for example “Maya's MacBook”; {product} = the product's name from ProductIdentity (never translated). Arguments: 1=device, 2=product.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %1$@? It signs out of %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ entfernen? Das Gerät wird von %2$@ abgemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer %1$@ ? Il sera déconnecté de %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar %1$@? Se cerrará su sesión de %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %1$@? Ele sairá de %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere %1$@? Uscirà da %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を削除しますか？%2$@からサインアウトされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 제거할까요? %2$@에서 로그아웃돼요."
