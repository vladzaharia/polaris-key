          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave è pronta. Accedi o crea un account e %1$@ entra nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーの準備ができました。サインインまたはアカウントを作成すると、%1$@ がライブラリに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 준비됐어요. 로그인하거나 계정을 만들면 %1$@이(가) 라이브러리에 추가돼요."
