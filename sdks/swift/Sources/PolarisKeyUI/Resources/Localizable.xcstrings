    "core.activation.attestation-required.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, activation).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This license needs a verified device. Let the app check this device, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Lizenz erfordert ein verifiziertes Gerät. Lassen Sie die App dieses Gerät prüfen und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette licence nécessite un appareil vérifié. Laissez l’app vérifier cet appareil, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licencia requiere un dispositivo verificado. Deja que la app verifique este dispositivo y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licença exige um dispositivo verificado. Permita que o app verifique este dispositivo e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa licenza richiede un dispositivo verificato. Consenti all'app di verificare questo dispositivo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライセンスには確認済みのデバイスが必要です。アプリにこのデバイスを確認させてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이선스에는 인증된 기기가 필요해요. 앱이 이 기기를 확인하도록 허용한 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此许可证需要经过验证的设备。请允许应用验证此设备，然后重试。"
          }
        }
      }
    },
