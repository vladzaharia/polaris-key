    "signin.device.doneLede": {
      "comment": "Device code approval on a phone or computer (SIGN-IN.md §3.11). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”. Arguments: 1=device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
