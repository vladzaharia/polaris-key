    "core.codes.not_removable.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This license can't be added back with a key, so it stays in your library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Lizenz kann nicht mit einem Lizenzschlüssel wieder hinzugefügt werden, deshalb bleibt sie in Ihrer Bibliothek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette licence ne peut pas être ajoutée de nouveau avec une clé : elle reste donc dans votre bibliothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licencia no se puede volver a añadir con una clave de licencia, así que se queda en tu biblioteca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licença não pode ser adicionada de novo com uma chave de licença, então ela continua na sua biblioteca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa licenza non può essere aggiunta di nuovo con una chiave di licenza, quindi resta nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライセンスはライセンスキーで追加し直せないため、ライブラリに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이선스는 라이선스 키로 다시 추가할 수 없어서 라이브러리에 남아 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此许可证无法通过许可证密钥重新添加，因此会保留在你的资料库中。"
          }
        }
      }
    },
