    "core.codes.marker-rejected.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build's built-in content isn't valid. Reinstall the app or contact the developer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die integrierten Inhalte dieses Builds sind ungültig. Installieren Sie die App neu oder wenden Sie sich an den Entwickler."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu intégré de ce build n’est pas valide. Réinstallez l’app ou contactez le développeur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido integrado de esta compilación no es válido. Reinstala la app o contacta con el desarrollador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo integrado desta build não é válido. Reinstale o app ou contate o desenvolvedor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I contenuti integrati di questa build non sono validi. Reinstalla l'app o contatta lo sviluppatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドに組み込まれたコンテンツが無効です。アプリを再インストールするか、開発者に問い合わせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드의 내장 콘텐츠가 유효하지 않아요. 앱을 다시 설치하거나 개발자에게 문의하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的内置内容无效。请重新安装应用或联系开发者。"
          }
        }
      }
    },
