    "core.activation.device-limit.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, activation).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This license is already on all its devices. Replace a device to use it here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Lizenz ist bereits auf allen zulässigen Geräten in Gebrauch. Ersetzen Sie ein Gerät, um sie hier zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This license is already on all its devices. Replace a device to use it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licencia ya está en todos sus dispositivos. Reemplaza un dispositivo para usarla aquí."
