            "state": "translated",
            "value": "Alguien ocupó esa plaza antes. Vuelve a elegir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra pessoa ocupou essa vaga antes. Escolha novamente."
