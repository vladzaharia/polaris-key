    "signin.device.cancel": {
      "comment": "Device code approval on a phone or computer (SIGN-IN.md §3.11).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't start this yourself? Cancel it. Someone may be trying to use your account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben das nicht selbst gestartet? Brechen Sie es ab. Möglicherweise versucht jemand, Ihr Konto zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’êtes pas à l’origine de cette demande ? Annulez-la. Quelqu’un tente peut-être d’utiliser votre compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No lo iniciaste tú? Cancélalo. Puede que alguien esté intentando usar tu cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi você que iniciou isto? Cancele. Alguém pode estar tentando usar sua conta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sei stato tu ad avviare questa operazione? Annullala. Qualcuno potrebbe tentare di usare il tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身で開始していない場合はキャンセルしてください。誰かがあなたのアカウントを使用しようとしている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 시작하지 않았나요? 취소하세요. 누군가 회원님의 계정을 사용하려는 것일 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是你本人发起的？请取消。可能有人正试图使用你的账户。"
          }
        }
      }
    },
    "signin.device.done": {
      "comment": "Device code approval on a phone or computer (SIGN-IN.md §3.11). Arguments: {app} = the requesting app's name (never translated); {device} = a device's friendly name, for example “Maya's MacBook”. Arguments: 1=app, 2=device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
