        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many tries. Wait a minute, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Warten Sie eine Minute und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop d’essais. Attendez une minute, puis réessayez."
