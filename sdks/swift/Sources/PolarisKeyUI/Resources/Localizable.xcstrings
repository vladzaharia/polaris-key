    "core.codes.registration_closed.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New devices can't register right now. Activate with a license key or sign in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Geräte können sich derzeit nicht registrieren. Aktivieren Sie mit einem Lizenzschlüssel oder melden Sie sich an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
