          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erforderliche Inhalte konnten nicht heruntergeladen werden, daher kann die App nicht starten. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
