    "signin.join.reasonPending": {
      "comment": "Link dialog: an account was joined in the last 72 hours.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One account was joined in the last 72 hours. Try again after that."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eines der Konten wurde in den letzten 72 Stunden zusammengeführt. Versuchen Sie es danach erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte a été fusionné au cours des 72 dernières heures. Réessayez après ce délai."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta se unió en las últimas 72 horas. Inténtalo después."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta foi unida nas últimas 72 horas. Tente depois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un account è stato unito nelle ultime 72 ore. Riprova dopo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらかのアカウントが過去72時間以内にまとめられています。その後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 72시간 안에 합친 계정이 있어요. 72시간이 지난 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中一个账户在过去 72 小时内已合并。请在 72 小时后再试。"
          }
        }
      }
    },
    "signin.join.reasonStaleOne": {
      "comment": "Link dialog: one account's proof is older than 5 minutes. {email}. Arguments: 1=email.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to %1$@ again, then join."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
