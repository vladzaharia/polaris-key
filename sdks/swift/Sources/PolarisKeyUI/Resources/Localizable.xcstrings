    "core.codes.swap-refused.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This installation can't update itself. Update it the way you installed it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Installation kann sich nicht selbst aktualisieren. Aktualisieren Sie sie auf demselben Weg, auf dem Sie sie installiert haben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette installation ne peut pas se mettre à jour elle-même. Mettez-la à jour comme vous l’avez installée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta instalación no puede actualizarse sola. Actualízala de la misma forma en que la instalaste."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta instalação não pode se atualizar sozinha. Atualize-a da mesma forma que você a instalou."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa installazione non può aggiornarsi da sola. Aggiornala nello stesso modo in cui l'hai installata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このインストールは自動でアップデートできません。インストールしたときと同じ方法でアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설치본은 스스로 업데이트할 수 없어요. 설치한 방법으로 업데이트하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此安装无法自行更新。请通过你安装它的方式进行更新。"
          }
        }
      }
    },
