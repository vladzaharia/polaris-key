    "deviceLimit.lede": {
      "comment": "DeviceLimit, the Replace a device flow (SIGN-IN.md §3.7): the license is on all its devices. Arguments: {formFactor} = the device's form factor; each case is a whole phrase. Varies by device (formFactor).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "device": {
              "iphone": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To use it on this iPhone, replace one. You can add it back later."
                }
              },
              "ipad": {
                "stringUnit": {
                  "state": "translated",
                  "value": "To use it on this iPad, replace one. You can add it back later."
                }
