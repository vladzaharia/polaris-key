    "core.codes.files-unsafe-path.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some content was refused because it contains an unsafe file path."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Inhalte wurden abgelehnt, weil sie einen unsicheren Dateipfad enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Some content was refused because it contains an unsafe file path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazó parte del contenido porque contiene una ruta de archivo no segura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do conteúdo foi recusada porque contém um caminho de arquivo inseguro."
