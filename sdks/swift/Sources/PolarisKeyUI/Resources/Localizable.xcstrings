    "signin.approve.stepUpWhy": {
      "comment": "Approve dialog: why the person must confirm it's them first.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's asking from a different place than you're in now, or from a place we can't tell."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage kommt von einem anderen Ort als Ihrem aktuellen oder von einem unbekannten Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande provient d’un autre lieu que le vôtre, ou d’un lieu inconnu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud viene de un lugar distinto al tuyo, o de un lugar que no podemos identificar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pedido vem de um lugar diferente do seu, ou de um lugar que não conseguimos identificar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta arriva da un luogo diverso dal tuo, o da un luogo che non riconosciamo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまの場所とは別の場所、または場所を特定できない場所からのリクエストです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 계신 곳과 다른 곳이나 위치를 알 수 없는 곳에서 요청했어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求来自与你当前不同的位置，或无法确定的位置。"
          }
        }
      }
    },
