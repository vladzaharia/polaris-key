    "core.codes.license_unusable.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your license is no longer valid, so settings can't be loaded. Sign in or activate again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Lizenz ist nicht mehr gültig, daher können keine Einstellungen geladen werden. Melden Sie sich an oder aktivieren Sie erneut."
          }
        },
        "fr": {
