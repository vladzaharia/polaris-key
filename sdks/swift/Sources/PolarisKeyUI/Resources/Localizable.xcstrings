    "signin.approve.warning": {
      "comment": "Sign in with another device (SIGN-IN.md §3.11).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only approve if you started this yourself, on a device in front of you. Nobody from Polaris Locker or a developer will ever ask you for this."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genehmigen Sie nur, wenn Sie dies selbst auf einem Gerät vor Ihnen gestartet haben. Niemand von Polaris Locker oder einem Entwickler wird Sie jemals danach fragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’approuvez que si vous êtes à l’origine de cette demande, sur un appareil qui se trouve devant vous. Personne chez Polaris Locker ni aucun développeur ne vous le demandera jamais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apruébalo solo si lo iniciaste tú, en un dispositivo que tienes delante. Nadie de Polaris Locker ni ningún desarrollador te lo pedirá nunca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só aprove se foi você que iniciou isto, em um dispositivo à sua frente. Ninguém do Polaris Locker nem nenhum desenvolvedor vai pedir isso a você."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva solo se hai avviato tu questa operazione, su un dispositivo che hai davanti. Nessuno di Polaris Locker o di uno sviluppatore te lo chiederà mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身が目の前のデバイスで開始した場合にのみ承認してください。Polaris Lockerや開発者がこれを求めることは絶対にありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 시작했고 기기가 눈앞에 있을 때만 승인하세요. Polaris Locker나 개발자는 절대 이것을 요청하지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当是你本人在面前的设备上发起时才批准。Polaris Locker或任何开发者都不会向你索要此信息。"
          }
        }
      }
    },
