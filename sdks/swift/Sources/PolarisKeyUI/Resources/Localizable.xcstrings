        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile inviare altri codici per questo accesso. L'ultimo codice è ancora valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサインインでは、これ以上コードを送信できません。最新のコードは引き続き使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로그인에서는 더 이상 코드를 보낼 수 없어요. 마지막으로 받은 코드는 계속 사용할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次登录无法再发送验证码。最新的验证码仍然有效。"
          }
        }
      }
    },
    "signin.code.rateLimited": {
      "comment": "Code step: the verify's 429.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many tries. Wait a minute, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Warten Sie eine Minute und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives. Attendez une minute, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Espera un minuto y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas. Aguarde um minuto e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi. Attendi un minuto, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試行回数が多すぎます。1分待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시도 횟수가 너무 많아요. 1분 기다린 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试次数过多。请等待一分钟后重试。"
          }
        }
      }
    },
