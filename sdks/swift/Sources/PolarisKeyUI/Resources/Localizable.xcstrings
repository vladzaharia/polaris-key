    "boot.offline.playable": {
      "comment": "Boot screen, shown while the product starts. Optional content is missing but the product can start.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some content couldn't be downloaded. You can keep going with what's installed, or connect and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Inhalte konnten nicht heruntergeladen werden. Sie können mit den installierten Inhalten fortfahren oder eine Verbindung herstellen und es erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie du contenu n’a pas pu être téléchargée. Vous pouvez continuer avec ce qui est installé, ou vous connecter et réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descargar parte del contenido. Puedes seguir con lo que está instalado, o conectarte y volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível baixar parte do conteúdo. Você pode continuar com o que está instalado ou se conectar e tentar novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile scaricare alcuni contenuti. Puoi continuare con quelli installati oppure connetterti e riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のコンテンツをダウンロードできませんでした。インストール済みのコンテンツで続けるか、接続してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 콘텐츠를 다운로드하지 못했어요. 설치된 콘텐츠로 계속하거나 연결한 후 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分内容无法下载。你可以使用已安装的内容继续，或连接网络后重试。"
          }
        }
      }
    },
