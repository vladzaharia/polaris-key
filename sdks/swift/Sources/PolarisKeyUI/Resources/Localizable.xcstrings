    "core.codes.link_conflict.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That sign-in method belongs to another Polaris Key account. Sign in to that account, or join the two accounts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anmeldemethode gehört zu einem anderen Polaris Key-Konto. Melden Sie sich bei diesem Konto an oder führen Sie die beiden Konten zusammen."
          }
        },
        "fr": {
          "stringUnit": {
