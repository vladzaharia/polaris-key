    "core.codes.delta-apply-failed.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some content couldn't be installed. It will be downloaded again next time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Inhalte konnten nicht installiert werden. Sie werden beim nächsten Mal erneut heruntergeladen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains contenus n’ont pas pu être installés. Ils seront téléchargés à nouveau la prochaine fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo instalar parte del contenido. Se volverá a descargar la próxima vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível instalar parte do conteúdo. Ele será baixado novamente na próxima vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile installare alcuni contenuti. Verranno scaricati di nuovo la prossima volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のコンテンツをインストールできませんでした。次回もう一度ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 콘텐츠를 설치하지 못했어요. 다음에 다시 다운로드해요."
