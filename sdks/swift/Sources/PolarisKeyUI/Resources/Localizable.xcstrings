    "core.codes.client_mismatch.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sync belongs to another device. Restart the app and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Synchronisierung gehört zu einem anderen Gerät. Starten Sie die App neu und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette synchronisation appartient à un autre appareil. Redémarrez l'app et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sincronización pertenece a otro dispositivo. Reinicia la app e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sincronização pertence a outro dispositivo. Reinicie o app e tente de novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa sincronizzazione appartiene a un altro dispositivo. Riavvia l'app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この同期は別のデバイスのものです。アプリを再起動して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동기화는 다른 기기의 것입니다. 앱을 다시 시작한 뒤 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此同步属于另一台设备。请重新启动应用后再试。"
          }
        }
