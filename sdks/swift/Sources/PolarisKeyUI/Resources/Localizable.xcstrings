    "signin.replace.raced": {
      "comment": "Replace a device, inline in the license choice (SIGN-IN.md §3.7).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone replaced that device first. Choose again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand anderes hat dieses Gerät zuerst ersetzt. Wählen Sie erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu’un a remplacé cet appareil avant vous. Faites un autre choix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien reemplazó ese dispositivo antes. Vuelve a elegir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra pessoa substituiu esse dispositivo antes. Escolha novamente."
