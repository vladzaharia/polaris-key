    "signin.console.sessionEndedBody": {
      "comment": "Console operator sign-in (SIGN-IN.md §3.12).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again to carry on. Your unsaved changes stay in this tab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich erneut an, um fortzufahren. Ihre ungespeicherten Änderungen bleiben in diesem Tab erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous pour continuer. Vos modifications non enregistrées restent dans cet onglet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a iniciar sesión para continuar. Tus cambios sin guardar se mantienen en esta pestaña."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre novamente para continuar. Suas alterações não salvas ficam nesta aba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi di nuovo per continuare. Le modifiche non salvate restano in questa scheda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるにはもう一度サインインしてください。未保存の変更はこのタブに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 다시 로그인하세요. 저장하지 않은 변경 사항은 이 탭에 남아 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新登录以继续。未保存的更改会保留在此标签页中。"
          }
        }
      }
    },
