            "value": "The licensing service can't be reached. You can keep using the app until the grace period ends."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Lizenzierungsdienst ist nicht erreichbar. Sie können die App bis zum Ende der Kulanzzeit weiter verwenden."
