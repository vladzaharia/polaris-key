    "signin.replace.consequence": {
      "comment": "Replace a device, inline in the license choice (SIGN-IN.md §3.7). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”; {product} = the product's name from ProductIdentity (never translated); {thisDevice} = the platform phrase for the current device (part.thisDevice, for example “this iPhone”). Arguments: 1=device, 2=product, 3=thisDevice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signs out of %2$@ and %3$@ takes its place. We'll email you about it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wird von %2$@ abgemeldet und durch %3$@ ersetzt. Wir informieren Sie per E-Mail darüber."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sera déconnecté de %2$@ et %3$@ le remplacera. Nous vous enverrons un e-mail à ce sujet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará la sesión de %2$@ en %1$@ y %3$@ ocupará su lugar. Te lo notificaremos por correo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sai de %2$@ e %3$@ entra no lugar dele. Enviaremos um e-mail sobre isso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ esce da %2$@ e %3$@ lo sostituisce. Ti invieremo un'email al riguardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%2$@からサインアウトされ、代わりに%3$@が使われます。この件についてはメールでお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) %2$@에서 로그아웃되고 %3$@이(가) 대신 사용돼요. 이 내용은 이메일로 알려 드려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
