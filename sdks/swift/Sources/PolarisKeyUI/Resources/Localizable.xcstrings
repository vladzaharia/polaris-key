    "core.codes.delta-base-mismatch.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed content changed on this device, so a full download is needed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installierte Inhalte wurden auf diesem Gerät geändert, daher ist ein vollständiger Download erforderlich."
          }
        },
        "fr": {
          "stringUnit": {
