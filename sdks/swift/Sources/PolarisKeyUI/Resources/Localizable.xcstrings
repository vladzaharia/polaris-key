        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile sincronizzare. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期できませんでした。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
