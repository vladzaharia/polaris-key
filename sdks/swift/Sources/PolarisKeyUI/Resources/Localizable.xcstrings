    "core.codes.pack-rolled-back.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last content update didn't start, so the previous version was restored."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das letzte Inhalts-Update ließ sich nicht starten, daher wurde die vorherige Version wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière mise à jour du contenu n’a pas démarré, la version précédente a donc été restaurée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última actualización de contenido no se inició, así que se restauró la versión anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última atualização de conteúdo não iniciou, então a versão anterior foi restaurada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultimo aggiornamento dei contenuti non si è avviato, quindi è stata ripristinata la versione precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のコンテンツアップデートが起動しなかったため、以前のバージョンに戻しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 콘텐츠 업데이트가 시작되지 않아 이전 버전으로 복원했어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次内容更新未能启动，已恢复到之前的版本。"
          }
        }
      }
    },
