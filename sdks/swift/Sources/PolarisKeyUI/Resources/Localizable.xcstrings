          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è stato rimosso, ma qualcun altro ha occupato prima il posto. Scegli di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は削除されましたが、先に別のデバイスがその枠を使用しました。もう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) 제거했지만 다른 사람이 먼저 자리를 차지했어요. 다시 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@已移除，但有人先占用了该席位。请重新选择。"
          }
        }
      }
    },
