        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ · %3$@は%5$@台中%4$@台目のデバイスになります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
