    "signin.key.onrampLede": {
      "comment": "Have a license key? step, under the title.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the key from your receipt email. Sign in next, and it joins your library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie den Schlüssel aus Ihrer Bestätigungs-E-Mail ein. Melden Sie sich danach an, und er kommt in Ihre Bibliothek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez la clé de votre reçu par e-mail. Connectez-vous ensuite pour l’ajouter à votre bibliothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega la clave de tu correo de recibo. Inicia sesión después y se añade a tu biblioteca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole a chave do seu e-mail de recibo. Entre em seguida e ela entra na sua biblioteca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla la chiave dall'email della ricevuta. Poi accedi e il prodotto entrerà nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "領収メールのキーを貼り付けてください。次にサインインすると、ライブラリに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영수증 이메일의 키를 붙여 넣으세요. 이어서 로그인하면 라이브러리에 추가돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴收据邮件中的密钥。接着登录，它就会加入你的资料库。"
          }
        }
      }
    },
