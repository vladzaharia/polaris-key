      "comment": "Replace a device, inline in the license choice (SIGN-IN.md §3.7).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone took that seat first. Choose again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand anderes hat diesen Platz zuerst belegt. Wählen Sie erneut."
