    "signin.gate.ledeApp": {
      "comment": "Confirm-your-email step after a first provider sign-in (SIGN-IN.md §3.5). Arguments: {app} = the requesting app's name (never translated). Arguments: 1=app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One step before %1$@. We send sign-in codes, receipts and security notices here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch ein Schritt bis %1$@. Wir senden Anmeldecodes, Belege und Sicherheitshinweise an diese Adresse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dernière étape avant %1$@. Nous y envoyons les codes de connexion, les reçus et les alertes de sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paso antes de %1$@. Aquí enviamos códigos de inicio de sesión, recibos y avisos de seguridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta uma etapa para %1$@. Enviamos códigos de acesso, recibos e avisos de segurança para cá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ultimo passaggio prima di %1$@. Qui inviamo codici di accesso, ricevute e avvisi di sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@まであと1ステップです。サインインコード、領収書、セキュリティ通知はこのアドレスに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 이용 전 마지막 단계예요. 로그인 코드, 영수증, 보안 알림을 이 주소로 보내 드려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入%1$@前还需一步。我们会将登录验证码、收据和安全通知发送到这里。"
          }
        }
      }
    },
