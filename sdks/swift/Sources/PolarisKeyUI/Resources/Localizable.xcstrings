    "signin.key.noEntries": {
      "comment": "License key step (SIGN-IN.md §3.9). Arguments: {product} = the product's name from ProductIdentity (never translated). Arguments: 1=product.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key has no entries left in %1$@. Add it to your account and %1$@ signs you in instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Schlüssel sind in %1$@ keine Eingaben mehr übrig. Fügen Sie ihn Ihrem Konto hinzu, dann meldet %1$@ Sie stattdessen an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé n’a plus de saisies disponibles dans %1$@. Ajoutez-la à votre compte et %1$@ vous connectera à la place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A esta clave no le quedan usos en %1$@. Añádela a tu cuenta y %1$@ iniciará tu sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave não tem mais usos em %1$@. Adicione-a à sua conta e entre em %1$@ com sua conta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chiave non ha più inserimenti disponibili in %1$@. Aggiungila al tuo account e %1$@ ti farà accedere in quel modo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーは%1$@での入力回数が残っていません。アカウントに追加すると、代わりにサインインで%1$@を使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키는 %1$@에서 남은 등록 횟수가 없어요. 계정에 추가하면 %1$@에서 로그인으로 사용할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密钥在%1$@中已没有剩余的输入次数。将它添加到你的账户后，%1$@会改为让你登录。"
          }
        }
      }
    },
    "signin.key.noEntriesKeeps": {
      "comment": "PX-14a: the app card (SIGN-IN.md §3.6 to §3.9). Arguments: {product} = the product's name from ProductIdentity (never translated). Arguments: 1=product.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ keeps working on the devices it's already on. Only typing the key again needs an account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ läuft auf den Geräten weiter, auf denen es bereits installiert ist. Ein Konto ist nur nötig, um den Schlüssel erneut einzugeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continue de fonctionner sur les appareils où il est déjà. Seule une nouvelle saisie de la clé nécessite un compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sigue funcionando en los dispositivos donde ya está. Solo volver a escribir la clave requiere una cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continua funcionando nos dispositivos em que já está. Só digitar a chave de novo exige uma conta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ continua a funzionare sui dispositivi su cui è già attivo. Serve un account solo per inserire di nuovo la chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は、すでに入っているデバイスでそのまま使えます。キーをもう一度入力する場合だけアカウントが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 이미 사용 중인 기기에서 계속 작동해요. 키를 다시 입력할 때만 계정이 필요해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在已安装的设备上继续可用。只有再次输入密钥才需要账户。"
          }
        }
      }
    },
