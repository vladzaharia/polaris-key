    "signin.join.ownedNotice": {
      "comment": "Activate dialog, license_owned refusal, signed in on the portal (SIGN-IN.md D-27).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If that account is yours too, sign in to it and join the two."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Konto auch Ihnen gehört, melden Sie sich dort an und führen Sie beide zusammen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ce compte est aussi le vôtre, connectez-vous à ce compte et fusionnez les deux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esa cuenta también es tuya, inicia sesión en ella y une las dos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se essa conta também é sua, entre nela e una as duas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se anche quell'account è tuo, accedi e unisci i due."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアカウントもあなたのものなら、サインインして2つをまとめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 계정도 본인 것이면 로그인해 두 계정을 합치세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果那个账户也是你的，请登录并合并两者。"
          }
        }
      }
    },
