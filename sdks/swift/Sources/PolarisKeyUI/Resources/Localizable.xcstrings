    "core.codes.license_owned.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes). Arguments: 1=product.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ license is already in another Polaris Key account. A license never moves by its key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Lizenz für %1$@ befindet sich bereits in einem anderen Polaris Key-Konto. Eine Lizenz wird nie über ihren Schlüssel übertragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This %1$@ license is already in another Polaris Key account. A license never moves by its key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licencia de %1$@ ya está en otra cuenta de Polaris Key. Una licencia nunca se transfiere con su clave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licença de %1$@ já está em outra conta do Polaris Key. Uma licença nunca é transferida pela chave."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa licenza di %1$@ è già in un altro account Polaris Key. Una licenza non si sposta mai tramite la sua chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この%1$@のライセンスは、すでに別のPolaris Keyアカウントにあります。ライセンスがキーによって移動することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %1$@ 라이선스는 이미 다른 Polaris Key 계정에 있어요. 라이선스는 키로 옮겨지지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此%1$@许可证已在另一个Polaris Key账户中。许可证不会通过密钥转移。"
          }
        }
      }
    },
