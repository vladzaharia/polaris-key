    "signin.join.reasonUnavailable": {
      "comment": "Link dialog: a scheduled deletion blocks the join.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel the scheduled deletion first, then join."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brechen Sie zuerst die geplante Löschung ab und führen Sie dann zusammen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez d’abord la suppression programmée, puis fusionnez les comptes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela primero la eliminación programada y luego únelas."
          }
        },
