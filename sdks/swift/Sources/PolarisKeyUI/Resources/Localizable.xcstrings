          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライセンスのデバイスは%1$@が管理しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이선스의 기기는 %1$@에서 관리해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@负责管理此许可证的设备。"
