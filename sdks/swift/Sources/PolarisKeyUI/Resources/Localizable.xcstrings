    "core.codes.cursor_expired.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device hasn't synced in too long. It will start over from your saved data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wurde zu lange nicht synchronisiert. Es beginnt neu mit Ihren gespeicherten Daten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne s'est pas synchronisé depuis trop longtemps. Il repartira de vos données enregistrées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo lleva demasiado sin sincronizarse. Empezará de nuevo con tus datos guardados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo ficou tempo demais sem sincronizar. Ele vai recomeçar com seus dados salvos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non si sincronizza da troppo tempo. Ripartirà dai tuoi dati salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは長い間同期されていません。保存済みのデータから最初からやり直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 너무 오래 동기화되지 않았습니다. 저장된 데이터에서 처음부터 다시 시작합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备太久没有同步。它将从你已保存的数据重新开始。"
          }
        }
      }
    },
