    "signin.key.upgradeLede": {
      "comment": "PX-14a: the app card (SIGN-IN.md §3.6 to §3.9).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In an account you can get it back and move it to a new device yourself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einem Konto können Sie es zurückholen und selbst auf ein neues Gerät übertragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un compte, vous pouvez le récupérer et le transférer vous-même sur un nouvel appareil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una cuenta puedes recuperarlo y pasarlo tú mismo a un dispositivo nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em uma conta, você pode recuperá-la e passá-la para um novo dispositivo por conta própria."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In un account puoi recuperarlo e spostarlo su un nuovo dispositivo da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントに保管すると、再取得したり、新しいデバイスへ自分で移したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에 보관하면 다시 받거나 새 기기로 직접 옮길 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在账户中后，你可以找回它，也可以自己将它移到新设备。"
          }
        }
      }
    },
