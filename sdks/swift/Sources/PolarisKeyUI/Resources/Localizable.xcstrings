    "signin.handoff.browserBody": {
      "comment": "App waiting while sign-in runs in the browser (SIGN-IN.md §3.17). Arguments: {app} = the requesting app's name (never translated). Arguments: 1=app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We opened Polaris Key in your browser. Sign in there and %1$@ continues by itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben Polaris Key in Ihrem Browser geöffnet. Melden Sie sich dort an, dann fährt %1$@ automatisch fort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons ouvert Polaris Key dans votre navigateur. Connectez-vous-y et %1$@ continuera tout seul."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrimos Polaris Key en tu navegador. Inicia sesión allí y %1$@ continuará solo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrimos o Polaris Key no seu navegador. Entre por lá e %1$@ continua sozinho."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo aperto Polaris Key nel browser. Accedi lì e %1$@ continuerà da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザでPolaris Keyを開きました。そこでサインインすると、%1$@が自動的に続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저에서 Polaris Key를 열었어요. 거기서 로그인하면 %1$@에서 자동으로 계속 진행돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们已在你的浏览器中打开Polaris Key。在那里登录后，%1$@会自动继续。"
          }
        }
      }
    },
