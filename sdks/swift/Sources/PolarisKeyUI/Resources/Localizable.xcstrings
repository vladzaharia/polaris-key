    "signin.approve.expired": {
      "comment": "Sign in with another device (SIGN-IN.md §3.11).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code expired. Get a new code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist abgelaufen. Fordern Sie einen neuen Code an."
