    "signin.join.reasonStepUp": {
      "comment": "Link dialog: a proof is older than 5 minutes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to both accounts again, then join."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich bei beiden Konten erneut an und führen Sie sie dann zusammen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
