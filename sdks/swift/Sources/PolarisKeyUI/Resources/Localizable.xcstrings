    "cli.identityOff.fix": {
      "comment": "Terminal sign-in: what to do instead when the product has no sign-in. {command} is a command line such as 'tidewater activate'. Arguments: 1=command.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run %1$@ with your license key."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie %1$@ mit Ihrem Lizenzschlüssel aus."
          }
