    "signin.choice.noneReplaceable": {
      "comment": "Choose a license for this device (SIGN-IN.md §3.6). Arguments: {developer} = the developer's name (never translated). Arguments: 1=developer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ manages devices for these licenses. Ask %1$@ to free one, or use another license."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ verwaltet die Geräte für diese Lizenzen. Bitten Sie %1$@, eines freizugeben, oder verwenden Sie eine andere Lizenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gère les appareils de ces licences. Demandez à %1$@ d’en libérer un, ou utilisez une autre licence."
          }
