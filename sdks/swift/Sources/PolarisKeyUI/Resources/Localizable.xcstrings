      "comment": "Hosted sign-in card (SIGN-IN.md). Arguments: {app} = the requesting app's name (never translated); {developer} = the developer's name (never translated). Arguments: 1=app, 2=developer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Key signs you in for %1$@. %2$@ never sees your codes or passkeys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Key meldet Sie bei %1$@ an. %2$@ sieht Ihre Codes oder Passkeys nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Key vous connecte à %1$@. %2$@ ne voit jamais vos codes ni vos clés d’accès."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Key inicia tu sesión en %1$@. %2$@ nunca ve tus códigos ni tus llaves de acceso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Polaris Key faz seu acesso ao %1$@. %2$@ nunca vê seus códigos nem suas chaves de acesso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Key gestisce il tuo accesso a %1$@. %2$@ non vede mai i tuoi codici o le tue passkey."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Keyが%1$@へのサインインを行います。%2$@にコードやパスキーが知られることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Key가 %1$@ 로그인을 처리해요. %2$@에게는 코드나 패스키가 절대 공개되지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Key为%1$@提供登录服务。%2$@永远不会看到你的验证码或通行密钥。"
          }
        }
      }
    },
