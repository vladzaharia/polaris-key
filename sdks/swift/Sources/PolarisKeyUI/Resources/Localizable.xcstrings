          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione è in pausa per un momento. Le tue modifiche restano salvate e verranno sincronizzate più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期は少しの間一時停止されています。変更は保持され、後で同期されます。"
          }
