    "cloudSync.conflict": {
      "comment": "CloudSyncStatus: a small sync status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some changes conflict. Review them."
          }
        },
