    "signin.mail.replaced.body": {
      "comment": "Security email (SIGN-IN.md §3.15). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”; {newDevice} = the new device's friendly name; {product} = the product's name from ProductIdentity (never translated); {date} = a date already formatted by the platform. Arguments: 1=device, 2=newDevice, 3=product, 4=date.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was replaced by %2$@ when you signed in to %3$@ on %4$@. It can sign in again later if a seat is free. If this wasn't you, open Polaris Key and check your devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde durch %2$@ ersetzt, als Sie sich am %4$@ bei %3$@ angemeldet haben. Es kann sich später wieder anmelden, wenn ein Platz frei ist. Falls Sie das nicht waren, öffnen Sie Polaris Key und prüfen Sie Ihre Geräte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a été remplacé par %2$@ lorsque vous vous êtes connecté à %3$@ le %4$@. Il pourra se reconnecter plus tard si une place se libère. Si ce n’était pas vous, ouvrez Polaris Key et vérifiez vos appareils."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ reemplazó a %1$@ cuando iniciaste sesión en %3$@ el %4$@. %1$@ podrá volver a iniciar sesión más tarde si hay una plaza libre. Si no fuiste tú, abre Polaris Key y revisa tus dispositivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ foi substituído por %2$@ quando você entrou no %3$@ em %4$@. Ele poderá entrar novamente depois, se houver uma vaga livre. Se não foi você, abra o Polaris Key e verifique seus dispositivos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è stato sostituito da %2$@ quando hai effettuato l'accesso a %3$@ il %4$@. Potrà accedere di nuovo in seguito se si libera un posto. Se non sei stato tu, apri Polaris Key e controlla i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%4$@に%3$@にサインインした際、%1$@は%2$@に置き換えられました。枠が空けば、後で再びサインインできます。心当たりがない場合は、Polaris Keyを開いてデバイスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%4$@에 %3$@에 로그인하면서 %1$@ 대신 %2$@ 기기가 등록됐어요. 자리가 비면 나중에 다시 로그인할 수 있어요. 본인이 아니라면 Polaris Key를 열고 기기를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你于%4$@登录%3$@时，%1$@被%2$@替换。如有空余席位，它之后可以重新登录。如果这不是你本人操作，请打开Polaris Key检查你的设备。"
          }
        }
      }
    },
    "signin.mail.replaced.subject": {
      "comment": "Security email (SIGN-IN.md §3.15). Arguments: {product} = the product's name from ProductIdentity (never translated); {device} = a device's friendly name, for example “Maya's MacBook”. Arguments: 1=product, 2=device.",
