            "value": "Accedi al tuo altro account"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のアカウントにサインイン"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계정에 로그인"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录你的另一个账户"
