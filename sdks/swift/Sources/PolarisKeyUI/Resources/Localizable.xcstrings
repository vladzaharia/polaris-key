    "core.codes.chunks-unsupported-version.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This content needs a newer version of the app. Update the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Inhalte erfordern eine neuere Version der App. Aktualisieren Sie die App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contenu nécessite une version plus récente de l’app. Mettez l’app à jour."
