    "core.codes.device_limit.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This license is already on all its devices. Replace a device to use it here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Lizenz ist bereits auf allen zulässigen Geräten in Gebrauch. Ersetzen Sie ein Gerät, um sie hier zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "This license is already on all its devices. Replace a device to use it here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licencia ya está en todos sus dispositivos. Reemplaza un dispositivo para usarla aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta licença já está em todos os dispositivos permitidos. Substitua um dispositivo para usá-la aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa licenza è già in uso su tutti i dispositivi consentiti. Sostituisci un dispositivo per usarla qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライセンスはすべてのデバイス枠が使用中です。ここで使うにはデバイスを置き換えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이선스는 이미 모든 기기에서 사용 중이에요. 여기에서 사용하려면 기기를 교체하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此许可证已用满所有设备。请替换一台设备以在此使用。"
          }
        }
      }
    },
