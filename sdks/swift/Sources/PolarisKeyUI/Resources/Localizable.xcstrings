    "core.codes.network-error.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach Polaris Locker. Check your connection and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Locker ist nicht erreichbar. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Polaris Locker. Vérifiez votre connexion, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con Polaris Locker. Revisa tu conexión y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o Polaris Locker. Verifique sua conexão e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere Polaris Locker. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Lockerに接続できません。接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Polaris Locker에 연결할 수 없어요. 연결 상태를 확인하고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到Polaris Locker。请检查网络连接后重试。"
          }
        }
      }
    },
