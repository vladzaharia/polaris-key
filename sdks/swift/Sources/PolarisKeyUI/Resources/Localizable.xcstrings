    "signin.mail.replaced.body": {
      "comment": "Security email (SIGN-IN.md §3.15). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”; {newDevice} = the new device's friendly name; {product} = the product's name from ProductIdentity (never translated); {date} = a date already formatted by the platform. Arguments: 1=device, 2=newDevice, 3=product, 4=date.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ was replaced by %2$@ when you signed in to %3$@ on %4$@. It can sign in again later if there is room for another device. If this wasn't you, open Polaris Locker and check your devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde durch %2$@ ersetzt, als Sie sich am %4$@ bei %3$@ angemeldet haben. Das Gerät kann sich später wieder anmelden, wenn Platz für ein weiteres Gerät frei ist. Falls Sie das nicht waren, öffnen Sie Polaris Locker und prüfen Sie Ihre Geräte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a été remplacé par %2$@ lorsque vous vous êtes connecté à %3$@ le %4$@. Il pourra se reconnecter plus tard s’il reste de la place pour un autre appareil. Si ce n’était pas vous, ouvrez Polaris Locker et vérifiez vos appareils."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ reemplazó a %1$@ cuando iniciaste sesión en %3$@ el %4$@. %1$@ podrá volver a iniciar sesión más tarde si hay espacio para otro dispositivo. Si no fuiste tú, abre Polaris Locker y revisa tus dispositivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ foi substituído por %2$@ em %4$@, quando você entrou em %3$@. Ele poderá entrar novamente depois, se houver espaço para outro dispositivo. Se não foi você, abra o Polaris Locker e verifique seus dispositivos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è stato sostituito da %2$@ quando hai effettuato l'accesso a %3$@ il %4$@. Potrà accedere di nuovo in seguito se c'è spazio per un altro dispositivo. Se non sei stato tu, apri Polaris Locker e controlla i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%4$@に%3$@にサインインした際、%1$@は%2$@に置き換えられました。デバイスを追加できる空きができれば、%1$@は後で再びサインインできます。心当たりがない場合は、Polaris Lockerを開いてデバイスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%4$@에 %3$@에 로그인하면서 %1$@이(가) %2$@(으)로 교체됐어요. 기기를 추가할 여유가 생기면 %1$@에서 나중에 다시 로그인할 수 있어요. 본인이 아니라면 Polaris Locker를 열고 기기를 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你于%4$@登录%3$@时，%1$@已被%2$@替换。如果许可证还能再添加设备，%1$@之后可以重新登录。如果这不是你本人操作，请打开Polaris Locker检查你的设备。"
          }
        }
      }
    },
    "signin.mail.replaced.subject": {
      "comment": "Security email (SIGN-IN.md §3.15). Arguments: {product} = the product's name from ProductIdentity (never translated); {device} = a device's friendly name, for example “Maya's MacBook”. Arguments: 1=product, 2=device.",
