    "boot.rolledBack": {
      "comment": "Boot screen, shown while the product starts. Shown once after an automatic rollback.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last update didn't start, so the previous version was restored."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das letzte Update ließ sich nicht starten, daher wurde die vorherige Version wiederhergestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière mise à jour n’a pas démarré : la version précédente a donc été restaurée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última actualización no se inició, así que se restauró la versión anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última atualização não iniciou, então a versão anterior foi restaurada."
