    "core.codes.device-management-unsupported.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices can't be managed from here. Manage them in your account."
          }
        },
