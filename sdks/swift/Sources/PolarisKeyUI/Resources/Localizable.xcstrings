    "update.revokedContent": {
      "comment": "UpdatePrompt: an app update. Required content was withdrawn by the developer. Arguments: {product} = the product's name from ProductIdentity (never translated). Arguments: 1=product.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of %1$@'s content was withdrawn and can't be used. Update %1$@ to keep going."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Inhalte von %1$@ wurden zurückgezogen und können nicht verwendet werden. Aktualisieren Sie %1$@, um fortzufahren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie du contenu de %1$@ a été retirée et ne peut plus être utilisée. Mettez à jour %1$@ pour continuer."
