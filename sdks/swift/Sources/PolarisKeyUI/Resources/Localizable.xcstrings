    "a11y.code": {
      "comment": "Screen reader label; never shown. Reads the code; the kit spells it out character by character. Arguments: {code} = a code shown to the person (a user code or an error code); never split or translated. Arguments: 1=code.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in code %1$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldecode %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code de connexion %1$@"
          }
