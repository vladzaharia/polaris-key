    "signin.key.carriedLede": {
      "comment": "Sign-in card when a license key is carried. Arguments: {product} = the product's name. Arguments: 1=product.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your key is ready. Sign in or create an account, and %1$@ joins your library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Schlüssel ist bereit. Melden Sie sich an oder erstellen Sie ein Konto, und %1$@ kommt in Ihre Bibliothek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
