            "state": "translated",
            "value": "Execute %1$@ com a sua chave de licença."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui %1$@ con la tua chiave di licenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライセンスキーを使って%1$@を実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스 키로 %1$@을(를) 실행하세요."
