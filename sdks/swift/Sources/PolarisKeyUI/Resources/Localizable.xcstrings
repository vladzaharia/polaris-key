    "signin.gate.ledeApp": {
      "comment": "Confirm-your-email step after a first provider sign-in (SIGN-IN.md §3.5). Arguments: {app} = the requesting app's name (never translated). Arguments: 1=app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One step before %1$@. We send sign-in codes, receipts and security notices here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch ein Schritt bis %1$@. Wir senden Anmeldecodes, Belege und Sicherheitshinweise an diese Adresse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une dernière étape avant %1$@. Nous y envoyons les codes de connexion, les reçus et les alertes de sécurité."
          }
        },
        "es": {
          "stringUnit": {
