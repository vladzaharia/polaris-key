    "deviceLimit.noManage": {
      "comment": "DeviceLimit on the key path when the server sent no link to replace a device: the license is on all its devices, so the fix is to free one first. Arguments: {product} = the product's name from ProductIdentity (never translated). Arguments: 1=product.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out of %1$@ on another device, then try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich auf einem anderen Gerät von %1$@ ab und versuchen Sie es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnectez-vous de %1$@ sur un autre appareil, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra sesión de %1$@ en otro dispositivo y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saia de %1$@ em outro dispositivo e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci da %1$@ su un altro dispositivo, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスで%1$@からサインアウトしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기의 %1$@에서 로그아웃한 다음 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在另一台设备上退出登录%1$@，然后重试。"
          }
        }
      }
    },
