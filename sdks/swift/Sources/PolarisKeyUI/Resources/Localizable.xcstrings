    "signin.email.body": {
      "comment": "Sign-in email body (SIGN-IN.md §3.15).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or sign in with the button. The code and the link work once, for 10 minutes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oder melden Sie sich über die Schaltfläche an. Code und Link sind einmal und 10 Minuten lang gültig."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou connectez-vous avec le bouton. Le code et le lien ne fonctionnent qu’une fois, pendant 10 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O inicia sesión con el botón. El código y el enlace funcionan una sola vez, durante 10 minutos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou entre com o botão. O código e o link funcionam uma vez, por 10 minutos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppure accedi con il pulsante. Il codice e il link funzionano una sola volta, per 10 minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "またはボタンからサインインしてください。コードとリンクは1回限り、10分間有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또는 버튼으로 로그인하세요. 코드와 링크는 10분 동안 한 번만 사용할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "或点击按钮登录。验证码和链接仅可使用一次，10分钟内有效。"
          }
        }
      }
    },
