        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gerencia os dispositivos destas licenças. Peça a %1$@ para liberar um ou use outra licença."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gestisce i dispositivi di queste licenze. Chiedi a %1$@ di liberarne uno o usa un'altra licenza."
