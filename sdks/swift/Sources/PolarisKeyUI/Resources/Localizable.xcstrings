          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous à %1$@, puis fusionnez les comptes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión de nuevo en %1$@ y luego únelas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre de novo em %1$@ e depois una."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi di nuovo a %1$@, poi unisci gli account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ に再度サインインしてから、まとめてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 다시 로그인한 뒤 합치세요."
          }
        },
