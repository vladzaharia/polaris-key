    "signin.replace.racedAfterFree": {
      "comment": "Replace a device, inline in the license choice (SIGN-IN.md §3.7). Arguments: {device} = a device's friendly name, for example “Maya's MacBook”. Arguments: 1=device.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
