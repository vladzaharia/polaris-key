    "signin.refused.lede": {
      "comment": "Sign-in card, account disabled. Arguments: {email} = an address. Arguments: 1=email.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ belongs to an account that can't sign in. Try a different email or another way to sign in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gehört zu einem Konto, das sich nicht anmelden kann. Versuchen Sie eine andere E-Mail-Adresse oder eine andere Anmeldeart."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ appartient à un compte qui ne peut pas se connecter. Essayez une autre adresse e-mail ou une autre méthode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pertenece a una cuenta que no puede iniciar sesión. Prueba con otro correo o con otra forma de iniciar sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pertence a uma conta que não pode entrar. Tente outro e-mail ou outra forma de entrar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ appartiene a un account che non può accedere. Prova un'altra email o un altro modo per accedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ はサインインできないアカウントに属しています。別のメールアドレスまたは別の方法をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@은(는) 로그인할 수 없는 계정에 속해 있어요. 다른 이메일이나 다른 로그인 방법을 사용해 보세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 属于无法登录的账户。请尝试其他邮箱或其他登录方式。"
          }
        }
      }
    },
