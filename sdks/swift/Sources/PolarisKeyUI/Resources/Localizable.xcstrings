    "signin.choice.allFull": {
      "comment": "Choose a license for this device (SIGN-IN.md §3.6).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your licenses are on all their devices. Replace a device to use one here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Lizenzen sind auf allen zulässigen Geräten belegt. Ersetzen Sie ein Gerät, um hier eine zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos licences sont utilisées sur tous leurs appareils. Remplacez un appareil pour en utiliser une ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus licencias están en todos sus dispositivos. Reemplaza un dispositivo para usar una aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas licenças estão em todos os dispositivos permitidos. Substitua um dispositivo para usar uma aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue licenze sono in uso su tutti i dispositivi consentiti. Sostituisci un dispositivo per usarne una qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お持ちのライセンスはすべてのデバイス枠が使用中です。ここで使うにはデバイスを置き換えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이선스가 모든 기기에서 사용 중이에요. 여기에서 사용하려면 기기를 교체하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的许可证已用满所有设备。替换一台设备即可在此使用。"
          }
        }
      }
    },
    "signin.choice.allFullCreate": {
      "comment": "Choose a license for this device (SIGN-IN.md §3.6).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your licenses are on all their devices. Replace a device, or create a new free license."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Lizenzen sind auf allen zulässigen Geräten belegt. Ersetzen Sie ein Gerät oder erstellen Sie eine neue kostenlose Lizenz."
