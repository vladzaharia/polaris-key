    "signin.choice.replaceSafety": {
      "comment": "PX-14a: the app card (SIGN-IN.md §3.6 to §3.9). Arguments: {app} = the requesting app's name (never translated). Arguments: 1=app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device you choose signs out of %1$@. It can sign in again later if there's room. We'll email you about it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gewählte Gerät wird von %1$@ abgemeldet. Es kann sich später wieder anmelden, wenn Platz ist. Wir benachrichtigen Sie per E-Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil choisi sera déconnecté de %1$@. Il pourra se reconnecter plus tard s’il y a de la place. Nous vous préviendrons par e-mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo que elijas cerrará sesión en %1$@. Podrá iniciar sesión de nuevo más tarde si hay espacio. Te avisaremos por correo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo escolhido sai de %1$@. Ele poderá entrar de novo mais tarde se houver espaço. Avisaremos você por e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo scelto esce da %1$@. Potrà accedere di nuovo più tardi se c'è spazio. Ti invieremo un'email al riguardo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだデバイスは %1$@ からサインアウトされます。台数に余裕があれば、後でもう一度サインインできます。メールでお知らせします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기기는 %1$@에서 로그아웃돼요. 여유가 생기면 나중에 다시 로그인할 수 있어요. 이메일로 알려 드려요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择的设备将退出 %1$@。如果设备数量未达上限，它之后可以重新登录。我们会通过电子邮件通知你。"
          }
        }
      }
    },
    "signin.choice.replacedBody": {
      "comment": "PX-14a: the app card (SIGN-IN.md §3.6 to §3.9). Arguments: {device} = the replaced device's label; {app} = the requesting app's name (never translated); {thisDevice} = this device's label or \"this browser\". Arguments: 1=device, 2=app, 3=thisDevice.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ signed out of %2$@. %3$@ is signed in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wurde von %2$@ abgemeldet. %3$@ ist angemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est déconnecté de %2$@ et %3$@ est connecté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cerró sesión en %2$@. %3$@ ha iniciado sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ saiu de %2$@. %3$@ está conectado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ è uscito da %2$@. %3$@ ha effettuato l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$@ からサインアウトしました。%3$@ はサインイン済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) %2$@에서 로그아웃됐어요. %3$@이(가) 로그인됐어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已退出 %2$@。%3$@ 已登录。"
          }
        }
      }
    },
