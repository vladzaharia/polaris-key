    "core.codes.release_record_rejected.message": {
      "comment": "Core copy (conformance/parity/copy.en.json, codes).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The release wasn't published because a check failed. The publish log names the check."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Release wurde nicht veröffentlicht, weil eine Prüfung fehlgeschlagen ist. Das Veröffentlichungsprotokoll nennt die Prüfung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version n’a pas été publiée, car une vérification a échoué. Le journal de publication indique laquelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión no se publicó porque falló una comprobación. El registro de publicación indica cuál."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lançamento não foi publicado porque uma verificação falhou. O log de publicação indica qual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La release non è stata pubblicata perché un controllo non è riuscito. Il log di pubblicazione indica quale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックに失敗したため、リリースは公開されませんでした。失敗したチェックは公開ログに記載されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사에 실패해 릴리스가 게시되지 않았어요. 게시 로그에서 실패한 검사를 확인할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于某项检查未通过，此版本未发布。发布日志中写明了该检查。"
          }
        }
      }
    },
