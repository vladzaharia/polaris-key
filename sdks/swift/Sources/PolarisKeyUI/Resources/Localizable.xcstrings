    "signin.gate.joinLede": {
      "comment": "Finish step: the join offer. Arguments: {email} = an address. Polaris Locker is never translated. Arguments: 1=email.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ already belongs to a Polaris Locker account. Join this sign-in to it, or use a different email."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
