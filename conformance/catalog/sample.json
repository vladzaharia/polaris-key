{
  "schemaVersion": 1,
  "entries": [
    {
      "key": "run.concurrency",
      "kind": "config",
      "category": "Run",
      "label": "Parallel downloads",
      "description": "How many downloads run in parallel.",
      "accessor": "run.concurrency",
      "schema": { "type": "integer", "minimum": 1, "maximum": 8 },
      "examples": [3, 1, 8],
      "default": 3,
      "managementDefault": "unmanaged",
      "ui": { "widget": "stepper" }
    },
    {
      "key": "proxy.subscriptionUrl",
      "kind": "secret",
      "secret": true,
      "category": "VPN",
      "label": "VPN subscription URL",
      "description": "Subscription URL, usually auto-provisioned.",
      "accessor": "proxy.subscriptionUrl",
      "schema": { "type": "string", "format": "uri", "maxLength": 2048 },
      "managementDefault": "hidden",
      "ui": { "widget": "password" },
      "dependsOn": { "key": "polarisVpn", "equals": true }
    },
    {
      "key": "polarisVpn",
      "kind": "flag",
      "category": "VPN",
      "label": "Polaris VPN",
      "description": "Master VPN switch.",
      "schema": { "type": "boolean" },
      "default": false,
      "userGrant": true,
      "grantLabel": "Polaris VPN",
      "ui": { "widget": "switch" }
    }
  ]
}
