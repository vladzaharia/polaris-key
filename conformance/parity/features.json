    {
      "id": "core.store",
      "family": "core",
      "title": "Secure token store, surfaced failure, no silent downgrade",
      "service": "core",
      "proof": [{ "kind": "unit" }],
      "allowedNa": [
        {
          "runtime": "web",
          "reason": "runtime",
          "why": "A browser has no keyring; the session lives in an HttpOnly cookie."
        },
        {
          "runtime": "desktop-bridge",
          "reason": "runtime",
          "why": "The renderer holds no credentials; the host process's Node SDK keeps the token behind the bridge (packages/sdk-react/src/desktop/bridge.ts)."
        }
      ]
    },
