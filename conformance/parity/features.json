        { "kind": "corpus", "file": "config-matrix.json", "wp": "P1b-04" }
      ],
      "allowedNa": [],
      "note": "The environment layer applies to desktop hosts only; in a browser it is empty by definition, which the matrix pins rather than an N/A."
    },
    {
      "id": "config.list",
