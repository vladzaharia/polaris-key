      "id": "devices.register",
      "family": "devices",
      "title": "Keyless registration",
      "service": "core",
      "proof": [{ "kind": "transcript" }],
      "allowedNa": [
        {
          "runtime": "web",
          "reason": "runtime",
          "why": "Registration mints a bearer device token; the browser adapter is cookie-session based and holds none (packages/sdk-react/src/browser/browserAdapter.ts), and a browser has no hardware anchor."
        },
        {
          "runtime": "desktop-bridge",
          "reason": "runtime",
          "why": "The host process's Node SDK registers the device and holds its bearer; the renderer never sees it."
        }
      ]
    },
    {
      "id": "devices.manage",
      "family": "devices",
      "title": "List, rename, deauthorise",
      "service": "core",
      "proof": [{ "kind": "transcript" }],
      "allowedNa": [
        {
          "runtime": "web",
          "reason": "runtime",
          "why": "List, rename and deauthorise call /<p>/devices, which authenticates only with a device bearer token; a browser holds a cookie session and no bearer, so the browser adapter refuses with device-management-unsupported (packages/sdk-react/src/browser/browserAdapter.ts)."
        }
      ]
    },
