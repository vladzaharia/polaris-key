    {
      "path": "client-core",
      "reason": "the isomorphic core and the bridge v4 verbs are SP-31's, not an SDK surface"
    },
    {
      "sdk": "node",
      "path": "@polaris-key/node/server",
      "reason": "server layer: verdict objects keep isEntitled and entitlementValue (L4)"
    },
    {
      "sdk": "node",
      "path": "@polaris-key/node/electron",
      "reason": "a runtime adapter, not the client namespace surface"
    },
    {
      "sdk": "node",
      "path": "@polaris-key/node/cli",
      "reason": "CLI layer (L4); its getConfig(client, key) command function stays"
    },
