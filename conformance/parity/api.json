      "path": "@polaris-key/node/terminal",
      "reason": "terminal UI subpath"
    },
    {
      "sdk": "react",
      "path": "ui.*",
      "reason": "the kits' ui surface belongs to UK-41"
    },
    {
      "sdk": "react",
      "path": "PolarisAdapter",
      "reason": "the adapter root keeps getConfig and isEntitled (A2); it is the kit contract, not the app surface"
    },
    {
      "sdk": "python",
      "path": "polaris_key.server",
      "reason": "server layer: verdict objects keep is_entitled and entitlement_value (L4)"
    },
    {
      "sdk": "python",
