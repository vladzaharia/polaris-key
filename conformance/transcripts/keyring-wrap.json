              "body": { "error": { "code": "keyring_conflict" } }
            }
          }
        ]
      },
      "expect": {
        "result": "refused",
        "status": 409,
        "code": "keyring_conflict"
      }
    },
    {
      "action": "keyringWrap",
      "note": "A device that is nobody's.",
      "args": { "deviceId": "TRANSCRIPTDEVICE0000000000000009" },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "PUT",
              "path": "/djdl/devices/keyring/wraps/TRANSCRIPTDEVICE0000000000000009",
