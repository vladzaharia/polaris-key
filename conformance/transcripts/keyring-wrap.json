                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": {
                  "epoch": 0,
                  "kid": "",
                  "kem": "",
                  "enc": "",
                  "ct": ""
                },
                "match": "shape",
                "allowedKeys": ["epoch", "kid", "kem", "enc", "ct"]
              }
            },
            "response": {
              "status": 404,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "error": "not_found" }
            }
          }
        ]
