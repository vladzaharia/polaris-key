{
  "transcriptVersion": 1,
  "id": "cloudsync-cursor-expired",
  "description": "A cursor the object cannot serve (older than the tombstone window, or from another history) is 410 cursor_expired, on a pull and on a push. A push whose mutations landed before the cursor was found stale answers 410 as well; the client repeats it from cursor 0 and every mutation is duplicate.",
  "features": ["sync.settings"],
  "requires": ["core.store"],
  "product": "djdl",
  "baseUrl": "https://key.plrs.im",
  "now": 1700000000,
  "trust": {
    "pkey-test-prod-2026": "kDJF6Deuexo91hFZ9TAPr2SmjUEuTXdia67UogTEpkI"
  },
  "initial": {
    "deviceId": "TRANSCRIPTDEVICE0000000000000001",
    "token": "pkeyt_2m3Rg2fLLMnCkEDO5hZIs9iNnxkLKAyrr-IniD8tl5U",
    "version": "1.0.0"
  },
  "steps": [
    {
      "action": "cloudSyncPull",
      "note": "A pull from a cursor ahead of the history.",
      "args": { "cursor": 9999 },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "GET",
              "path": "/djdl/sync?cursor=9999",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch"
              ],
              "body": null
            },
            "response": {
              "status": 410,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "error": { "code": "cursor_expired" } }
            }
          }
        ]
      },
      "expect": { "result": "refused", "status": 410, "code": "cursor_expired" }
    },
    {
      "action": "cloudSyncPush",
      "note": "A push with the same cursor.",
      "args": { "cursor": 9999, "atomic": false, "mutations": 1 },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/sync/ops",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": {
                  "clientId": "c_AAAAAAAAAAAAAAAAAAAAAA",
                  "cursor": 9999,
                  "mutations": []
                },
                "match": "shape",
                "allowedKeys": ["clientId", "cursor", "atomic", "mutations"]
              }
            },
            "response": {
              "status": 410,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "error": { "code": "cursor_expired" } }
            }
          }
        ]
      },
      "expect": { "result": "refused", "status": 410, "code": "cursor_expired" }
    },
    {
      "action": "cloudSyncPush",
      "note": "Repeated from cursor 0: the mutation had landed.",
      "args": { "cursor": 0, "atomic": false, "mutations": 1 },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/sync/ops",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": {
                  "clientId": "c_AAAAAAAAAAAAAAAAAAAAAA",
                  "cursor": 0,
                  "mutations": []
                },
                "match": "shape",
                "allowedKeys": ["clientId", "cursor", "atomic", "mutations"]
              }
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": {
                "subject": "ps_odVHFu6YgfHqpLURPIa2CQ",
                "serverNow": 1700000000000,
                "cursor": 1,
                "more": false,
                "lastMutationId": 1,
                "catalogVersion": 1,
                "aliases": {},
                "quota": { "bytes": 268435456, "files": true },
                "usage": {
                  "bytes": 14,
                  "settings": 1,
                  "records": 0,
                  "files": 0
                },
                "changes": [
                  {
                    "setting": "ui.theme",
                    "scope": "user",
                    "value": "dark",
                    "version": 1,
                    "editedHlc": "018bcfe56418:0000",
                    "updatedBy": "c_AAAAAAAAAAAAAAAAAAAAAA"
                  }
                ],
                "tombstones": [],
                "results": [{ "mutationId": 1, "status": "duplicate" }]
              }
            }
          }
        ]
      },
      "expect": {
        "result": "ok",
        "cursor": 1,
        "more": false,
        "empty": false,
        "settings": ["ui.theme"],
        "lastMutationId": 1,
        "results": ["duplicate"]
      }
    }
  ]
}
