                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch"
              ],
              "body": null
            },
            "response": {
              "status": 200,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "ring": null, "wrap": null }
            }
          }
        ]
      },
      "expect": { "result": "ok", "ring": null, "wrap": null }
    },
    {
      "action": "keyringCreate",
      "note": "The first device creates the ring.",
      "args": {},
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/devices/keyring",
              "headers": {
