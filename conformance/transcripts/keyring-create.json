              "body": {
                "json": {
                  "ringId": "",
                  "rootKid": "",
                  "wrap": { "kem": 0, "enc": "", "ct": "" },
                  "recovery": { "ct": "" }
                },
                "match": "shape",
                "allowedKeys": ["ringId", "rootKid", "wrap", "recovery"]
              }
            },
            "response": {
              "status": 201,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "ringId": "rg_6pe_t38vM4AZ7jQA7SIZjf", "epoch": 1 }
            }
