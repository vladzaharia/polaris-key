{
  "transcriptVersion": 1,
  "id": "keyring-create",
  "description": "Creating the key ring (WIRE-CONTRACT-V5 §13.11.2). A signed-in device with keys reads an empty ring, creates the ring with its own wrap and a sealed recovery blob (201, epoch 1), and reads it back: the ring and the caller's wrap, with the device that deposited it. A second create is 409 keyring_conflict and changes nothing. Every key, wrap and blob is an opaque fixture: the server never opens one.",
  "features": ["sync.keyring"],
  "requires": ["core.store"],
  "product": "djdl",
  "baseUrl": "https://key.plrs.im",
  "now": 1700000000,
  "trust": {
    "pkey-test-prod-2026": "kDJF6Deuexo91hFZ9TAPr2SmjUEuTXdia67UogTEpkI"
  },
  "initial": {
    "deviceId": "TRANSCRIPTDEVICE0000000000000001",
    "token": "pkeyt_L7Z_jTR0YsyzhMxHLBdEwKZ4yW2Uu4m6CANM1oHQiUA",
    "version": "1.0.0"
  },
  "steps": [
    {
      "action": "keyringGet",
      "note": "No ring yet.",
      "args": {},
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "GET",
              "path": "/djdl/devices/keyring",
              "headers": {
