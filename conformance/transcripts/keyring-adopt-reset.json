{
  "transcriptVersion": 1,
  "id": "keyring-adopt-reset",
  "description": "Start over, then adopt (WIRE-CONTRACT-V5 §13.11.2). A device with keys resets the ring: a new ring id and root, the caller's wrap and a sealed recovery blob; 201, epoch 1. The old ring is kept as previous for 30 days. The device then seals the previous root under the new one and adopts it: 204, once per root; the ring read lists it under adopted. A root the server does not name is 409 keyring_conflict. Reset needs a ring to replace and a new id: the same id is 409 as well.",
  "features": ["sync.keyring"],
  "requires": ["core.store"],
  "product": "djdl",
  "baseUrl": "https://key.plrs.im",
  "now": 1700000000,
  "trust": {
    "pkey-test-prod-2026": "kDJF6Deuexo91hFZ9TAPr2SmjUEuTXdia67UogTEpkI"
  },
  "initial": {
    "deviceId": "TRANSCRIPTDEVICE0000000000000001",
    "token": "pkeyt_3ZNAMBN6ezKkm8wIUsk9Wf6UrcVsZZXRSiXAwb17g70",
    "version": "1.0.0"
  },
  "steps": [
    {
      "action": "keyringCreate",
      "note": "The first ring.",
      "args": {},
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/devices/keyring",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": {
                  "ringId": "",
                  "rootKid": "",
                  "wrap": { "kem": "", "enc": "", "ct": "" },
                  "recovery": { "ct": "" }
                },
                "match": "shape",
                "allowedKeys": ["ringId", "rootKid", "wrap", "recovery"]
              }
            },
            "response": {
              "status": 201,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "ringId": "rg_6pe_t38vM4AZ7jQA7SIZjf", "epoch": 1 }
            }
          }
        ]
      },
      "expect": {
        "result": "ok",
        "ringId": "rg_6pe_t38vM4AZ7jQA7SIZjf",
        "epoch": 1
      }
    },
