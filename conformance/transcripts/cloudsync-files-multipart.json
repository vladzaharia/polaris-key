    },
    {
      "action": "cloudSyncFile",
      "note": "Abort: the session ends, the reservation is released.",
      "args": { "op": "abort", "collection": "docs", "id": "big" },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "DELETE",
              "path": "/djdl/sync/files/docs/big/upload/up_fPx2poyZMlJFFhSF8g3iaQ",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch"
              ],
              "body": null
            },
            "response": {
              "status": 204,
              "headers": { "cache-control": "no-store" },
              "body": ""
            }
          }
        ]
      },
      "expect": { "result": "ok", "status": 204 }
    },
    {
      "action": "cloudSyncFile",
      "note": "The session is gone.",
      "args": { "op": "status", "collection": "docs", "id": "big" },
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "GET",
              "path": "/djdl/sync/files/docs/big/upload/up_fPx2poyZMlJFFhSF8g3iaQ",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
