                "content-type": "application/json"
              },
              "body": {
                "status": "pending",
                "deviceCode": "FElL1HvzUVCOilSj-VN_ng",
                "userCode": "MWBX-TMQB",
                "verificationUri": "https://key.plrs.im/djdl/identity/auth/device",
                "verificationUriComplete": "https://key.plrs.im/djdl/identity/auth/device?user_code=MWBX-TMQB",
                "expiresIn": 600,
                "interval": 2,
