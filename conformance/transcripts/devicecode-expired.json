      "action": "beginSignIn",
      "args": {},
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/identity/auth/device/start",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": { "deviceId": "TRANSCRIPTDEVICE0000000000000001" },
                "match": "exact"
              }
            },
            "response": {
              "status": 200,
              "headers": {
