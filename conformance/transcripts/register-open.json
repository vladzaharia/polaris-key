            "request": {
              "method": "POST",
              "path": "/djdl/devices/register",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
