      "note": "A ring with no recovery blob.",
      "args": {},
      "exchanges": {
        "ordered": false,
        "items": [
          {
            "request": {
              "method": "POST",
              "path": "/djdl/devices/keyring",
              "headers": {
                "x-pkey-device": "{deviceId}",
                "x-pkey-version": "{version}",
                "authorization": "Bearer {token}"
              },
              "requiredHeaders": [
                "x-pkey-device",
                "x-pkey-version",
                "x-pkey-channel",
                "x-pkey-sdk",
                "x-pkey-sdk-version",
                "x-pkey-platform",
                "x-pkey-arch",
                "content-type"
              ],
              "body": {
                "json": {
                  "ringId": "",
                  "rootKid": "",
                  "wrap": { "kem": "", "enc": "", "ct": "" }
                },
                "match": "shape",
                "allowedKeys": ["ringId", "rootKid", "wrap", "recovery"]
              }
            },
            "response": {
              "status": 201,
              "headers": {
                "cache-control": "no-store",
                "content-type": "application/json"
              },
              "body": { "ringId": "rg_6pe_t38vM4AZ7jQA7SIZjf", "epoch": 1 }
            }
          }
        ]
