{
  "name": "polaris-key-example-ui-electron",
  "productName": "Tidewater Studio",
  "version": "2.4.1",
  "description": "Tidewater Studio: the Polaris Key kit in an Electron Forge app",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "live": "electron-forge start -- --live",
    "build": "tsc --noEmit && electron-forge package",
    "typecheck": "tsc --noEmit",
    "smoke": "electron-forge start -- --smoke"
  },
  "dependencies": {
    "@polaris-key/node": "^0.0.0",
    "@polaris-key/react": "^0.0.0",
    "electron-updater": "^6.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.7.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.0"
  }
}
