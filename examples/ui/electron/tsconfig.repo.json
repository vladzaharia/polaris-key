{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Preserve",
    "typeRoots": [
      "./node_modules/@types",
      "../../../packages/sdk-react/node_modules/@types"
    ],
    "paths": {
      "@polaris-key/node": ["../../../packages/sdk-node/dist/index"],
      "@polaris-key/node/electron": [
        "../../../packages/sdk-node/dist/electron/index"
      ],
      "@polaris-key/node/electron/preload": [
        "../../../packages/sdk-node/dist/electron/preload"
      ],
      "@polaris-key/node/update/drivers/electron-updater": [
        "../../../packages/sdk-node/dist/update/drivers/electronUpdater"
      ],
      "@polaris-key/react": ["../../../packages/sdk-react/dist/index"],
      "@polaris-key/react/*": ["../../../packages/sdk-react/dist/*/index"],
      "react": ["../../../packages/sdk-react/node_modules/@types/react"],
      "react/*": ["../../../packages/sdk-react/node_modules/@types/react/*"],
      "react-dom": [
        "../../../packages/sdk-react/node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "../../../packages/sdk-react/node_modules/@types/react-dom/*"
      ]
    }
  }
}
