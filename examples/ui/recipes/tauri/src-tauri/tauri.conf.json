{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tidewater Studio",
  "version": "1.0.0",
  "identifier": "com.harboraudio.tidewater",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tidewater Studio",
        "width": 960,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
