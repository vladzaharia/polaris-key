{
  "schemaVersion": 1,
  "entries": [
    {
      "key": "sources.order",
      "kind": "config",
      "category": "Sources",
      "label": "Source priority",
      "description": "Enabled audio sources, best-quality-first; fallthrough order.",
      "accessor": "sources",
      "schema": {
        "type": "array",
        "items": { "type": "string", "enum": ["soulseek", "bandcamp", "soundcloud", "youtube", "spotify", "appleMusic"] },
        "uniqueItems": true,
        "minItems": 1
      },
      "default": ["soulseek", "bandcamp", "soundcloud", "youtube", "spotify", "appleMusic"],
      "managementDefault": "unmanaged"
    },
    {
      "key": "quality.floor",
      "kind": "config",
      "category": "Quality",
      "label": "Minimum quality",
      "description": "Candidates below this floor are dropped.",
      "accessor": "quality.floor",
      "schema": { "type": "string", "enum": ["flac", "mp3-320", "any"] },
      "default": "any",
      "managementDefault": "unmanaged",
      "ui": { "widget": "select" }
    },
    {
      "key": "quality.losslessOnly",
      "kind": "config",
      "category": "Quality",
      "label": "Lossless only",
      "description": "Keep only genuinely lossless results (FLAC/ALAC).",
      "accessor": "quality.losslessOnly",
      "schema": { "type": "boolean" },
      "default": false,
      "managementDefault": "unmanaged",
      "ui": { "widget": "switch" }
    },
    {
      "key": "quality.bestQuality",
      "kind": "config",
      "category": "Quality",
      "label": "Try for best quality",
      "description": "Keep trying better sources even after a success.",
      "accessor": "quality.bestQuality",
      "schema": { "type": "boolean" },
      "default": true,
      "managementDefault": "unmanaged",
      "ui": { "widget": "switch" }
    },
    {
      "key": "quality.upgrade.enabled",
      "kind": "config",
      "category": "Quality",
      "label": "Upgrade existing files",
      "description": "Re-fetch existing files when a strictly-better source appears.",
      "accessor": "quality.upgrade.enabled",
      "schema": { "type": "boolean" },
      "default": false,
      "managementDefault": "unmanaged",
      "ui": { "widget": "switch" }
    },
    {
      "key": "run.searchCount",
      "kind": "config",
      "category": "Run",
      "label": "Results per source",
      "description": "How many candidates to consider per source per track.",
      "accessor": "run.searchCount",
      "schema": { "type": "integer", "minimum": 1, "maximum": 50 },
      "default": 5,
      "managementDefault": "unmanaged",
      "ui": { "widget": "stepper" }
    },
    {
      "key": "run.concurrency",
      "kind": "config",
      "category": "Run",
      "label": "Parallel downloads",
      "description": "Songs downloaded in parallel within a playlist.",
      "accessor": "run.concurrency",
      "schema": { "type": "integer", "minimum": 1, "maximum": 8 },
      "default": 3,
      "managementDefault": "unmanaged",
      "ui": { "widget": "stepper" }
    },
    {
      "key": "run.toleranceSec",
      "kind": "config",
      "category": "Run",
      "label": "Duration tolerance (s)",
      "description": "Allowed runtime difference for a confident match.",
      "accessor": "run.toleranceSec",
      "schema": { "type": "number", "minimum": 0, "maximum": 120 },
      "default": 15,
      "managementDefault": "unmanaged"
    },
    {
      "key": "run.searchTimeoutSec",
      "kind": "config",
      "category": "Run",
      "label": "Per-source timeout (s)",
      "description": "Max seconds to wait for one source's search.",
      "accessor": "run.searchTimeoutSec",
      "schema": { "type": "integer", "minimum": 1, "maximum": 300 },
      "default": 30,
      "managementDefault": "unmanaged"
    },
    {
      "key": "run.cooloffHours",
      "kind": "config",
      "category": "Run",
      "label": "Failed-track cool-off (h)",
      "description": "Hours to wait before retrying a failed track. 0 = always retry.",
      "accessor": "run.cooloffHours",
      "schema": { "type": "number", "minimum": 0, "maximum": 8760 },
      "default": 24,
      "managementDefault": "unmanaged"
    },
    {
      "key": "ui.theme",
      "kind": "config",
      "category": "Interface",
      "label": "Theme",
      "description": "Dashboard color theme.",
      "accessor": "ui.theme",
      "schema": { "type": "string", "enum": ["dark", "light"] },
      "default": "dark",
      "managementDefault": "unmanaged",
      "ui": { "widget": "select" }
    },
    {
      "key": "outputDir",
      "kind": "config",
      "category": "Output",
      "label": "Download folder",
      "description": "Default output location. A managed value must be an absolute path.",
      "accessor": "outputDir",
      "schema": { "type": "string", "minLength": 1, "maxLength": 1024 },
      "managementDefault": "unmanaged",
      "ui": { "placeholder": "~/Music/DjayImport" }
    },
    {
      "key": "identity.enabled",
      "kind": "config",
      "category": "Identity",
      "label": "Identity enrichment",
      "description": "Enable MusicBrainz enrichment + AcoustID verification.",
      "accessor": "identity.enabled",
      "schema": { "type": "boolean" },
      "default": false,
      "managementDefault": "unmanaged",
      "ui": { "widget": "switch" }
    },
    {
      "key": "identity.strict",
      "kind": "config",
      "category": "Identity",
      "label": "Strict identity",
      "description": "Reject downloads AcoustID flags as a different recording.",
      "accessor": "identity.strict",
      "schema": { "type": "boolean" },
      "default": false,
      "managementDefault": "unmanaged",
      "dependsOn": { "key": "identity.enabled", "equals": true },
      "ui": { "widget": "switch" }
    },
    {
      "key": "proxy.enabled",
      "kind": "config",
      "category": "VPN",
      "label": "Route through VPN",
      "description": "Tunnel downloads + Soulseek through the Polaris VPN.",
      "accessor": "proxy.enabled",
      "schema": { "type": "boolean" },
      "default": false,
      "managementDefault": "unmanaged",
      "dependsOn": { "key": "polarisVpn", "equals": true },
      "ui": { "widget": "switch" }
    },
    {
      "key": "proxy.select",
      "kind": "config",
      "category": "VPN",
      "label": "Exit node",
      "description": "\"auto\" picks the fastest exit; otherwise a specific node tag.",
      "accessor": "proxy.select",
      "schema": { "type": "string", "minLength": 1, "maxLength": 128 },
      "default": "auto",
      "managementDefault": "unmanaged",
      "dependsOn": { "key": "proxy.enabled", "equals": true }
    },
    {
      "key": "proxy.refreshHours",
      "kind": "config",
      "category": "VPN",
      "label": "Subscription refresh (h)",
      "description": "Hours to cache the fetched subscription before re-fetching.",
      "accessor": "proxy.refreshHours",
      "schema": { "type": "number", "minimum": 0, "maximum": 8760 },
      "default": 24,
      "managementDefault": "unmanaged",
      "dependsOn": { "key": "proxy.enabled", "equals": true }
    },
    {
      "key": "proxy.subscriptionUrl",
      "kind": "secret",
      "secret": true,
      "category": "VPN",
      "label": "VPN subscription URL",
      "description": "Polaris/Remnawave subscription URL. Usually auto-provisioned from the IdP.",
      "accessor": "proxy.subscriptionUrl",
      "schema": { "type": "string", "format": "uri", "maxLength": 2048 },
      "managementDefault": "hidden",
      "ui": { "widget": "password" },
      "dependsOn": { "key": "polarisVpn", "equals": true }
    },
    {
      "key": "soundcloud.oauth",
      "kind": "secret",
      "secret": true,
      "category": "Accounts",
      "label": "SoundCloud OAuth token",
      "description": "Improves SoundCloud bitrate when present.",
      "accessor": "soundcloud.oauth",
      "schema": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "managementDefault": "unmanaged",
      "ui": { "widget": "password" }
    },
    {
      "key": "spotify.clientId",
      "kind": "secret",
      "secret": true,
      "category": "Accounts",
      "label": "Spotify client ID",
      "description": "Custom Spotify app client id (optional).",
      "accessor": "spotify.clientId",
      "schema": { "type": "string", "minLength": 1, "maxLength": 256 },
      "managementDefault": "unmanaged",
      "ui": { "widget": "password" }
    },
    {
      "key": "spotify.refreshToken",
      "kind": "secret",
      "secret": true,
      "category": "Accounts",
      "label": "Spotify refresh token",
      "description": "OAuth refresh token for the Spotify Web API.",
      "accessor": "spotify.refreshToken",
      "schema": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "managementDefault": "unmanaged",
      "ui": { "widget": "password" }
    },
    {
      "key": "identity.acoustidKey",
      "kind": "secret",
      "secret": true,
      "category": "Identity",
      "label": "AcoustID API key",
      "description": "Enables AcoustID fingerprint verification.",
      "accessor": "identity.acoustidKey",
      "schema": { "type": "string", "minLength": 1, "maxLength": 256 },
      "managementDefault": "unmanaged",
      "ui": { "widget": "password" },
      "dependsOn": { "key": "identity.strict", "equals": true }
    },
    {
      "key": "appleMusic.userToken",
      "kind": "secret",
      "secret": true,
      "category": "Accounts",
      "label": "Apple Music user token",
      "description": "MusicKit Music User Token for the official Apple Music API.",
      "accessor": "appleMusic.userToken",
      "schema": { "type": "string", "minLength": 1, "maxLength": 4096 },
      "managementDefault": "unmanaged",
      "ui": { "widget": "password" }
    },
    {
      "key": "polarisVpn",
      "kind": "flag",
      "category": "VPN",
      "label": "Polaris VPN",
      "description": "Master switch for VPN support. Auto-enabled when the IdP grants remnawaveAccess.",
      "schema": { "type": "boolean" },
      "default": false,
      "userGrant": true,
      "grantLabel": "Polaris VPN",
      "ui": { "widget": "switch" }
    },
    {
      "key": "channels",
      "kind": "flag",
      "category": "Release channels",
      "label": "Allowed update channels",
      "description": "Release channels this license may run. `stable` is always allowed.",
      "schema": {
        "type": "array",
        "items": { "type": "string", "enum": ["stable", "staging", "pr"] },
        "uniqueItems": true
      },
      "default": ["stable"],
      "userGrant": true,
      "grantLabel": "Pre-release builds",
      "ui": { "widget": "select" }
    },
    {
      "key": "app.minVersion",
      "kind": "flag",
      "category": "Compatibility",
      "label": "Minimum app version",
      "description": "Oldest app/CLI version this key may run (semver).",
      "schema": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$" }
    },
    {
      "key": "app.maxVersion",
      "kind": "flag",
      "category": "Compatibility",
      "label": "Maximum app version",
      "description": "Newest app/CLI version this key may run (semver).",
      "schema": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$" }
    },
    {
      "key": "machineLimit",
      "kind": "flag",
      "category": "Compatibility",
      "label": "Machine limit",
      "description": "Maximum concurrently-authorized machines. Absent => default cap; 0 => unlimited.",
      "schema": { "type": "integer", "minimum": 0, "maximum": 100 },
      "ui": { "widget": "stepper", "scopes": ["profile", "license"], "unit": "devices" }
    }
  ]
}
