{
  "$schema": "../../packages/shared-manifest/schemas/v1/product.schema.json",
  "slug": "djdl",
  "name": "DJDL",
  "signingKid": "djdl-2026",
  "signingPub": "P0nMyA9QpvpspaIXBjtb6PfXZu4jIiGPlNzkRm28_6E",
  "compatMin": "0.0.0",
  "compatMax": "99.0.0",
  "defaultMaxOfflineDays": 30,
  "defaultDeviceLimit": 5,
  "adminGroup": "admins",
  "modules": {
    "license": {
      "enabled": true
    },
    "config": {
      "enabled": true
    },
    "release": {
      "enabled": true
    },
    "distribution": {
      "enabled": true
    },
    "update": {
      "enabled": true
    },
    "identity": {
      "enabled": true
    }
  },
  "devices": {
    "registration": "requires-license"
  },
  "oidc": {
    "provider": "platform",
    "redirectUris": ["https://key.plrs.im/djdl/identity/auth/callback"],
    "groupRoleMap": {
      "members": {
        "role": "user",
        "tier": "standard"
      },
      "admins": {
        "role": "admin"
      }
    }
  },
  "tiers": [
    {
      "id": "standard",
      "label": "Standard",
      "profileId": null,
      "policyExpiryDays": null,
      "policyDeviceLimit": 5
    }
  ],
  "provisioning": [
    {
      "claim": "vpnAccess",
      "entitlementKey": "polarisVpn",
      "entitlementValue": true
    },
    {
      "claim": "vpnSub",
      "secretKey": "proxy.subscriptionUrl",
      "secretUrlTemplate": "https://vpn.example.com/{claim}",
      "allowedHosts": ["vpn.example.com"]
    }
  ],
  "edgeMint": [
    {
      "id": "applemusic",
      "alg": "ES256",
      "signingKeySecret": "EDGE_MINT__DJDL__APPLEMUSIC",
      "kid": "KEYID00000",
      "claimsTemplate": {
        "iss": "TEAM000000"
      },
      "ttlSeconds": 3600
    }
  ],
  "release": {
    "ghOwner": "example-org",
    "ghRepo": "djdl",
    "ghInstallationId": 0,
    "channelWorkflow": "channel.yml",
    "betaBranch": "main",
    "binaryName": "djdl",
    "summaryMarker": "pkey:summary",
    "sparkleEd25519Pub": "REPLACE_WITH_SPARKLE_PUBLIC_KEY"
  }
}
