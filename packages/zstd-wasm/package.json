{
  "name": "@polaris-key/zstd-wasm",
  "version": "0.0.0",
  "description": "libzstd 1.5.7 for wasm32: a decoder (one frame, optionally with a raw-content prefix, window-checked before decoding) and, under ./encoder, the lazy-delta --patch-from encoder.",
  "license": "MIT AND BSD-3-Clause",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "workerd": "./dist/workerd.js",
      "node": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./encoder": {
      "types": "./dist/encoder-node.d.ts",
      "workerd": "./dist/encoder-workerd.js",
      "node": "./dist/encoder-node.js",
      "default": "./dist/encoder-node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./zdec.wasm": "./dist/zdec.wasm",
    "./zenc.wasm": "./dist/zenc.wasm"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/zdec.wasm src/zenc.wasm dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.1",
    "miniflare": "4.20260730.0"
  }
}
