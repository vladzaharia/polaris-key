{
  "name": "@polaris-key/zstd-wasm",
  "version": "0.0.0",
  "description": "Decoder-only libzstd 1.5.7 for wasm32: one frame, optionally with a raw-content prefix, window-checked before decoding.",
  "license": "BSD-3-Clause",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/node.js",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "workerd": "./dist/workerd.js",
      "node": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/zdec.wasm dist/zdec.wasm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "0.27.7",
    "miniflare": "4.20260623.0"
  }
}
