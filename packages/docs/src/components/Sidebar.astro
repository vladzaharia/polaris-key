---
/**
 * The sidebar. On the phone the menu is a drawer with its own head: the door's name and a close
 * button (docs.mobile-menu), and on a Developers or Operate page the door tabs. Both are hidden
 * from 50 rem up, where the sidebar is a column and the header holds the tabs.
 */
import Default from "@astrojs/starlight/components/Sidebar.astro";
import { helpRoute } from "../lib/helpHost";
import { HELP_ICONS } from "../lib/helpIcons";
import { DOOR_TABS, kindOf, tabOf } from "../lib/chrome";

const id = Astro.locals.starlightRoute.id;
const help = helpRoute(id);
const current = tabOf(id);
---

<div class="pk-help-drawer-head">
  <h2>{help ? "Help" : "Docs"}</h2>
  <button
    type="button"
    class="pk-help-iconbtn"
    popovertarget="starlight__sidebar"
    popovertargetaction="hide"
    aria-label="Close menu"
    set:html={HELP_ICONS.x}
  />
</div>
{
  kindOf(id) === "door" && !help && (
    <nav class="pk-doors pk-doors--drawer" aria-label="Docs sections">
      {DOOR_TABS.map((tab) => (
        <a href={tab.href} aria-current={tab === current ? "true" : undefined}>
          {tab.label}
        </a>
      ))}
    </nav>
  )
}
<Default />

<script>
  /**
   * The phone drawer (docs.mobile-menu). Starlight inerts only the main frame and the skip link, so
   * focus could walk behind the drawer onto the header, the Menu button and the brand footers
   * (WCAG 2.4.11). While it is open those are inert, focus starts on Close menu, and on close it
   * returns to Menu. Help's tree keeps every group open, so its current page is brought into view.
   */
  const pane = document.getElementById("starlight__sidebar");
  const BEHIND =
    "header.header, .pk-section > footer, .sl-menu-button";

  const reveal = () => {
    if (document.querySelector(".pk-section")?.getAttribute("data-brand") !== "locker") return;
    const here = pane?.querySelector<HTMLElement>('a[aria-current="page"]');
    if (!pane || !here || here.offsetParent === null) return;
    const box = pane.getBoundingClientRect();
    const at = here.getBoundingClientRect();
    if (at.top >= box.top && at.bottom <= box.bottom) return;
    pane.scrollTop += at.top - box.top - (pane.clientHeight - at.height) / 2;
  };

  pane?.addEventListener("toggle", (e) => {
    const open = (e as ToggleEvent).newState === "open";
    for (const el of document.querySelectorAll<HTMLElement>(BEHIND))
      el.toggleAttribute("inert", open);
    if (open) {
      pane.querySelector<HTMLElement>(".pk-help-drawer-head button")?.focus();
      reveal();
    } else {
      document.querySelector<HTMLElement>(".sl-menu-button")?.focus();
    }
  });
  reveal();
</script>
