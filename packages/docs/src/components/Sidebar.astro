---
/**
 * The sidebar. On the phone the menu is a drawer with its own head: the door's name and a close
 * button (docs.mobile-menu), and on a Developers or Operate page the door tabs. Both are hidden
 * from 50 rem up, where the sidebar is a column and the header holds the tabs.
 */
import Default from "@astrojs/starlight/components/Sidebar.astro";
import { helpRoute } from "../lib/helpHost";
import { HELP_ICONS } from "../lib/helpIcons";
import { DOOR_TABS, kindOf, tabOf } from "../lib/chrome";

const id = Astro.locals.starlightRoute.id;
const help = helpRoute(id);
const current = tabOf(id);
---

<div class="pk-help-drawer-head">
  <h2>{help ? "Help" : "Docs"}</h2>
  <button
    type="button"
    class="pk-help-iconbtn"
    popovertarget="starlight__sidebar"
    popovertargetaction="hide"
    aria-label="Close menu"
    set:html={HELP_ICONS.x}
  />
</div>
{
  kindOf(id) === "door" && !help && (
    <nav class="pk-doors pk-doors--drawer" aria-label="Docs sections">
      {DOOR_TABS.map((tab) => (
        <a href={tab.href} aria-current={tab === current ? "true" : undefined}>
          {tab.label}
        </a>
      ))}
    </nav>
  )
}
<Default />
