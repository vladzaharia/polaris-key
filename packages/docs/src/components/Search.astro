---
/**
 * The search (docs.search): the trigger in the header and the dialog it opens, also opened by
 * Ctrl or Cmd K and by `?q=` on any page. It replaces Starlight's Pagefind UI and speaks to
 * Pagefind's JS API (src/components/search.ts). Help's pages search Help ("Search help"); every
 * other page searches all docs, and a Help page can widen to them.
 */
import { helpRoute } from "../lib/helpHost";
import { DOOR_ICONS, HELP_ICONS } from "../lib/helpIcons";
import { HELP_TOP_TASKS, START_HERE } from "../lib/suggestions";

const help = helpRoute(Astro.locals.starlightRoute.id);
const label = help ? "Search help" : "Search the docs";
// What the dialog lists before a query: Help's Top tasks, else the developer landing's Get started.
const suggestions = help ? HELP_TOP_TASKS : START_HERE;
const suggestionsLabel = help ? "Top tasks" : "Start here";
// The page-not-found page is one static file for every host. Its search is the developer's until
// the address says Help (the pre-paint script in help/MissingPage.astro marks <html data-help-miss>),
// and search.ts then swaps to Help's words, opening state and bundle.
const miss = Astro.locals.starlightRoute.id === "404";
---

<site-search
  class={Astro.props.class}
  data-scope={help ? "help" : "all"}
  data-base={import.meta.env.BASE_URL.replace(/\/$/, "")}
  data-miss={miss ? "" : undefined}
>
  <button data-open-modal disabled aria-label={label} aria-keyshortcuts="Control+K">
    <Fragment set:html={HELP_ICONS.search} />
    <span class="pk-search-label" aria-hidden="true">{help ? "Search help" : "Search docs"}</span>
    <kbd class="pk-search-kbd" hidden>Ctrl K</kbd>
  </button>

  <dialog class="pk-search" aria-label={label}>
    <div class="pk-search-frame">
      <div class="pk-search-field">
        <Fragment set:html={HELP_ICONS.search} />
        <input
          type="text"
          role="combobox"
          aria-label={label}
          aria-expanded="false"
          aria-controls="pk-search-results"
          aria-autocomplete="list"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          dir="auto"
          enterkeyhint="search"
          placeholder={help ? "Search help" : "Search the docs"}
        />
        <button type="button" class="pk-search-close" data-close-modal aria-label="Close search">
          <kbd class="pk-search-esc" aria-hidden="true">esc</kbd>
          <span class="pk-search-cancel" aria-hidden="true">Cancel</span>
        </button>
      </div>
      <div class="pk-search-body" tabindex="0">
        <div class="pk-search-scope" role="radiogroup" aria-label="Search in" hidden>
          <button type="button" role="radio" aria-checked="true" data-scope="help">Help only</button>
          <button type="button" role="radio" aria-checked="false" tabindex="-1" data-scope="all">All docs</button>
        </div>
        <p class="pk-search-hint" data-hint></p>
        <div class="pk-search-skeleton" aria-hidden="true" hidden>
          <i></i><i></i><i></i>
        </div>
        <div class="pk-search-failed-box" hidden>
          <p class="pk-search-failed" role="alert">
            Search isn’t working right now.
          </p>
          <button type="button" class="pk-search-retry">Try again</button>
        </div>
        <div class="pk-search-empty" hidden>
          <p data-empty></p>
          <button type="button" class="pk-search-widen" hidden>Search all docs</button>
        </div>
        <div
          id="pk-search-results"
          class="pk-search-results"
          role="listbox"
          aria-label="Results"
          hidden
        >
        </div>
      </div>
      <div class="pk-search-foot" aria-hidden="true">
        <span class="pk-search-foot-start"><kbd>↵</kbd> Open</span>
        <span><kbd class="pk-search-mod">Ctrl</kbd><kbd>↵</kbd> New tab</span>
        <span><kbd>esc</kbd> Close</span>
      </div>
      <p class="pk-search-status" role="status" aria-live="polite"></p>
    </div>
  </dialog>

  <template data-suggest={suggestionsLabel}>
    {suggestions.map((s) => <a href={s.href}><strong>{s.title}</strong><small>{s.description}</small></a>)}
  </template>
  {
    miss && (
      <template data-suggest-help="Top tasks">
        {HELP_TOP_TASKS.map((s) => <a href={s.href}><strong>{s.title}</strong><small>{s.description}</small></a>)}
      </template>
    )
  }
  <template data-icon="door-help"><Fragment set:html={DOOR_ICONS.help} /></template>
  <template data-icon="door-developers"><Fragment set:html={DOOR_ICONS.code} /></template>
  <template data-icon="door-operate"><Fragment set:html={DOOR_ICONS.dashboard} /></template>
  <template data-icon="jump"><Fragment set:html={HELP_ICONS.arrowRight} /></template>
</site-search>

<script>
  import "./search";
</script>
