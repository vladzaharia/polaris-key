---
/**
 * Starlight's page frame inside a section wrapper. `data-service` re-points the brand's
 * --pk-accent* tokens (and, through global.css, Starlight's accent variables) at the page's
 * section: service pages take their service accent, everything else stays core. The wrapper is
 * `display: contents`, so Starlight's layout is unchanged.
 */
import Default from "@astrojs/starlight/components/PageFrame.astro";
import { sectionFor } from "../lib/section";

const section = sectionFor(Astro.locals.starlightRoute.id);
// The top-level folder (start, build, reference, help, ...): reference pages take a wider measure.
const kind = Astro.locals.starlightRoute.id.split("/")[0];
---

<div class="pk-section" data-service={section.slug} data-kind={kind}>
  <Default>
    <slot name="header" slot="header" />
    <slot name="sidebar" slot="sidebar" />
    <slot />
  </Default>
</div>

<script>
  import "../scripts/regions";
</script>
