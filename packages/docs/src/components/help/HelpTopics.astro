---
/**
 * The Help home's topics as compact cards: the topic's name over its links. Colours are tokens,
 * so dark and light come with them.
 */
import "./home.css";

export interface Props {
  topics: { title: string; links: { title: string; href: string }[] }[];
}

const { topics } = Astro.props;
---

<div class="pk-help-home__topics not-content">
  {
    topics.map((topic) => (
      <section>
        <h3>{topic.title}</h3>
        <ul>
          {topic.links.map((link) => (
            <li>
              <a href={link.href}>{link.title}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
