---
/**
 * Link cards for the Help home (docs.help-home): a title with an arrow, then one line. Used for
 * Top tasks and for Browse by topic, which differ only in what the line holds. Colours are tokens,
 * so dark and light come with them.
 */
import { HELP_ICONS } from "../../lib/helpIcons";
import "./home.css";

export interface Props {
  tasks: { title: string; description: string; href: string }[];
}

const { tasks } = Astro.props;
---

<ul class="pk-help-cards not-content">
  {
    tasks.map((task) => (
      <li>
        <a href={task.href}>
          <span class="pk-help-cards__title">
            {task.title}
            <Fragment set:html={HELP_ICONS.arrowRight} />
          </span>
          <span class="pk-help-cards__text">{task.description}</span>
        </a>
      </li>
    ))
  }
</ul>
