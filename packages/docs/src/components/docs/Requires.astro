---
/**
 * The chip row under a title (style guide §8): the features, the role and the SDK minimum the
 * page needs. Requirements are chips, not callouts.
 */
import { StatusPill } from "../console";
import { FeatureChip } from "../FeatureChip";
import { FEATURES, type FeatureId } from "../../lib/features.generated";

export interface Props {
  features?: readonly FeatureId[];
  /** The console role, e.g. "Product admin". */
  role?: string;
  /** SDK minimums as written on the page: "Node 22.13 or later". */
  sdk?: readonly string[];
}

const { features = [], role, sdk = [] } = Astro.props;
---

<p class="pk-requires not-content my-4 flex flex-wrap items-center gap-2">
  <strong class="mr-1">Requires</strong>
  {features.map((f) => <span class="pk-chip" data-kind="feature" data-service={FEATURES[f].accent}><FeatureChip service={FEATURES[f].accent} label={FEATURES[f].label} /></span>)}
  {role && <span class="pk-chip" data-kind="role"><StatusPill tone="neutral" icon={false}>{role}</StatusPill></span>}
  {sdk.map((s) => <span class="pk-chip" data-kind="sdk"><StatusPill tone="neutral" icon={false}>{s}</StatusPill></span>)}
</p>
