---
/**
 * One message of Help (docs plan §7.1, §7.5). The heading is the catalog title, character for
 * character; its anchor is the message id, set here and never slugified. Under it come the message
 * as the app shows it (a placeholder shows what goes there), Why you see this and What to do from
 * `help-messages.json`, a link that ends What to do when there is one (`cta` library), a link to
 * the article that explains more when there is one, the pointer to who to ask when there is one
 * (`cta` contact), and the ids, in small type, for telling the developer. The titles of the same
 * message in every translated catalog follow as hidden text, so
 * search finds the entry from a title in another language.
 *
 * `brief` leaves out Why, What to do, More help and the pointers: the title, the message and the
 * codes, for an article whose own steps say what to do.
 *
 * `<HelpMessage id>` shows that one id, as an article does for the anchors it carries. On a
 * messages page, `<HelpMessage id entry>` shows the whole entry the id owns: one heading, and one
 * branch for each distinct message of the title, each id keeping its own anchor. A copy change
 * reaches Help on the next build.
 *
 * The heading comes from this component, not from the page's Markdown, so Starlight's heading
 * collector never sees it: `src/routeData.ts` adds the entries of a messages page to "On this
 * page".
 */
import AnchorHeading from "@astrojs/starlight/components/AnchorHeading.astro";
import { getEntry } from "astro:content";
import {
  HELP_MESSAGES,
  KNOWN_ENTRIES,
  CONTACT_ARTICLE,
  aliasesFor,
  articleHref,
  entryOf,
  messageParts,
  textParts,
  singleOf,
  type EntryBranch,
} from "../../lib/helpMessages";
import PortalLink from "./PortalLink.astro";
import "../help/message.css";

export interface Props {
  /** A message id: a `codes` key, `gate.<key>`, `activation.<key>`, `portal.<key>` or `fallback`. */
  id: string;
  /** Show the whole entry this id owns: one heading and a branch per distinct message. */
  entry?: boolean;
  /** Title, message and codes only: the article's own steps say what to do. */
  brief?: boolean;
}

const { id, entry: wholeEntry = false, brief = false } = Astro.props;
if (!KNOWN_ENTRIES.has(id))
  throw new Error(
    `<HelpMessage id="${id}">: no such key in conformance/parity/copy.en.json or the portal copy of help-messages.json`,
  );

let title: string;
let ids: string[];
let branches: EntryBranch[];
if (wholeEntry) {
  const entry = entryOf(HELP_MESSAGES, KNOWN_ENTRIES, id);
  if (entry === undefined)
    throw new Error(`<HelpMessage id="${id}" entry>: ${id} is in no entry of help-messages.json`);
  if (entry.id !== id)
    throw new Error(
      `<HelpMessage id="${id}" entry>: ${id} belongs to the entry ${entry.id} owns; show that one`,
    );
  ({ title, ids, branches } = entry);
} else {
  const one = singleOf(HELP_MESSAGES, KNOWN_ENTRIES, id)!;
  ({ title } = one);
  ids = [id];
  branches = [one.branch];
}

/* The title reaches the heading as HTML (below), so a character that is markup there stops the build. */
if (/[&<>]/.test(title))
  throw new Error(
    `<HelpMessage id="${id}">: the title "${title}" holds & < or >, which the heading would pass on as HTML`,
  );

/** A Help page as a link, unless it is the page showing the message. */
async function helpLink(
  article: string,
): Promise<{ href: string; title: string } | undefined> {
  const href = articleHref(article, Astro.url.pathname);
  if (href === undefined) return undefined;
  const page = await getEntry("docs", `help/${article}`);
  if (page === undefined)
    throw new Error(`<HelpMessage id="${id}">: the article help/${article} does not exist`);
  return { href, title: page.data.title };
}
/** The article link of each branch. */
const more = await Promise.all(
  branches.map((branch) => (brief || branch.article === undefined ? undefined : helpLink(branch.article))),
);
/** Who to ask, for the branches that end with it. */
const contact = !brief && branches.some((branch) => branch.cta === "contact")
  ? await helpLink(CONTACT_ARTICLE)
  : undefined;

const aliases = aliasesFor(ids);
/** The portal's copy has no code to tell anyone. */
const codes = (branch: EntryBranch): string[] =>
  branch.ids.filter((x) => !x.startsWith("portal."));
---

<div class="pk-help-message" data-help-message={id}>
  {
    /* The ids that show the heading's own message anchor at the heading, so arriving at any of
       them shows the title, not a bare quote under it. */
    branches[0]!.ids
      .filter((x) => x !== ids[0])
      .map((x) => <span id={x} class="pk-help-message__anchor" />)
  }
  {/* The title is passed as HTML: AnchorHeading words its screen-reader label from the rendered slot
      and escapes that text again, so an escaped title (Can&#39;t) would be read out as is. Titles hold
      no `&`, `<` or `>` (helpMessages.test.ts). */}
  <AnchorHeading level={2} id={ids[0]!}><Fragment set:html={title} /></AnchorHeading>
  {/* The title again, hidden and weighted, so searching a message's exact title ranks its entry first. */}
  <span hidden data-pagefind-weight="10">{title}</span>
  {
    branches.map((branch, i) => (
      <div class="pk-help-message__branch">
        {i > 0 && branch.ids.map((x) => <span id={x} class="pk-help-message__anchor" />)}
        <blockquote class="pk-help-message__shown">
          <p>
            {messageParts(branch.message).map((part) =>
              typeof part === "string" ? part : <var>{part.label}</var>,
            )}
          </p>
        </blockquote>
        {!brief && branch.why && (
          <p>
            <strong>Why you see this.</strong>{" "}
            {textParts(branch.why).map((part) =>
              typeof part === "string" ? part : <strong>{part.strong}</strong>,
            )}
          </p>
        )}
        {!brief && branch.fix && (
          <p>
            <strong>What to do.</strong>{" "}
            {textParts(branch.fix).map((part) =>
              typeof part === "string" ? part : <strong>{part.strong}</strong>,
            )}
          </p>
        )}
        {!brief && branch.cta === "library" && (
          <p class="pk-help-message__cta">
            <PortalLink to="library">Open your library</PortalLink>
          </p>
        )}
        {more[i] && (
          <p>
            <strong>More help.</strong> <a href={more[i]!.href}>{more[i]!.title}</a>
          </p>
        )}
        {branch.cta === "contact" && contact && (
          <p class="pk-help-message__cta">Still need help? Read <a href={contact.href}>{contact.title}</a>.</p>
        )}
        {codes(branch).length > 0 && (
          <p class="pk-help-message__codes">
            <small>
              {codes(branch).length === 1 ? "Code" : "Codes"}:{" "}
              {codes(branch).map((x, j) => (
                <>
                  {j > 0 && ", "}
                  <code>{x}</code>
                </>
              ))}
            </small>
          </p>
        )}
      </div>
    ))
  }
  {
    aliases.map((alias) => (
      <span hidden lang={alias.lang} data-pagefind-weight="6">
        {alias.title}
      </span>
    ))
  }
</div>
