---
import { BUTTON_BASE, BUTTON_SIZES, BUTTON_VARIANTS } from "../console";
/** A link into the customer portal on the same origin, "Open your library ↗". */
import { portalHref } from "../../lib/portalHref";

export interface Props {
  /** The portal page: `library` is its home, any other is a page of it, e.g. `account` or `account/methods`. */
  to: string;
}

const { to } = Astro.props;
// Customer-facing Help pages take 44 px targets; the developer and operator doors the console's.
const help = Astro.locals.starlightRoute?.id?.startsWith("help/") ?? false;
const buttonClass = `${BUTTON_BASE} ${BUTTON_VARIANTS.outline} ${BUTTON_SIZES.sm} not-content no-underline hover:no-underline my-2 ${help ? "min-h-11 min-w-11 px-4" : ""}`;
---

<a class:list={["pk-portal-link", buttonClass]} href={portalHref(to)} target="_blank" rel="noopener"><slot>Open the portal</slot> ↗</a>
