---
/**
 * The header's brand block: the trimmed outlined lockup from @polaris-key/brand, never the site
 * name set as live text (docs/design/BRAND.md §1.4 and the Don'ts). Polaris Key on the developer
 * and operator doors, Polaris Locker on Help (the customer door, served from polaris.locker).
 *
 * Sizes follow the guides and plrs.im: the Key lockup is the kit's compact one as supplied (Key
 * guide p.2: compact when the full wordmark would shrink the mark below 48 px), 52 px tall and
 * 180 px wide; the Locker lockup is the trimmed horizontal, 23 px tall (189 px wide, over the
 * Locker guide's 180 px minimum on p.7; the name at about 22 px, BRAND.md §1.4). The header supplies the
 * clear space: it is 4 rem tall (global.css). Where a header has no room for 180 px (the Key
 * lockup under 26 rem) the mark stands alone with the same accessible name ("for crowded
 * navigation use the mark alone with an accessible label", Locker guide p.7). The Locker lockup
 * keeps its words on phones down to 20 rem (a 320 px window), since Help is the customer's page
 * and the name is how they know where they are (LF3). Each theme draws its own inks, so both are
 * rendered and the unused one is hidden by class (no inline style; the CSP allows none).
 */
import { lockupSvg, markSvg } from "@polaris-key/brand/svg";
import { doorOf } from "../lib/doors";

const route = Astro.locals.starlightRoute;
const { siteTitleHref } = route;
const miss = route.id === "404";
const isLocker = route.siteTitle === "Polaris Locker" || doorOf(route.id)?.door === "help";
// The page-not-found page is one file for every door: it draws both brands and help.css shows the
// one the address names (components/help/MissingPage.astro).
const kinds: ("key" | "locker")[] = miss ? ["key", "locker"] : [isLocker ? "locker" : "key"];
const themes = ["dark", "light"] as const;
---

{
  kinds.map((kind) => {
    const locker = kind === "locker";
    const name = locker ? "Polaris Locker" : "Polaris Key";
    const height = locker ? 23 : 52;
    return (
      <>
        <a
          href={miss ? (locker ? "/docs/help/" : "/docs/") : siteTitleHref}
          class="site-title pk-site-title sl-flex"
          data-kind={kind}
          data-miss-brand={miss ? kind : undefined}
          aria-label={name}
        >
          <span class="pk-lockup" aria-hidden="true">
            {themes.map((theme) => (
              <span
                class={theme === "dark" ? "light:sl-hidden" : "dark:sl-hidden"}
                set:html={
                  locker
                    ? lockupSvg({ kind, layout: "horizontal", theme, trim: true, height, title: "" })
                    : lockupSvg({ kind, layout: "compact", theme, height, title: "" })
                }
              />
            ))}
          </span>
          <span class="pk-lockup-mark" aria-hidden="true">
            {themes.map((theme) => (
              <span
                class={theme === "dark" ? "light:sl-hidden" : "dark:sl-hidden"}
                set:html={markSvg({ kind, size: 32, theme, title: "" })}
              />
            ))}
          </span>
        </a>
        <span class="pk-help-tag" data-miss-brand={miss ? kind : undefined}>{locker ? "Help" : "Docs"}</span>
      </>
    );
  })
}
