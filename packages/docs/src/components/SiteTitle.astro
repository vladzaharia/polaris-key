---
/**
 * The header's brand block: the Polaris Locker mark from the Locker kit, then the site name as UI
 * text (LK-00 §14.2).
 *
 * The mark is displayed at 32 px, so it is the kit's master cut (24 px and up). Locker has no
 * terminal bit. "dark" means for dark grounds, so each theme shows its own file. The name beside
 * it is not a redrawn wordmark; the mark is decorative (empty alt) because that visible name
 * already labels the link.
 */
import markDark from "@polaris-key/brand/marks/locker/dark-master.svg?url";
import markLight from "@polaris-key/brand/marks/locker/light-master.svg?url";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title pk-site-title sl-flex">
  <img class="pk-site-mark light:sl-hidden" src={markDark} alt="" width="32" height="32" />
  <img class="pk-site-mark dark:sl-hidden" src={markLight} alt="" width="32" height="32" />
  <span translate="no">{siteTitle}</span>
</a>
