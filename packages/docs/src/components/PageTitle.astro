---
/**
 * The page title. On service pages it is preceded by the section's name with its accent marker
 * (BRAND.md §5.4: section chrome only). The marker is decorative; the word names the section,
 * so the section is never told by colour alone (BRAND.md §9).
 *
 * On the developer and Operate doors (docs.reference, docs.operate-guide) the same row: the
 * eyebrow (the section's name on a feature page, else the sidebar group the page sits in, behind
 * "Operate ›" in Operate), the title and Copy page. The landing has the eyebrow and the title.
 *
 * On Help (docs.help-article): the topic's name with the marker, the title, and a Copy page button
 * that copies the page's text. The topic is the sidebar group the page sits in; the home and the
 * messages pages name themselves.
 */
import { helpRoute } from "../lib/helpHost";
import { HELP_ICONS } from "../lib/helpIcons";
import { isServiceSection, sectionFor } from "../lib/section";
import { doorOf } from "../lib/doors";

const route = Astro.locals.starlightRoute;
const section = sectionFor(route.id);
const help = helpRoute(route.id);

interface Node {
  type: string;
  label?: string;
  isCurrent?: boolean;
  entries?: Node[];
}
const holdsCurrent = (n: Node): boolean =>
  n.isCurrent === true || (n.entries ?? []).some(holdsCurrent);
const groupName = (route.sidebar as Node[]).find((n) => n.type === "group" && holdsCurrent(n))?.label;
const topic =
  route.id === "help"
    ? "Help"
    : route.id.startsWith("help/messages")
      ? "Messages"
      : (groupName ?? "Help");
const door = doorOf(route.id)?.door;
const landing = route.id === "" || route.id === "index";
const eyebrow = landing
  ? "Start here"
  : isServiceSection(section)
    ? section.label
    : door === "operate"
      ? groupName === undefined
        ? "Operate"
        : `Operate › ${groupName}`
      : groupName;

// What search shows under a result, and the door filter "Help only" uses (Search.astro): the door's
// name, then the path the page sits in ("Developers › Features › Licensing"). Help names its topic.
const DOOR_NAMES = { help: "Help", developers: "Developers", operate: "Operate" } as const;
const words = (s: string): string => {
  const t = s.replace(/-/g, " ");
  return t.charAt(0).toUpperCase() + t.slice(1);
};
const doorName = door === undefined || door === "landing" ? "developers" : door;
const parts = route.id.split("/").slice(0, -1);
if (doorName === "operate" && parts[0] === "operate") parts.shift();
const trail = [
  DOOR_NAMES[doorName],
  ...(help
    ? topic === "Help"
      ? []
      : [topic]
    : parts.slice(0, 2).map((p, i) =>
        i === 1 && isServiceSection(section) ? section.label : words(p),
      )),
].join(" › ");
---

{
  route.id === "404" ? null : help ? (
    <div class="pk-help-header">
      <meta data-pagefind-filter="door[content]" content={doorName} />
      <meta data-pagefind-meta="trail[content]" content={trail} />
      <p class="pk-eyebrow pk-help-eyebrow">
        <span class="pk-eyebrow__marker" aria-hidden="true" />
        {topic}
      </p>
      <pk-help-copy class="pk-help-titlerow">
        <h1 id="_top" data-page-title>
          {route.entry.data.title}
        </h1>
        {route.id !== "help" && (
          <button type="button" class="pk-help-copy" aria-label="Copy page">
            <span set:html={HELP_ICONS.copy} />
            <span class="pk-help-copy__label">Copy page</span>
          </button>
        )}
      </pk-help-copy>
    </div>
  ) : (
    <div class="pk-doc-header">
      <meta data-pagefind-filter="door[content]" content={doorName} />
      <meta data-pagefind-meta="trail[content]" content={trail} />
      {eyebrow && (
        <p class="pk-eyebrow">
          <span class="pk-eyebrow__marker" aria-hidden="true" />
          {eyebrow}
        </p>
      )}
      <pk-help-copy class="pk-help-titlerow">
        <h1 id="_top" data-page-title>
          {route.entry.data.title}
        </h1>
        {door !== undefined && door !== "landing" && (
          <button type="button" class="pk-help-copy" aria-label="Copy page">
            <span set:html={HELP_ICONS.copy} />
            <span class="pk-help-copy__label">Copy page</span>
          </button>
        )}
      </pk-help-copy>
    </div>
  )
}

<script>
  /** Copy page: the title, then the page's own text. */
  class HelpCopy extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector<HTMLButtonElement>("button");
      const label = button?.querySelector(".pk-help-copy__label");
      button?.addEventListener("click", async () => {
        const title = this.querySelector("h1")?.textContent?.trim() ?? "";
        const body =
          document.querySelector<HTMLElement>(".sl-markdown-content")
            ?.innerText ?? "";
        try {
          await navigator.clipboard.writeText(`${title}\n\n${body.trim()}\n`);
          if (label) label.textContent = "Copied";
        } catch {
          if (label) label.textContent = "Copy failed";
        }
        setTimeout(() => {
          if (label) label.textContent = "Copy page";
        }, 2000);
      });
    }
  }
  if (!customElements.get("pk-help-copy"))
    customElements.define("pk-help-copy", HelpCopy);
</script>
