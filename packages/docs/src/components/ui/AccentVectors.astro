---
/**
 * The accent resolver's output for the spec's named inputs, read from the shared test vectors
 * (packages/brand/fixtures/accent-vectors.json, generated by `pnpm gen brand` through
 * src/accent.ts). Every port reproduces these values exactly, so the table is the resolver.
 */
import vectors from "../../../../brand/fixtures/accent-vectors.json";

/** The UI-KITS.md §3.3 rows: product teal, core violet in each scheme, and Drift Kart's orange. */
const SHOWN: Array<{ name: string; scheme?: "dark" | "light"; label: string }> =
  [
    { name: "tidewater", label: "Tidewater Studio (icon teal)" },
    { name: "core-violet-dark", scheme: "dark", label: "Core violet" },
    { name: "core-violet-light", scheme: "light", label: "Core violet" },
    { name: "drift-kart", label: "Drift Kart (orange)" },
  ];

interface Vector {
  name: string;
  input: string;
  scheme: "dark" | "light";
  expect: Record<"solid" | "on" | "fg" | "subtle" | "focus", string>;
}

const all = (vectors as { resolve: Vector[]; white: string; ink: string })
  .resolve;
const { white, ink } = vectors as { white: string; ink: string };
const rows = SHOWN.flatMap(({ name, scheme, label }) => {
  const found = all.filter(
    (v) => v.name === name && (scheme === undefined || v.scheme === scheme),
  );
  if (found.length === 0) {
    throw new Error(`AccentVectors: no resolve vector named "${name}"`);
  }
  return found.map((v) => ({ ...v, label }));
});
const label = (hex: string): string =>
  hex === white ? "white" : hex === ink ? "ink" : hex;
---

<table class="pk-ui-accents">
  <thead>
    <tr>
      <th scope="col">Input</th>
      <th scope="col">Scheme</th>
      <th scope="col"><code>solid</code></th>
      <th scope="col"><code>on</code></th>
      <th scope="col"><code>fg</code></th>
      <th scope="col"><code>subtle</code></th>
      <th scope="col"><code>focus</code></th>
    </tr>
  </thead>
  <tbody>
    {
      rows.map((v) => (
        <tr>
          <td>
            {v.label} <code>{v.input}</code>
          </td>
          <td>{v.scheme}</td>
          <td>
            <code>{v.expect.solid}</code>
          </td>
          <td>{label(v.expect.on)}</td>
          <td>
            <code>{v.expect.fg}</code>
          </td>
          <td>
            <code>{v.expect.subtle}</code>
          </td>
          <td>
            <code>{v.expect.focus}</code>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
