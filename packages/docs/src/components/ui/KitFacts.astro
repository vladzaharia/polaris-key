---
/**
 * The facts block at the top of a framework page: what the kit is, what a host installs, where
 * its baselines and samples live. The sample row is checked against the repository at build time,
 * so it says "not yet" until `examples/ui/<id>/` (or a folder the kit's `samples` names) exists.
 */
import { DIRS } from "../../lib/baselines";
import { repoHas } from "../../lib/repo";
import { kitById } from "../../lib/uiKits";
import KitStatus from "./KitStatus.astro";

interface Props {
  /** The kit's id in src/lib/uiKits.ts, e.g. "compose". */
  kit: string;
}

const kit = kitById(Astro.props.kit);
const baselines = DIRS[kit.id];
const wanted = kit.samples ?? [`examples/ui/${kit.id}/`];
const samples = wanted.filter((s) => repoHas(s));
---

<table class="pk-ui-facts">
  <tbody>
    <tr>
      <th scope="row">Framework</th>
      <td>{kit.framework}</td>
    </tr>
    <tr>
      <th scope="row">SDK</th>
      <td>{kit.sdk}</td>
    </tr>
    <tr>
      <th scope="row">Status</th>
      <td><KitStatus kit={kit.id} /></td>
    </tr>
    <tr>
      <th scope="row">Package</th>
      <td><code>{kit.package}</code></td>
    </tr>
    <tr>
      <th scope="row">Baselines</th>
      <td>
        {
          baselines === undefined ? (
            <span class="pk-ui-muted">
              No directory of its own in the visual QA report
            </span>
          ) : (
            <code>{baselines}/</code>
          )
        }
      </td>
    </tr>
    <tr>
      <th scope="row">Sample</th>
      <td>
        {
          samples.length > 0 ? (
            samples.map((s, i) => (
              <>
                {i > 0 && ", "}
                <code>{s}</code>
              </>
            ))
          ) : (
            <span class="pk-ui-muted">
              None yet; it goes in <code>{wanted[0]}</code>
            </span>
          )
        }
      </td>
    </tr>
  </tbody>
</table>
