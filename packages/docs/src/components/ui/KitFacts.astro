---
/**
 * The facts block at the top of a framework page: what the kit is, what a host installs, where
 * its baselines and sample live. The sample row is checked against the repository at build time,
 * so it says "not yet" until `examples/ui/<id>/` exists.
 */
import { DIRS } from "../../lib/baselines";
import { repoHas } from "../../lib/repo";
import { kitById } from "../../lib/uiKits";

interface Props {
  /** The kit's id in src/lib/uiKits.ts, e.g. "compose". */
  kit: string;
}

const kit = kitById(Astro.props.kit);
const baselines = DIRS[kit.id];
const sample = `examples/ui/${kit.id}/`;
const hasSample = repoHas(sample);
---

<table class="pk-ui-facts">
  <tbody>
    <tr>
      <th scope="row">Framework</th>
      <td>{kit.framework}</td>
    </tr>
    <tr>
      <th scope="row">SDK</th>
      <td>{kit.sdk}</td>
    </tr>
    <tr>
      <th scope="row">Tier</th>
      <td>{kit.tier}</td>
    </tr>
    <tr>
      <th scope="row">Package</th>
      <td><code>{kit.package}</code></td>
    </tr>
    <tr>
      <th scope="row">Baselines</th>
      <td>
        {
          baselines === undefined ? (
            <span class="pk-ui-muted">
              No directory of its own in the visual QA report
            </span>
          ) : (
            <code>{baselines}/</code>
          )
        }
      </td>
    </tr>
    <tr>
      <th scope="row">Sample</th>
      <td>
        {
          hasSample ? (
            <code>{sample}</code>
          ) : (
            <span class="pk-ui-muted">
              None yet; it goes in <code>{sample}</code>
            </span>
          )
        }
      </td>
    </tr>
  </tbody>
</table>
