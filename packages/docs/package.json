{
  "name": "@polaris-key/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Polaris Key documentation site — an Astro Starlight build served by the worker at key.plrs.im/docs behind the platform-admin gate.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/copy-artifacts.mjs && astro build && node scripts/redirect-fragments.mjs && node scripts/collect-csp-hashes.mjs && node scripts/emit-slug-manifest.mjs",
    "dev": "node scripts/copy-artifacts.mjs && astro dev",
    "typecheck": "astro check",
    "test": "vitest run --passWithNoTests",
    "lint": "prettier --check \"src/**/*.{ts,mdx,css}\" \"scripts/**/*.mjs\"",
    "clean": "rm -rf dist .astro public/schemas public/openapi",
    "gen": "node scripts/gen-reference.mjs",
    "gen:check": "node scripts/gen-reference.mjs --check",
    "check:links": "node scripts/check-links.mjs",
    "lint:docs": "tsx scripts/lint-docs.ts",
    "site-map": "node scripts/site-map.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@polaris-key/brand": "workspace:*",
    "@tailwindcss/vite": "^4.1.4",
    "astro": "^7.3.5",
    "js-yaml": "^4.3.2",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@polaris-key/node": "workspace:*",
    "@polaris-key/react": "workspace:*",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.0",
    "commander": "^14.0.0",
    "react": "^18.3.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
