{
  "name": "@polaris-key/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Polaris Key documentation site — an Astro Starlight build served by the worker at key.plrs.im/docs behind the platform-admin gate.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/copy-artifacts.mjs && astro build && tsx scripts/console-parts.ts && node scripts/redirect-fragments.mjs && node scripts/collect-csp-hashes.mjs && node scripts/emit-slug-manifest.mjs && tsx scripts/collect-docs-tiers.ts && tsx scripts/build-search-bundles.ts",
    "dev": "node scripts/copy-artifacts.mjs && astro dev",
    "typecheck": "astro check",
    "test": "vitest run --passWithNoTests",
    "lint": "prettier --check \"src/**/*.{ts,mdx,css}\" \"scripts/**/*.mjs\"",
    "clean": "rm -rf dist .astro public/schemas public/openapi",
    "gen": "tsx scripts/gen-reference.mjs",
    "gen:check": "tsx scripts/gen-reference.mjs --check",
    "check:links": "node scripts/check-links.mjs",
    "lint:docs": "tsx scripts/lint-docs.ts",
    "site-map": "node scripts/site-map.mjs",
    "test:browser": "node scripts/smoke-browser.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/starlight": "^0.42.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@polaris-key/brand": "workspace:*",
    "@tailwindcss/vite": "^4.1.4",
    "astro": "^7.3.5",
    "js-yaml": "^5.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@polaris-key/node": "workspace:*",
    "@polaris-key/react": "workspace:*",
    "@polaris-key/server": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/yargs": "^17.0.33",
    "@types/node": "^22.14.0",
    "axe-core": "^4.13.0",
    "pagefind": "^1.5.2",
    "playwright": "1.63.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "commander": "^15.0.0",
    "express": "^5.1.0",
    "hono": "^4.7.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11",
    "yargs": "^18.2.0",
    "fastify": "^5.2.0",
    "koa": "^3.0.0",
    "@types/koa": "^2.15.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "@koa/router": "^15.7.0"
  }
}
