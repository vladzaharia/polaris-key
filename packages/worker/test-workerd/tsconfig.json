{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "lib": ["ES2023"],
    // `node` is here for `nodejs_compat` (wrangler.toml), which is what the `node:crypto`
    // imports in src/ and this lane resolve to in workerd; Cloudflare's own typing advice for
    // that flag is @types/node. Until vitest 4 it arrived implicitly through vitest's types.
    // `@cloudflare/vitest-pool-workers/types` supplies the ambient `cloudflare:test` module.
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types",
      "node"
    ]
  },
  // Just this directory (plus whatever it imports). `src` and `test` are already covered by
  // the package's own `tsc --noEmit`; duplicating them here would only make this lane fail
  // for reasons that have nothing to do with it.
  "include": ["."]
}
