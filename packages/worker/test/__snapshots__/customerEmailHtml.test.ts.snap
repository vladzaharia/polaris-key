// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`every customer email > is Polaris Locker, ink and neutral, with a plain-text part that mirrors the HTML 1`] = `
{
  "account-deleted": "<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Your Polaris Locker account has been deleted</title>
<style>:root{color-scheme:light dark;supported-color-schemes:light dark}body{margin:0;padding:0}@media (max-width:480px){.pk-key{font-size:14px!important;line-height:22px!important;padding:12px!important}}@media (prefers-color-scheme: dark){.pk-bg{background-color:#060912 !important}.pk-card{background-color:#0d111b !important;border-color:#212633 !important}.pk-strong{color:#ffffff !important}.pk-text{color:#dbe4ff !important}.pk-muted{color:#b5bed3 !important}.pk-key{background-color:#060912 !important;border-color:#212633 !important}.pk-callout{background-color:#060912 !important;border-color:#212633 !important}.pk-btn{background-color:#f6f8ff !important}.pk-btn-a{color:#060912 !important}.pk-link{color:#ffffff !important}.pk-logo-light{display:none !important}.pk-logo-dark{display:block !important;max-height:none !important}}[data-ogsc] .pk-bg{background-color:#060912 !important}[data-ogsc] .pk-card{background-color:#0d111b !important;border-color:#212633 !important}[data-ogsc] .pk-strong{color:#ffffff !important}[data-ogsc] .pk-text{color:#dbe4ff !important}[data-ogsc] .pk-muted{color:#b5bed3 !important}[data-ogsc] .pk-key{background-color:#060912 !important;border-color:#212633 !important}[data-ogsc] .pk-callout{background-color:#060912 !important;border-color:#212633 !important}[data-ogsc] .pk-btn{background-color:#f6f8ff !important}[data-ogsc] .pk-btn-a{color:#060912 !important}[data-ogsc] .pk-link{color:#ffffff !important}[data-ogsc] .pk-logo-light{display:none !important}[data-ogsc] .pk-logo-dark{display:block !important;max-height:none !important}</style>
</head>
<body class="pk-bg" style="margin:0;padding:0;background-color:#f6f8ff">
<table role="presentation" class="pk-bg" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f6f8ff" style="width:100%;background-color:#f6f8ff">
<tr><td align="center" style="padding:32px 16px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:520px">
<tr><td align="center" style="padding:0 0 0px;text-align:center"><img class="pk-logo-light" src="https://key.plrs.im/assets/branding/locker/locker-horizontal-light-640.png" width="230" height="64" alt="Polaris Locker" style="display:block;margin:0 auto;width:230px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none"><!--[if !mso]><!--><img class="pk-logo-dark" src="https://key.plrs.im/assets/branding/locker/locker-horizontal-dark-640.png" width="230" height="64" alt="Polaris Locker" style="display:none;margin:0 auto;max-height:0;overflow:hidden;mso-hide:all;width:230px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none"><!--<![endif]--></td></tr>
<tr><td class="pk-card" bgcolor="#ffffff" style="padding:32px;background-color:#ffffff;border:1px solid #dadee9;border-radius:10px">
<h1 class="pk-strong" style="margin:0 0 16px;font-family:'Rubik', 'Rubik Fallback', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:24px;line-height:32px;font-weight:700;letter-spacing:-0.01em;color:#060912">Your Polaris Locker account has been deleted</h1>
<p class="pk-text" style="margin:0 0 16px;font-family:'Rubik', 'Rubik Fallback', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:16px;line-height:24px;color:#262d40">Your Polaris Locker account, its email addresses and its sign-in methods have been erased, as you asked.</p>
<p class="pk-text" style="margin:0 0 16px;font-family:'Rubik', 'Rubik Fallback', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:16px;line-height:24px;color:#262d40">Deleting it doesn&#x27;t cancel your licenses: they stay with each developer, and you can add them again with a new account. To have a developer erase its own records, contact that developer&#x27;s support.</p>
</td></tr>
<tr><td class="pk-muted" style="padding:24px 8px 0;font-family:'Rubik', 'Rubik Fallback', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:13px;line-height:20px;color:#48536b">You are receiving this because your Polaris Locker account was deleted. We sent it to every verified email on the account.</td></tr>
</table>
</td></tr>
</table>
</body>
</html>",
  "accounts-merged": "<!doctype html>
<html lang="en">
<head>
