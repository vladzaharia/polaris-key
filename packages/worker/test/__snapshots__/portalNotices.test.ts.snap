<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0 16px"><tr><td class="pk-callout" bgcolor="#f6f8ff" style="padding:12px 16px;background-color:#f6f8ff;border:1px solid #dadee9;border-radius:6px;font-family:'Rubik', 'Rubik Fallback', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:15px;line-height:22px;color:#262d40"><span class="pk-text"><strong style="font-weight:600">Wasn&#x27;t you?</strong> <a class="pk-link" href="https://key.plrs.im/#/account/methods" style="color:#060912;text-decoration:underline">Secure your account</a></span></td></tr></table>
</td></tr>
<tr><td class="pk-muted" style="padding:24px 8px 0;font-family:'Rubik', 'Rubik Fallback', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:13px;line-height:20px;color:#48536b">You are receiving this because of a change to your Polaris Locker account. We sent it to every verified email on the account.<br><a class="pk-link" href="https://key.plrs.im/docs/help/secure-your-account/" style="color:#48536b;text-decoration:underline">How to secure your account</a> &middot; <a class="pk-link" href="https://key.plrs.im/docs/help/what-is-polaris-locker/" style="color:#48536b;text-decoration:underline">What is Polaris Locker?</a> &middot; <a class="pk-link" href="https://key.plrs.im/docs/help/emails/#sign-in-method-removed" style="color:#48536b;text-decoration:underline">About this email</a></td></tr>
</table>
</td></tr>
</table>
</body>
</html>"
`;

