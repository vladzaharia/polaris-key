exports[`notice templates: copy > accountDeleted: subject and plain text 1`] = `
{
  "subject": "Your Polaris Locker account has been deleted",
  "text": "Your Polaris Locker account has been deleted

Your Polaris Locker account, its email addresses and its sign-in methods have been erased, as you asked.

Deleting it doesn't cancel your licenses: they stay with each developer, and you can add them again with a new account. To have a developer erase its own records, contact that developer's support.

You are receiving this because your Polaris Locker account was deleted. We sent it to every verified email on the account.

What is Polaris Locker? https://key.plrs.im/docs/help/what-is-polaris-locker/

About this email: https://key.plrs.im/docs/help/emails/#account-deleted",
}
`;

exports[`notice templates: copy > accountDeletionCancelled: subject and plain text 1`] = `
{
  "subject": "Your Polaris Locker account deletion was canceled",
  "text": "Your Polaris Locker account deletion was canceled

Your Polaris Locker account will stay active. No account data will be erased.

Review account settings: https://key.plrs.im/#/account/data

Wasn't you? Secure your account: https://key.plrs.im/#/account/methods

You are receiving this because of a change to your Polaris Locker account. We sent it to every verified email on the account.

How to secure your account: https://key.plrs.im/docs/help/secure-your-account/

What is Polaris Locker? https://key.plrs.im/docs/help/what-is-polaris-locker/

About this email: https://key.plrs.im/docs/help/emails/#account-deletion-cancelled",
}
`;

exports[`notice templates: copy > accountDeletionScheduled: subject and plain text 1`] = `
{
  "subject": "Your Polaris Locker account is scheduled for deletion",
  "text": "Your Polaris Locker account is scheduled for deletion

Your Polaris Locker account is scheduled to be erased unless you cancel the deletion before then.

Your account stays active during that 14-day period. Deleting it does not cancel your licenses: they stay with each developer, and you can add them again with a new account.

Erased on 2023-11-28 22:13 UTC.

Review account settings: https://key.plrs.im/#/account/data

Wasn't you? Secure your account: https://key.plrs.im/#/account/methods

You are receiving this because of a change to your Polaris Locker account. We sent it to every verified email on the account.

How to secure your account: https://key.plrs.im/docs/help/secure-your-account/

What is Polaris Locker? https://key.plrs.im/docs/help/what-is-polaris-locker/

About this email: https://key.plrs.im/docs/help/emails/#account-deletion-scheduled",
}
`;

exports[`notice templates: copy > assignedToYou: subject and plain text 1`] = `
{
  "subject": "A Mossgarden license was assigned to you",
  "text": "A Mossgarden license was assigned to you

The developer of Mossgarden assigned one of its licenses to this email address.

Sign in to Polaris Locker with this email address to find it in your library.

Open Mossgarden: https://key.plrs.im/#/p/mossgarden

You are receiving this because a developer issued a license to this email address.

What is Polaris Locker? https://key.plrs.im/docs/help/what-is-polaris-locker/

About this email: https://key.plrs.im/docs/help/emails/#license-assigned-to-you",
}
`;

exports[`notice templates: copy > deviceRemoved: subject and plain text 1`] = `
{
  "subject": "Studio PC was removed from Tidewater Studio",
  "text": "Studio PC was removed from Tidewater Studio

Studio PC was removed from your Tidewater Studio license and no longer counts toward its device limit.

To use Tidewater Studio on it again, sign in to Tidewater Studio on that device.

See your devices: https://key.plrs.im/#/p/tidewater/devices

Wasn't you? Secure your account: https://key.plrs.im/#/account/methods

You are receiving this because of a change to your Polaris Locker account. We sent it to every verified email on the account.

How to secure your account: https://key.plrs.im/docs/help/secure-your-account/

What is Polaris Locker? https://key.plrs.im/docs/help/what-is-polaris-locker/

About this email: https://key.plrs.im/docs/help/emails/#device-removed",
}
`;

exports[`notice templates: copy > deviceReplaced: subject and plain text 1`] = `
{
  "subject": "Diceroll signed out on Work laptop",
  "text": "Diceroll signed out on Work laptop

Work laptop was replaced by Mara's Pixel 8 when you signed in to Diceroll on 14 Nov 2023, 22:13 UTC. It can sign in again later if there is room for another device. If this wasn't you, open Polaris Locker and check your devices.

Open Polaris Locker: https://key.plrs.im/#/p/diceroll/devices

Wasn't you? Secure your account: https://key.plrs.im/#/account/methods

You are receiving this because of a change to your Polaris Locker account. We sent it to every verified email on the account.

How to secure your account: https://key.plrs.im/docs/help/secure-your-account/

What is Polaris Locker? https://key.plrs.im/docs/help/what-is-polaris-locker/

About this email: https://key.plrs.im/docs/help/emails/#device-replaced",
}
`;

exports[`notice templates: copy > downloadLink: subject and plain text 1`] = `
{
  "subject": "Download Mossgarden for macOS",
  "text": "Download Mossgarden for macOS

Here is the macOS download you asked for. Open this email on the device you want to install Mossgarden on.

The link opens your Polaris Locker library, so you may be asked to sign in first.

Download Mossgarden: https://key.plrs.im/#/p/mossgarden/download?platform=macos

You are receiving this because you asked Polaris Locker to email you a download link. If you didn't, you can ignore it: the link only opens your own library.

What is Polaris Locker? https://key.plrs.im/docs/help/what-is-polaris-locker/

About this email: https://key.plrs.im/docs/help/emails/#download-link",
}
`;

exports[`notice templates: copy > full HTML of a plain notice and a security notice 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Mossgarden is in your library</title>
<style>:root{color-scheme:light dark;supported-color-schemes:light dark}body{margin:0;padding:0}@media (max-width:480px){.pk-key{font-size:14px!important;line-height:22px!important;padding:12px!important}}@media (prefers-color-scheme: dark){.pk-bg{background-color:#060912 !important}.pk-card{background-color:#0d111b !important;border-color:#212633 !important}.pk-strong{color:#ffffff !important}.pk-text{color:#dbe4ff !important}.pk-muted{color:#b5bed3 !important}.pk-key{background-color:#060912 !important;border-color:#212633 !important}.pk-callout{background-color:#060912 !important;border-color:#212633 !important}.pk-btn{background-color:#f6f8ff !important}.pk-btn-a{color:#060912 !important}.pk-link{color:#ffffff !important}.pk-logo-light{display:none !important}.pk-logo-dark{display:block !important;max-height:none !important}}[data-ogsc] .pk-bg{background-color:#060912 !important}[data-ogsc] .pk-card{background-color:#0d111b !important;border-color:#212633 !important}[data-ogsc] .pk-strong{color:#ffffff !important}[data-ogsc] .pk-text{color:#dbe4ff !important}[data-ogsc] .pk-muted{color:#b5bed3 !important}[data-ogsc] .pk-key{background-color:#060912 !important;border-color:#212633 !important}[data-ogsc] .pk-callout{background-color:#060912 !important;border-color:#212633 !important}[data-ogsc] .pk-btn{background-color:#f6f8ff !important}[data-ogsc] .pk-btn-a{color:#060912 !important}[data-ogsc] .pk-link{color:#ffffff !important}[data-ogsc] .pk-logo-light{display:none !important}[data-ogsc] .pk-logo-dark{display:block !important;max-height:none !important}</style>
</head>
<body class="pk-bg" style="margin:0;padding:0;background-color:#f6f8ff">
<table role="presentation" class="pk-bg" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f6f8ff" style="width:100%;background-color:#f6f8ff">
<tr><td align="center" style="padding:32px 16px">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:520px">
<tr><td align="center" style="padding:0 0 0px;text-align:center"><img class="pk-logo-light" src="https://key.plrs.im/assets/branding/locker/locker-horizontal-light-640.png" width="230" height="64" alt="Polaris Locker" style="display:block;margin:0 auto;width:230px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none"><!--[if !mso]><!--><img class="pk-logo-dark" src="https://key.plrs.im/assets/branding/locker/locker-horizontal-dark-640.png" width="230" height="64" alt="Polaris Locker" style="display:none;margin:0 auto;max-height:0;overflow:hidden;mso-hide:all;width:230px;max-width:100%;height:auto;border:0;outline:none;text-decoration:none"><!--<![endif]--></td></tr>
<tr><td class="pk-card" bgcolor="#ffffff" style="padding:32px;background-color:#ffffff;border:1px solid #dadee9;border-radius:10px">
<h1 class="pk-strong" style="margin:0 0 16px;font-family:'Rubik', 'Rubik Fallback', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:24px;line-height:32px;font-weight:600;letter-spacing:-0.01em;color:#060912">Mossgarden is in your library</h1>
<p class="pk-text" style="margin:0 0 16px;font-family:'Rubik', 'Rubik Fallback', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:16px;line-height:24px;color:#262d40">Mossgarden was added to your Polaris Locker account with a license key.</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:8px 0 24px"><tr><td class="pk-btn" bgcolor="#060912" style="border-radius:6px;background-color:#060912"><a class="pk-btn-a" href="https://key.plrs.im/#/p/mossgarden" style="display:inline-block;padding:12px 24px;font-family:'Rubik', 'Rubik Fallback', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:16px;line-height:20px;font-weight:500;color:#ffffff;text-decoration:none;border-radius:6px">Open Mossgarden</a></td></tr></table><p class="pk-muted" style="margin:0 0 16px;font-family:'Rubik', 'Rubik Fallback', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:16px;line-height:24px;color:#48536b">If the button does not work, paste this link into your browser:</p><p style="margin:0;font-family:'JetBrains Mono', 'JetBrains Mono Fallback', ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;font-size:13px;line-height:20px;word-break:break-all"><a class="pk-link" href="https://key.plrs.im/#/p/mossgarden" style="color:#060912;text-decoration:underline">https://key.plrs.im/#/p/mossgarden</a></p>
</td></tr>
<tr><td class="pk-muted" style="padding:24px 8px 0;font-family:'Rubik', 'Rubik Fallback', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;font-size:13px;line-height:20px;color:#48536b">You are receiving this because of a change to your Polaris Locker account.<br><a class="pk-link" href="https://key.plrs.im/docs/help/what-is-polaris-locker/" style="color:#48536b;text-decoration:underline">What is Polaris Locker?</a> &middot; <a class="pk-link" href="https://key.plrs.im/docs/help/emails/#license-added" style="color:#48536b;text-decoration:underline">About this email</a></td></tr>
</table>
</td></tr>
</table>
</body>
</html>"
`;

exports[`notice templates: copy > full HTML of a plain notice and a security notice 2`] = `
