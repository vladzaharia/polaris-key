exports[`notice templates: copy > licenseAdded: subject and plain text 1`] = `
{
  "subject": "Mossgarden is in your library",
  "text": "Mossgarden was added to your Polaris Key account with a license key.

Open Mossgarden: https://key.plrs.im/#/p/mossgarden

You are receiving this because of a change to your Polaris Key account.",
}
`;

exports[`notice templates: copy > methodAdded: subject and plain text 1`] = `
{
  "subject": "Steam was connected to your Polaris Key account",
  "text": "Steam was added as a way to sign in to your Polaris Key account.

See your sign-in methods: https://key.plrs.im/#/account/methods

Wasn't you? Secure your account: https://key.plrs.im/#/account/methods

You are receiving this because of a change to your Polaris Key account. We sent it to every verified email on the account.",
}
`;

