{
  "name": "@polaris-key/worker",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "assemble": "node scripts/assemble-assets.mjs",
    "feed:seq-ceiling": "node scripts/feed-seq-ceiling.mjs",
    "email:dns-check": "../../node_modules/.bin/tsx scripts/check-email-dns.ts",
    "signin:seal": "../../node_modules/.bin/tsx scripts/seal-signin-secret.ts",
    "override-migration:dry-run": "../../node_modules/.bin/tsx scripts/override-migration-dry-run.ts",
    "grace-clamp:report": "../../node_modules/.bin/tsx scripts/grace-clamp-report.ts",
    "test": "vitest run",
    "test:workerd": "vitest run --config vitest.workers.config.ts && vitest run --config vitest.deltas.workers.config.ts",
    "typecheck:workerd": "tsc -p test-workerd && tsc -p test-workerd-deltas",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"test-workerd/**/*.ts\" \"test-workerd-deltas/**/*.ts\"",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dryrun": "wrangler deploy --dry-run",
    "check:representable": "node scripts/check-representable.mjs",
    "registry:clients": "node scripts/registry-clients/run.mjs",
    "registry:self-publish": "../../node_modules/.bin/tsx scripts/registry-clients/self-publish.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@polaris-key/brand": "workspace:*",
    "@polaris-key/catalog": "workspace:*",
    "@polaris-key/client-core": "workspace:*",
    "@polaris-key/jws": "workspace:*",
    "@polaris-key/manifest": "workspace:*",
    "@polaris-key/protocol": "workspace:*",
    "@polaris-key/zstd-wasm": "workspace:*",
    "@simplewebauthn/server": "14.0.3",
    "jose": "^5.9.6",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.19.1",
    "@cloudflare/workers-types": "^4.20251001.0",
    "@polaris-key/cli": "workspace:*",
    "@polaris-key/node": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^11.8.0",
    "wrangler": "4.116.0"
  }
}
