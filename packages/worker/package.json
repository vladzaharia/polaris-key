{
  "name": "@plrs/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:workerd": "vitest run --config vitest.workers.config.ts",
    "typecheck:workerd": "tsc -p test-workerd",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"test-workerd/**/*.ts\"",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dryrun": "wrangler deploy --dry-run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@plrs/catalog": "workspace:*",
    "@plrs/jws": "workspace:*",
    "@plrs/manifest": "workspace:*",
    "@plrs/protocol": "workspace:*",
    "jose": "^5.9.6",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "^4.20251001.0",
    "@plrs/node": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "better-sqlite3": "^11.8.0",
    "wrangler": "^4.40.0"
  }
}
