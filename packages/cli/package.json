{
  "name": "@polaris-key/cli",
  "version": "0.0.0",
  "description": "The pkey CLI: validate and register .pkey/ manifests, mint offline activation bundles, publish releases from CI, configure SDKs and generate typed config mirrors.",
  "keywords": [
    "polaris-key",
    "pkey",
    "cli",
    "licensing",
    "managed-config",
    "release-delivery",
    "manifest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladzaharia/polaris-key.git",
    "directory": "packages/cli"
  },
  "homepage": "https://key.plrs.im/docs/reference/cli/",
  "bugs": {
    "url": "https://github.com/vladzaharia/polaris-key/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "pkey": "./dist/bin/pkey.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mirrors": {
      "types": "./dist/mirrors.d.ts",
      "default": "./dist/mirrors.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/bundle-dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "clean": "rm -rf dist",
    "bundle:action": "node scripts/bundle-action.mjs",
    "bundle:dev": "node scripts/bundle-dev.mjs"
  },
  "dependencies": {
    "@polaris-key/catalog": "workspace:*",
    "@polaris-key/client-core": "workspace:*",
    "@polaris-key/jws": "workspace:*",
    "@polaris-key/manifest": "workspace:*",
    "@polaris-key/node": "workspace:*",
    "@polaris-key/protocol": "workspace:*",
    "@polaris-key/zstd-wasm": "workspace:*",
    "sharp": "^0.35.4",
    "smol-toml": "1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.1"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.0"
  }
}
