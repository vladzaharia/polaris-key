{
  "name": "@polaris-key/cli",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pkey": "./dist/bin/pkey.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "clean": "rm -rf dist",
    "bundle:action": "node scripts/bundle-action.mjs"
  },
  "dependencies": {
    "@polaris-key/client-core": "workspace:*",
    "@polaris-key/jws": "workspace:*",
    "@polaris-key/manifest": "workspace:*",
    "@polaris-key/protocol": "workspace:*",
    "@polaris-key/zstd-wasm": "workspace:*",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "esbuild": "0.27.7"
  }
}
