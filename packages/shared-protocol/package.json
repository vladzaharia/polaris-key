{
  "name": "@polaris-key/protocol",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./license": {
      "types": "./dist/license.d.ts",
      "default": "./dist/license.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "default": "./dist/release.js"
    },
    "./update": {
      "types": "./dist/update.d.ts",
      "default": "./dist/update.js"
    },
    "./trust": {
      "types": "./dist/trust.d.ts",
      "default": "./dist/trust.js"
    },
    "./distribution": {
      "types": "./dist/distribution.d.ts",
      "default": "./dist/distribution.js"
    },
    "./packs": {
      "types": "./dist/packs.d.ts",
      "default": "./dist/packs.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/license.ts src/config.ts src/release.ts src/update.ts src/trust.ts src/distribution.ts src/packs.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  }
}
