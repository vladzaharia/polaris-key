{
  "name": "@polaris-key/protocol",
  "version": "0.0.0",
  "description": "The Polaris Key wire types: request, response and document shapes for every service, as per-service subpath exports.",
  "keywords": [
    "polaris-key",
    "protocol",
    "wire-format",
    "types",
    "licensing",
    "managed-config"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladzaharia/polaris-key.git",
    "directory": "packages/shared-protocol"
  },
  "homepage": "https://key.plrs.im/docs/reference/protocol/",
  "bugs": {
    "url": "https://github.com/vladzaharia/polaris-key/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./license": {
      "types": "./dist/license.d.ts",
      "default": "./dist/license.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./release": {
      "types": "./dist/release.d.ts",
      "default": "./dist/release.js"
    },
    "./update": {
      "types": "./dist/update.d.ts",
      "default": "./dist/update.js"
    },
    "./trust": {
      "types": "./dist/trust.d.ts",
      "default": "./dist/trust.js"
    },
    "./distribution": {
      "types": "./dist/distribution.d.ts",
      "default": "./dist/distribution.js"
    },
    "./packs": {
      "types": "./dist/packs.d.ts",
      "default": "./dist/packs.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    },
    "./sync": {
      "types": "./dist/sync.d.ts",
      "default": "./dist/sync.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/core.ts src/license.ts src/config.ts src/release.ts src/update.ts src/trust.ts src/distribution.ts src/packs.ts src/identity.ts src/sync.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  }
}
