{
  "name": "@polaris-key/node",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@polaris-key/catalog": "workspace:*",
    "@polaris-key/jws": "workspace:*",
    "@polaris-key/protocol": "workspace:*"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.1.6"
  },
  "peerDependencies": {
    "commander": "^12.0.0 || ^13.0.0 || ^14.0.0",
    "yargs": "^17.0.0 || ^18.0.0"
  },
  "peerDependenciesMeta": {
    "commander": {
      "optional": true
    },
    "yargs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/yargs": "^17.0.33",
    "commander": "^14.0.0",
    "yargs": "^18.0.0"
  }
}
