{
  "name": "@polaris-key/node",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/electron/preload.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./license": {
      "types": "./dist/license/index.d.ts",
      "default": "./dist/license/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./devices": {
      "types": "./dist/devices/index.d.ts",
      "default": "./dist/devices/index.js"
    },
    "./identity": {
      "types": "./dist/identity/client.d.ts",
      "default": "./dist/identity/client.js"
    },
    "./release": {
      "types": "./dist/release/client.d.ts",
      "default": "./dist/release/client.js"
    },
    "./update": {
      "types": "./dist/update/client.d.ts",
      "default": "./dist/update/client.js"
    },
    "./packs": {
      "types": "./dist/packs/index.d.ts",
      "default": "./dist/packs/index.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "default": "./dist/local/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    },
    "./terminal": {
      "types": "./dist/cli/term/index.d.ts",
      "default": "./dist/cli/term/index.js"
    },
    "./commerce": {
      "types": "./dist/commerce/index.d.ts",
      "default": "./dist/commerce/index.js"
    },
    "./distribution": {
      "types": "./dist/distribution/client.d.ts",
      "default": "./dist/distribution/client.js"
    },
    "./qr": {
      "types": "./dist/qr/index.d.ts",
      "default": "./dist/qr/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./electron": {
      "types": "./dist/electron/index.d.ts",
      "default": "./dist/electron/index.js"
    },
    "./electron/preload": {
      "types": "./dist/electron/preload.d.ts",
      "default": "./dist/electron/preload.js"
    },
    "./electron/renderer": {
      "types": "./dist/electron/renderer.d.ts",
      "default": "./dist/electron/renderer.js"
    },
    "./update/drivers": {
      "types": "./dist/update/drivers/index.d.ts",
      "default": "./dist/update/drivers/index.js"
    },
    "./update/drivers/electron-updater": {
      "types": "./dist/update/drivers/electronUpdater.d.ts",
      "default": "./dist/update/drivers/electronUpdater.js"
    },
    "./update/drivers/velopack": {
      "types": "./dist/update/drivers/velopack.d.ts",
      "default": "./dist/update/drivers/velopack.js"
    },
    "./update/drivers/sea": {
      "types": "./dist/update/drivers/sea.d.ts",
      "default": "./dist/update/drivers/sea.js"
    },
    "./update/drivers/store-link": {
      "types": "./dist/update/drivers/storeLink.d.ts",
      "default": "./dist/update/drivers/storeLink.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@polaris-key/catalog": "workspace:*",
    "@polaris-key/client-core": "workspace:*",
    "@polaris-key/jws": "workspace:*",
    "@polaris-key/protocol": "workspace:*",
    "@polaris-key/ui-core": "workspace:*",
    "@polaris-key/zstd-wasm": "workspace:*"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  },
  "peerDependencies": {
    "commander": "^12.0.0 || ^13.0.0 || ^14.0.0",
    "yargs": "^17.0.0 || ^18.0.0"
  },
  "peerDependenciesMeta": {
    "commander": {
      "optional": true
    },
    "yargs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@polaris-key/react": "workspace:*",
    "@types/node": "^22.14.0",
    "@types/yargs": "^17.0.33",
    "@xterm/headless": "^6.0.0",
    "commander": "^14.0.0",
    "yargs": "^18.0.0"
  }
}
