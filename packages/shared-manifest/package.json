{
  "name": "@polaris-key/manifest",
  "version": "0.0.0",
  "description": "Parse and validate Polaris Key .pkey/ manifests (product, catalog, release, distribution), with their JSON Schemas.",
  "keywords": [
    "polaris-key",
    "manifest",
    "json-schema",
    "validation",
    "pkey"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladzaharia/polaris-key.git",
    "directory": "packages/shared-manifest"
  },
  "homepage": "https://key.plrs.im/docs/build/manifest/",
  "bugs": {
    "url": "https://github.com/vladzaharia/polaris-key/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "prettier --check \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@polaris-key/catalog": "workspace:*",
    "@polaris-key/protocol": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
