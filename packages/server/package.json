{
  "name": "@polaris-key/server",
  "version": "0.0.0",
  "description": "Gate a server route with the app's signed Polaris Key license, verified offline: a Fetch core plus Express, Hono, Next.js, Fastify, NestJS and Koa drop-ins.",
  "keywords": [
    "polaris-key",
    "licensing",
    "middleware",
    "express",
    "hono",
    "nextjs",
    "jws",
    "ed25519",
    "fastify",
    "nestjs",
    "koa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladzaharia/polaris-key.git",
    "directory": "packages/server"
  },
  "homepage": "https://key.plrs.im/docs/build/sdks/",
  "bugs": {
    "url": "https://github.com/vladzaharia/polaris-key/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "default": "./dist/nestjs.js"
    },
    "./koa": {
      "types": "./dist/koa.d.ts",
      "default": "./dist/koa.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@polaris-key/client-core": "workspace:*",
    "@polaris-key/jws": "workspace:*",
    "@polaris-key/protocol": "workspace:*"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "hono": "^4.0.0",
    "next": ">=14.0.0 <17",
    "@types/express": "^4.17.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0",
    "koa": "^2.14.0 || ^3.0.0",
    "@types/koa": "^2.14.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/core": {
      "optional": true
    },
    "koa": {
      "optional": true
    },
    "@types/koa": {
      "optional": true
    }
  },
  "devDependencies": {
    "@koa/router": "^15.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@polaris-key/node": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/koa": "^2.15.0",
    "@types/node": "^22.20.5",
    "express": "^5.1.0",
    "fastify": "^5.2.0",
    "hono": "^4.7.0",
    "koa": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  }
}
