{
  "$comment": "The per-kit equivalents of the modernity lint (UI-KITS.md §7.3), as source rules over each native kit. Read by bin/kit-lint.mjs (zero dependencies, so every kit's CI lane can run it with plain Node) and by `pnpm ui:lint`. A file whose first 400 bytes say GENERATED is skipped (the brand generator owns it). A line containing `ui-lint: allow <rule-id>` and a reason is exempt from that rule. Debt that existed when this landed is in kit-debt.json; the lint fails on anything new and on debt that is gone.",
  "kits": {
    "swiftui": {
      "roots": ["sdks/swift/Sources/PolarisKeyUI"],
      "extensions": [".swift"]
    },
    "compose": {
      "roots": [
        "sdks/kotlin/ui/src/commonMain/kotlin",
        "sdks/kotlin/ui/src/androidMain/kotlin"
      ],
      "extensions": [".kt"]
    },
    "godot": {
      "roots": ["sdks/godot/addons/polaris_key/ui"],
      "extensions": [".gd", ".tscn", ".tres"]
    },
    "qt": {
      "roots": ["sdks/python/src/polaris_key/ui/qt"],
      "extensions": [".py", ".qml", ".qss"]
    },
    "terminal-python": {
      "roots": [
        "sdks/python/src/polaris_key/ui/terminal",
        "sdks/python/src/polaris_key/ui/core"
      ],
      "extensions": [".py"]
    },
    "terminal-node": {
      "roots": ["packages/sdk-node/src/cli"],
      "extensions": [".ts"]
    },
    "react": {
      "roots": [
        "packages/sdk-react/src/components",
        "packages/sdk-react/src/kit"
      ],
      "extensions": [".ts", ".tsx"]
    }
  },
  "rules": [
    {
      "id": "swiftui-border-shape",
      "kit": "swiftui",
      "pattern": "\\.buttonBorderShape\\(\\s*\\.roundedRectangle",
      "spec": "§7.3 per-kit, §1.4",
      "says": "No .buttonBorderShape(.roundedRectangle) override: iOS 26 buttons keep the system capsule shape."
    },
    {
      "id": "swiftui-rtl",
      "kit": "swiftui",
      "pattern": "\\.padding\\(\\s*\\[?\\s*\\.(left|right)\\b|textAlignment\\s*=\\s*\\.(left|right)\\b|Edge\\.Set\\.(left|right)\\b",
      "spec": "§4.7, §7.3",
      "says": "RTL-safe layout: .leading/.trailing, never .left/.right."
    },
    {
      "id": "swiftui-system-alert",
      "kit": "swiftui",
      "pattern": "\\bNSAlert\\(|\\bUIAlertController\\(",
      "spec": "§1.5 rule 3",
      "says": "No default system alerts for anything the kit owns; use the kit's sheet or inline confirm (a destructive Replace may use .confirmationDialog, SIGN-IN.md D-80)."
    },
    {
      "id": "swiftui-uppercase",
      "kit": "swiftui",
      "pattern": "\\.textCase\\(\\s*\\.uppercase\\s*\\)",
      "spec": "§1.5 rule 6",
      "says": "No all-caps labels."
    },
    {
      "id": "swiftui-colour-literal",
      "kit": "swiftui",
      "pattern": "\\bColor\\(\\s*(red|\\.sRGB|\\.displayP3|white|hex)\\b|\\bUIColor\\(\\s*(red|white|hex)\\b|\\bNSColor\\(\\s*(red|calibratedRed|srgbRed|white)\\b",
      "spec": "§2.1, §7.3",
      "says": "No colour literal outside the generated tokens (KitTokens, BrandTokens).",
      "exclude": ["PolarisAccent\\.swift$"]
    },
    {
      "id": "compose-outlined-field",
      "kit": "compose",
      "pattern": "\\bOutlinedTextField\\b",
      "spec": "§1.5 rule 1, §7.3 per-kit",
      "says": "Android uses the M3 filled field, never the outlined or notched one."
    },
    {
      "id": "compose-legacy-icons",
      "kit": "compose",
      "pattern": "\\bIcons\\.Filled\\.|androidx\\.compose\\.material\\.icons\\.filled",
      "spec": "§7.3 per-kit",
      "says": "No Icons.Filled from the legacy set; use the Material Symbols subset the kit ships."
    },
    {
      "id": "compose-rtl",
      "kit": "compose",
      "pattern": "\\bAlignment\\.(Top|Center|Bottom)?(Left|Right)\\b|\\babsolutePadding\\(|\\babsoluteOffset\\(|\\bTextAlign\\.(Left|Right)\\b|\\bArrangement\\.Absolute\\b",
      "spec": "§4.7, §7.3 per-kit",
      "says": "RTL-safe layout: Start/End, never Left/Right or the absolute variants."
    },
    {
      "id": "compose-stock-spinner",
      "kit": "compose",
      "pattern": "\\bCircularProgressIndicator\\(\\s*\\)|\\bCircularProgressIndicator\\(\\s*modifier",
      "spec": "§1.5 rule 4",
      "says": "No stock indeterminate spinner: the M3 Expressive LoadingIndicator inline, the countdown ring or a skeleton."
    },
    {
      "id": "compose-system-alert",
      "kit": "compose",
      "pattern": "\\bAlertDialog\\(",
      "spec": "§1.5 rule 3",
      "says": "No AlertDialog with stock buttons for anything the kit owns."
    },
    {
      "id": "godot-system-dialog",
      "kit": "godot",
      "pattern": "\\b(AcceptDialog|ConfirmationDialog)\\b|\\bOS\\.alert\\(",
      "spec": "§1.5 rule 3",
      "says": "No engine AcceptDialog / ConfirmationDialog / OS.alert for anything the kit owns."
    },
    {
      "id": "godot-checkbox",
      "kit": "godot",
      "pattern": "\\bCheckBox\\b",
      "spec": "§1.5 rule 6",
      "says": "No CheckBox where a switch is meant: the kit's one switch (CheckButton themed by the brand).",
      "exclude": ["/ui/theme/"]
    },
    {
      "id": "godot-rtl",
      "kit": "godot",
      "pattern": "\\bHORIZONTAL_ALIGNMENT_(LEFT|RIGHT)\\b|horizontal_alignment\\s*=\\s*[02]\\b",
      "spec": "§4.7, §7.3",
      "says": "RTL-safe layout: let layout_direction mirror the controls; no hard-coded left or right alignment."
    },
    {
      "id": "godot-uppercase",
      "kit": "godot",
      "pattern": "\\buppercase\\s*=\\s*true\\b|\\.to_upper\\(\\)",
      "spec": "§1.5 rule 6",
      "says": "No all-caps labels."
    },
    {
      "id": "godot-colour-literal",
      "kit": "godot",
      "pattern": "\\bColor\\(\\s*[0-9.]|\\bColor\\(\\s*\"#|\\bColor\\.html\\(|\\bColor8\\(",
      "spec": "§2.1, §7.3",
      "says": "No colour literal outside the generated tokens and the brand theme.",
      "exclude": ["/ui/theme/"]
    },
    {
      "id": "qt-system-dialog",
      "kit": "qt",
      "pattern": "\\bQMessageBox\\b|\\bQProgressDialog\\b|\\bQInputDialog\\b|\\bMessageDialog\\s*\\{",
      "spec": "§1.5 rule 3",
      "says": "No default system dialogs for anything the kit owns."
    },
    {
      "id": "qt-checkbox",
      "kit": "qt",
      "pattern": "\\bQCheckBox\\b|\\bCheckBox\\s*\\{",
      "spec": "§1.5 rule 6",
      "says": "No check box where a switch is meant: the kit's one switch."
    },
    {
      "id": "qt-rtl",
      "kit": "qt",
      "pattern": "\\b(margin|padding)-(left|right)\\s*:|\\btext-align\\s*:\\s*(left|right)\\b|\\bAlignAbsolute\\b",
      "spec": "§4.7, §7.3",
      "says": "RTL-safe layout: Qt mirrors AlignLeft/AlignRight in RTL, but not QSS physical margins or AlignAbsolute."
    },
    {
      "id": "qt-colour-literal",
      "kit": "qt",
      "pattern": "#[0-9A-Fa-f]{6}\\b|\\bQColor\\(\\s*[0-9\"]|\\brgba?\\(",
      "spec": "§2.1, §7.3",
      "says": "No colour literal outside the generated theme (Theme.qml, the .qss files)."
    },
    {
      "id": "terminal-python-rtl",
      "kit": "terminal-python",
      "pattern": "\\.(ljust|rjust)\\(|\\bjustify\\s*=\\s*[\"'](left|right)[\"']",
      "spec": "§4.7, §7.3",
      "says": "RTL-safe layout: pad with cell-aware spans and let the terminal's bidi lay the line out; no left or right justification."
    },
    {
      "id": "terminal-python-escape",
      "kit": "terminal-python",
      "pattern": "\\\\x1b\\[[0-9;]+m|\\\\033\\[[0-9;]+m",
      "spec": "§2.1, §7.3",
      "says": "No hand-written SGR: every role's parameters come from the generated ANSI tables (polaris_key/ui/ansi.py); only the writer in text.py emits them.",
      "exclude": ["/ui/terminal/text\\.py$"]
    },
    {
      "id": "terminal-python-colour-literal",
      "kit": "terminal-python",
      "pattern": "#[0-9A-Fa-f]{6}\\b",
      "spec": "§2.1, §7.3",
      "says": "No colour literal outside the generated tokens and the accent resolver."
    },
    {
      "id": "terminal-python-stock-spinner",
      "kit": "terminal-python",
      "pattern": "\\bconsole\\.status\\(|\\brich\\.spinner\\b|\\bSpinner\\(",
      "spec": "§1.5 rule 4",
      "says": "No stock spinner: the braille spinner in mute from the generated tables, at 80 ms a frame."
    },
    {
      "id": "terminal-raw-escape",
      "kit": "terminal-node",
      "pattern": "\\\\x1b\\[|\\\\u001b\\[|\\\\033\\[",
      "spec": "§1.4 Terminal, §2.1, §7.3",
      "says": "No raw escape sequence outside the terminal primitives (src/cli/term/): colour goes through the role painter, so NO_COLOR, --no-color and a pipe drop it.",
      "exclude": ["/cli/term/"]
    },
    {
      "id": "terminal-stock-prompt",
      "kit": "terminal-node",
      "pattern": "\\breadline\\.question\\b|\\bcreateInterface\\(|\\.question\\(",
      "spec": "§1.4 Terminal, §5.1 Node row",
      "says": "No stock readline prompt: the kit's prompts (term/prompt.ts) mask a key and never echo it."
    },
    {
      "id": "terminal-console",
      "kit": "terminal-node",
      "pattern": "\\bconsole\\.(log|error|warn|info)\\(",
      "spec": "§1.4 Terminal, §7.1",
      "says": "No console output from a flow: write to the context's streams, so the goldens see what a terminal gets and --json stays one object."
    },
    {
      "id": "terminal-uppercase",
      "kit": "terminal-node",
      "pattern": "\\.toUpperCase\\(\\)|\\.toLocaleUpperCase\\(",
      "spec": "§1.5 rule 6, rule 11",
      "says": "No all-caps copy: the catalog's sentence case is what the terminal shows."
    },
    {
      "id": "react-rtl",
      "kit": "react",
      "pattern": "\\b(margin|padding|border)(Left|Right)\\b|textAlign:\\s*[\"'](left|right)[\"']|\\b(left|right):\\s*[\"']?[0-9]",
      "spec": "§4.7, §7.3",
      "says": "RTL-safe layout: logical properties (marginInlineStart, insetInlineEnd, textAlign start/end), never left/right."
    },
    {
      "id": "react-system-dialog",
      "kit": "react",
      "pattern": "(^|[^.\\w])(alert|confirm|prompt)\\(|window\\.(alert|confirm|prompt)\\(",
      "spec": "§1.5 rule 3",
      "says": "No browser dialogs (alert, confirm, prompt); use the kit's inline confirm or dialog."
    },
    {
      "id": "react-uppercase",
      "kit": "react",
      "pattern": "textTransform:\\s*[\"']uppercase[\"']|[A-Za-z_\\]]\\.toUpperCase\\(\\)",
      "spec": "§1.5 rule 6",
      "says": "No all-caps labels (a whole string upper-cased; capitalising a first letter is fine)."
    },
    {
      "id": "react-colour-literal",
      "kit": "react",
      "pattern": "#[0-9a-fA-F]{3,8}\\b|\\brgba?\\(|\\bhsla?\\(",
      "spec": "§2.1, §7.3",
      "says": "No colour literal outside the theme tokens (components/theme.ts); use a --pk-* custom property.",
      "exclude": ["/theme\\.ts$"]
    },
    {
      "id": "react-px-font",
      "kit": "react",
      "pattern": "fontSize:\\s*[\"']?[0-9.]+px",
      "spec": "§4.7 DL11",
      "says": "Type is sized in rem or a type-scale step, never px, so it follows the person's text size."
    },
    {
      "id": "swiftui-spacing-off-scale",
      "kit": "swiftui",
      "rule": "spacing-off-scale",
      "dl": "DL3",
      "pattern": "\\.padding\\(\\s*(\\[?\\s*\\.[A-Za-z]+(\\s*,\\s*\\.[A-Za-z]+)*\\s*\\]?\\s*,\\s*)?-?[1-9][0-9.]*\\s*\\)|\\bspacing:\\s*-?[1-9]",
      "spec": "DL3, §7.3",
      "says": "Every margin, padding and gap is a --pk-space-* step or a generated kit token, never a literal number."
    },
    {
      "id": "swiftui-weights",
      "kit": "swiftui",
      "rule": "weights",
      "dl": "DL12",
      "pattern": "\\.bold\\(\\)|\\.fontWeight\\(\\s*\\.(?!regular\\b|medium\\b|semibold\\b)|\\bweight:\\s*\\.(bold|heavy|black|light|thin|ultraLight)\\b",
      "spec": "DL12, §7.3",
      "says": "Three weights only: 400, 500 and 600 (700 only in the game wordmark fallback)."
    },
    {
      "id": "swiftui-polaris-mark",
      "kit": "swiftui",
      "rule": "polaris-mark",
      "dl": "DL5",
      "pattern": "\\bPolarisMark\\(|\\bPolarisLockerMicroMark\\(|\\bbrandImage\\(",
      "spec": "DL5, §7.3",
      "says": "The Polaris mark appears only in the opt-in Powered-by line or badge, never elsewhere on a screen.",
      "exclude": [
        "PolarisBrandMarks\\.swift$",
        "BrandMarks\\.generated\\.swift$",
        "BrandVector\\.swift$"
      ]
    },
    {
      "id": "swiftui-initial-focus",
      "kit": "swiftui",
      "rule": "initial-focus",
      "dl": "DL9",
      "scope": "file",
      "include": "/Kit/Screens/[A-Za-z]+Screens\\.swift$",
      "require": "\\.defaultFocus\\(|@FocusState",
      "spec": "DL9, §7.3",
      "says": "A screen file sets initial focus (the primary, or the first sign-in method)."
    },
    {
      "id": "swiftui-catalog-string",
      "kit": "swiftui",
      "rule": "catalog-string",
      "dl": "DL8",
      "pattern": "\\b(Text|Button|Label|Toggle|Link)\\(\\s*\"[^\"\\\\]*[A-Za-z]|\\.navigationTitle\\(\\s*\"",
      "spec": "DL8, §7.3",
      "says": "A visible string comes from the generated catalogs, not a literal in the source.",
      "exclude": ["Preview"]
    },
    {
      "id": "swiftui-link-validation",
      "kit": "swiftui",
      "rule": "link-validation",
      "dl": "DL14",
      "pattern": "(?<![@.\\w])openURL\\(|\\bUIApplication\\.shared\\.open\\(|\\bNSWorkspace\\.shared\\.open\\(",
      "spec": "DL14, §7.3",
      "says": "A link is opened only through the kit's one validating opener (https, loopback http aside)."
    },
    {
      "id": "swiftui-px-font",
      "kit": "swiftui",
      "rule": "px-font",
      "dl": "DL11",
      "pattern": "\\.system\\(\\s*size:|\\bFont\\.custom\\((?![^)]*relativeTo:)[^)]*size:",
      "spec": "DL11, §7.3",
      "says": "Type scales with the person's text-size setting: no fixed pixel font size or scale override."
    },
    {
      "id": "compose-spacing-off-scale",
      "kit": "compose",
      "rule": "spacing-off-scale",
      "dl": "DL3",
      "pattern": "\\bpadding\\([^)]*\\b-?[1-9][0-9]*(\\.[0-9]+)?\\.dp|\\bspacedBy\\(\\s*-?[1-9][0-9]*(\\.[0-9]+)?\\.dp|\\bSpacer\\([^)]*(height|width)\\(\\s*-?[1-9][0-9]*(\\.[0-9]+)?\\.dp",
      "spec": "DL3, §7.3",
      "says": "Every margin, padding and gap is a --pk-space-* step or a generated kit token, never a literal number."
    },
    {
      "id": "compose-weights",
      "kit": "compose",
      "rule": "weights",
      "dl": "DL12",
      "pattern": "\\bFontWeight\\.(Bold|ExtraBold|Black|Light|ExtraLight|Thin|W(100|200|300|700|800|900))\\b|\\bFontWeight\\(\\s*(100|200|300|700|800|900)\\s*\\)",
      "spec": "DL12, §7.3",
      "says": "Three weights only: 400, 500 and 600 (700 only in the game wordmark fallback)."
    },
    {
      "id": "compose-polaris-mark",
      "kit": "compose",
      "rule": "polaris-mark",
      "dl": "DL5",
      "pattern": "\\bPolarisMark\\(",
      "spec": "DL5, §7.3",
      "says": "The Polaris mark appears only in the opt-in Powered-by line or badge, never elsewhere on a screen.",
      "exclude": ["PolarisBrandMarks\\.kt$"]
    },
    {
      "id": "compose-initial-focus",
      "kit": "compose",
      "rule": "initial-focus",
      "dl": "DL9",
      "scope": "file",
      "include": "/ui/(PolarisScreen|PolarisGate|PolarisSignIn|PolarisUpdate|PolarisDevices|PolarisSettings|PolarisBoot|PolarisKitScreen)\\.kt$",
      "require": "requestFocus\\(",
      "spec": "DL9, §7.3",
      "says": "A screen file sets initial focus (the primary, or the first sign-in method)."
    },
    {
      "id": "compose-catalog-string",
      "kit": "compose",
      "rule": "catalog-string",
      "dl": "DL8",
      "pattern": "\\bText\\(\\s*(text\\s*=\\s*)?\"[^\"$]*[A-Za-z]",
      "spec": "DL8, §7.3",
      "says": "A visible string comes from the generated catalogs, not a literal in the source."
    },
    {
      "id": "compose-link-validation",
      "kit": "compose",
      "rule": "link-validation",
      "dl": "DL14",
      "pattern": "\\buriHandler::openUri|\\buriHandler\\.openUri\\(|\\bstartActivity\\(|\\bIntent\\.ACTION_VIEW\\b",
      "spec": "DL14, §7.3",
      "says": "A link is opened only through the kit's one validating opener (https, loopback http aside)."
    },
    {
      "id": "compose-px-font",
      "kit": "compose",
      "rule": "px-font",
      "dl": "DL11",
      "pattern": "\\bDensity\\(|\\bfontScale\\s*=|\\bLocalDensity\\s+provides\\b",
      "spec": "DL11, §7.3",
      "says": "Type scales with the person's text-size setting: no fixed pixel font size or scale override."
    },
    {
      "id": "godot-spacing-off-scale",
      "kit": "godot",
      "rule": "spacing-off-scale",
      "dl": "DL3",
      "pattern": "(add_theme_constant_override\\(\\s*\"(margin_(left|right|top|bottom)|h_separation|v_separation|separation)\"\\s*,\\s*-?[1-9])|(theme_override_constants/(margin_(left|right|top|bottom)|h_separation|v_separation|separation)\\s*=\\s*-?[1-9])",
      "spec": "DL3, §7.3",
      "says": "Every margin, padding and gap is a --pk-space-* step or a generated kit token, never a literal number."
    },
    {
      "id": "godot-weights",
      "kit": "godot",
      "rule": "weights",
      "dl": "DL12",
      "pattern": "\\bbold(_italics)?_font\\b|\\bvariation_embolden\\b|\\bfont_bold\\b|\"[^\"\\n]*\\[/?b\\]",
      "spec": "DL12, §7.3",
      "says": "Three weights only: 400, 500 and 600 (700 only in the game wordmark fallback)."
    },
    {
      "id": "godot-polaris-mark",
      "kit": "godot",
      "rule": "polaris-mark",
      "dl": "DL5",
      "pattern": "\\b(PINNED_K|STAR_CUT)[A-Z_]*\\b|\\bbrand_marks_generated\\b",
      "spec": "DL5, §7.3",
      "says": "The Polaris mark appears only in the opt-in Powered-by line or badge, never elsewhere on a screen.",
      "exclude": ["brand_marks_generated\\.gd$"]
    },
    {
      "id": "godot-initial-focus",
      "kit": "godot",
      "rule": "initial-focus",
      "dl": "DL9",
      "scope": "file",
      "include": "/ui/(gate/pkey_gate|activation/pkey_activation_panel|sign_in/pkey_sign_in_dialog|update/pkey_update_prompt|devices/pkey_device_list|settings/pkey_settings_panel|boot/pkey_boot|license_choice/pkey_license_choice|offline/pkey_offline_dialog)\\.gd$",
      "require": "_initial_focus\\(",
      "spec": "DL9, §7.3",
      "says": "A screen file sets initial focus (the primary, or the first sign-in method)."
    },
    {
      "id": "godot-catalog-string",
      "kit": "godot",
      "rule": "catalog-string",
      "dl": "DL8",
      "pattern": "\\.(text|title|tooltip_text|placeholder_text)\\s*=\\s*\"[^\"%]*[A-Za-z]",
      "spec": "DL8, §7.3",
      "says": "A visible string comes from the generated catalogs, not a literal in the source."
    },
    {
      "id": "godot-link-validation",
      "kit": "godot",
      "rule": "link-validation",
      "dl": "DL14",
      "pattern": "\\bOS\\.shell_open\\(",
      "spec": "DL14, §7.3",
      "says": "A link is opened only through the kit's one validating opener (https, loopback http aside)."
    },
    {
      "id": "godot-px-font",
      "kit": "godot",
      "rule": "px-font",
      "dl": "DL11",
      "pattern": "\\badd_theme_font_size_override\\(\\s*\"font_size\"\\s*,\\s*[0-9]|theme_override_font_sizes/font_size\\s*=\\s*[0-9]",
      "spec": "DL11, §7.3",
      "says": "Type scales with the person's text-size setting: no fixed pixel font size or scale override."
    },
    {
      "id": "qt-spacing-off-scale",
      "kit": "qt",
      "rule": "spacing-off-scale",
      "dl": "DL3",
      "pattern": "\\bsetContentsMargins\\(\\s*[1-9]|\\bsetSpacing\\(\\s*[1-9]|\\bspacing\\s*:\\s*[1-9]|\\b(margin|padding)(-(top|bottom|left|right))?\\s*:\\s*[1-9][0-9]*px|\\banchors\\.\\w*[mM]argin\\s*:\\s*[1-9]|\\bmargins\\s*:\\s*[1-9]",
      "spec": "DL3, §7.3",
      "says": "Every margin, padding and gap is a --pk-space-* step or a generated kit token, never a literal number."
    },
    {
      "id": "qt-weights",
      "kit": "qt",
      "rule": "weights",
      "dl": "DL12",
      "pattern": "\\bsetBold\\(\\s*True|\\bQFont\\.(Bold|Black|ExtraBold|Light|Thin|ExtraLight)\\b|\\bfont\\.bold\\s*:\\s*true|\\bFont\\.(Bold|Black|ExtraBold|Light|Thin|ExtraLight)\\b|\\bfont-weight\\s*:",
      "spec": "DL12, §7.3",
      "says": "Three weights only: 400, 500 and 600 (700 only in the game wordmark fallback)."
    },
    {
      "id": "qt-polaris-mark",
      "kit": "qt",
      "rule": "polaris-mark",
      "dl": "DL5",
      "pattern": "\\b(pinned_?k|star_?cut)\\b|\\bpolaris-mark\\b",
      "spec": "DL5, §7.3",
      "says": "The Polaris mark appears only in the opt-in Powered-by line or badge, never elsewhere on a screen."
    },
    {
      "id": "qt-initial-focus",
      "kit": "qt",
      "rule": "initial-focus",
      "dl": "DL9",
      "scope": "file",
      "include": "/qt/(gate\\.py|kit/KitScreen\\.qml)$",
      "require": "\\bfocus\\s*:\\s*true|forceActiveFocus\\(|\\bsetFocus\\(",
      "spec": "DL9, §7.3",
      "says": "A screen file sets initial focus (the primary, or the first sign-in method)."
