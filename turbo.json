{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "@polaris-key/cli#build": {
      "dependsOn": [
        "^build",
        "@polaris-key/brand#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../worker/src/**",
        "../worker/dev/**",
        "../worker/migrations/**",
        "../worker/test/*Mock.ts"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
