{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["PKEY_DEV_BASE_URL", "PKEY_DEV_CONFIG", "PKEY_DEV_APPROVE"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    },
    "@polaris-key/cli#build": {
      "dependsOn": ["^build", "@polaris-key/brand#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../pnpm-lock.yaml",
        "../../tsconfig.base.json",
        "../worker/package.json",
        "../worker/tsconfig.json",
        "../worker/src/**",
        "../worker/dev/**",
        "../worker/migrations/**",
        "../worker/test/*Mock.ts"
      ],
      "outputs": ["dist/**"]
    },
    "@polaris-key/cli#test": {
      "dependsOn": ["^build", "@polaris-key/brand#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../pnpm-lock.yaml",
        "../../tsconfig.base.json",
        "../worker/package.json",
        "../worker/tsconfig.json",
        "../worker/src/**",
        "../worker/dev/**",
        "../worker/migrations/**",
        "../worker/test/*Mock.ts"
      ]
    }
  }
}
