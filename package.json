{
  "name": "polaris-key",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --filter=!@polaris-key/conformance-browser",
    "test:all": "turbo run test --filter=!@polaris-key/conformance-browser && (cd sdks/python && .venv/bin/python -m pytest -q) && (cd sdks/swift && swift test) && sdks/godot/tools/run_tests.sh && (cd sdks/kotlin && ./gradlew -q -Ppkey.jvmOnly=true :core:test :license:test :config:test :identity:test :release:test :update:test :packs:test :sdk:test :ui-core:test :conformance:test)",
    "test:browser": "turbo run test --filter=@polaris-key/conformance-browser",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:knip": "knip --reporter json | node tools/lint/lint-debt.mjs check --tool knip --ledger tools/lint/debt/knip.json",
    "lint:knip:record": "knip --reporter json | node tools/lint/lint-debt.mjs record --tool knip --ledger tools/lint/debt/knip.json",
    "dev": "turbo run dev --no-cache --continue",
    "gen": "tsx tools/gen.ts",
    "gate": "node tools/gate.mjs",
    "skills:validate": "tsx tools/agent-kit-release.ts --validate",
    "parity:check": "tsx tools/parity-check.ts",
    "skills:check": "tsx tools/skills-check.ts",
    "skills:all": "pnpm skills:check && pnpm skills:validate",
    "prepare": "husky",
    "conformance": "turbo run test --filter=@polaris-key/conformance-node",
    "format": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "lint:dupes": "node tools/lint/dupes.mjs check",
    "lint:size": "node tools/lint/size.mjs check",
    "lint:size:record": "node tools/lint/size.mjs record",
    "lint:ts": "pnpm lint:knip && pnpm lint:dupes && pnpm lint:size",
    "ui:lint": "pnpm --filter @polaris-key/ui-qa exec tsx src/cli/lint.ts",
    "ui:report": "pnpm --filter @polaris-key/ui-qa exec tsx src/cli/report.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "husky": "^9.1.7",
    "jscpd": "5.4.0",
    "knip": "6.41.0",
    "prettier": "^3.5.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.11.10",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
