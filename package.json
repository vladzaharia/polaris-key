{
  "name": "polaris-key",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --filter=!@polaris-key/conformance-browser",
    "test:all": "turbo run test --filter=!@polaris-key/conformance-browser && (cd sdks/python && .venv/bin/python -m pytest -q) && (cd sdks/swift && swift test) && sdks/godot/tools/run_tests.sh && (cd sdks/kotlin && ./gradlew -q -Ppkey.jvmOnly=true :core:test :license:test :config:test :identity:test :release:test :update:test :packs:test :sdk:test :conformance:test)",
    "test:browser": "turbo run test --filter=@polaris-key/conformance-browser",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev --no-cache --continue",
    "gen": "tsx tools/gen.ts",
    "parity:check": "tsx tools/parity-check.ts",
    "prepare": "husky",
    "conformance": "turbo run test --filter=@polaris-key/conformance-node",
    "format": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "ui:lint": "pnpm --filter @polaris-key/ui-qa exec tsx src/cli/lint.ts",
    "ui:report": "pnpm --filter @polaris-key/ui-qa exec tsx src/cli/report.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  }
}
