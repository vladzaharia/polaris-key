node_modules/
dist/
# The polaris-key/publish Action runs its committed bundle (P2-06; AGENTS.md rule 3) — the bare
# `dist/` above would otherwise swallow it and the Action would ship with no entry point.
!actions/publish/dist/
# The console's CSP browser check builds a gallery bundle here (packages/admin/e2e/kit.e2e.test.ts).
dist-kit/
.turbo/
*.tsbuildinfo
coverage/

# Cloudflare / wrangler
.wrangler/
.dev.vars
.dev.vars.*

# Secrets — never commit
*.pem
secrets.created.json
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
**/__pycache__/
*.egg-info/
*.pyc
**/*.pyc
.pytest_cache/

# Swift
.build/
*.xcodeproj

# P5-06: the Kotlin build (sdks/kotlin, and its :godot module in sdks/godot/native/android) and the
# Godot Android binding's installed AARs (sdks/godot/native/android/build.sh); source only is
# committed. The Gradle wrapper jar IS committed (a global *.jar ignore would otherwise drop it).
.gradle/
sdks/kotlin/local.properties
sdks/kotlin/*/build/
# P6-06/P6-09: the root build directory, where maven-publish writes the local Maven repository
# (build/repo; local only, never a public registry).
sdks/kotlin/build/
sdks/godot/native/android/build/
sdks/godot/addons/polaris_key/native/android/
!sdks/kotlin/gradle/wrapper/gradle-wrapper.jar
# P5-05: the Godot iOS binding's build products (sdks/godot/native/ios/build.sh installs the
# xcframework and its .gdextension here); source only is committed.
sdks/godot/addons/polaris_key/native/ios/
*.xcframework/

# OS / editor
.DS_Store
*.log

# Tool scratch
.playwright-mcp/

# Generated product seeds
products/*/seed.sql

# Assembled worker asset root (admin dist + docs dist merged by assemble-assets.mjs)
packages/worker/assets/

# The docs site's "Build on it" section — a global gitignore with a bare `build/` pattern
# would silently swallow it (content, not build output).
!packages/docs/src/content/docs/build/
!packages/docs/src/content/docs/build/**

# Test fixtures that a global *.jar ignore would otherwise drop.
!packages/cli/test/fixtures/**/*.jar

# PX-20: the portal's visual baselines. Only the linux set is committed (what CI renders); other
# platforms record their own locally, and mismatches write actual/diff images to .out/.
packages/admin/e2e/__baselines__/portal/*
!packages/admin/e2e/__baselines__/portal/linux/
