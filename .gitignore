node_modules/
dist/
# The polaris-key/publish Action runs its committed bundle (P2-06; AGENTS.md rule 3) — the bare
# `dist/` above would otherwise swallow it and the Action would ship with no entry point.
!actions/publish/dist/
.turbo/
*.tsbuildinfo
coverage/

# Cloudflare / wrangler
.wrangler/
.dev.vars
.dev.vars.*

# Secrets — never commit
*.pem
secrets.created.json
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
**/__pycache__/
*.egg-info/
*.pyc
**/*.pyc
.pytest_cache/

# Swift
.build/
*.xcodeproj

# P5-06: the Kotlin build (sdks/kotlin, and its :godot module in sdks/godot/native/android) and the
# Godot Android binding's installed AARs (sdks/godot/native/android/build.sh); source only is
# committed. The Gradle wrapper jar IS committed (a global *.jar ignore would otherwise drop it).
.gradle/
sdks/kotlin/local.properties
sdks/godot/addons/polaris_key/native/android/
!sdks/kotlin/gradle/wrapper/gradle-wrapper.jar

# OS / editor
.DS_Store
*.log

# Tool scratch
.playwright-mcp/

# Generated product seeds
products/*/seed.sql

# Assembled worker asset root (admin dist + docs dist merged by assemble-assets.mjs)
packages/worker/assets/

# The docs site's "Build on it" section — a global gitignore with a bare `build/` pattern
# would silently swallow it (content, not build output).
!packages/docs/src/content/docs/build/
!packages/docs/src/content/docs/build/**

# Test fixtures that a global *.jar ignore would otherwise drop.
!packages/cli/test/fixtures/**/*.jar
